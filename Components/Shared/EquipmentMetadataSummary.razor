@using SIT.DepartmentSystem.Web.Services
@using SIT.DepartmentSystem.Web.Services.KmIntegration
@inject BrowserApiClient Api

<div class="form-card equipment-metadata-summary @(Compact ? "equipment-metadata-compact" : null)">
    <div class="case-card-head"><div><div class="case-kicker">KM / CONSOLIDATED ANALYSIS</div><h3>設備綜合分析</h3></div>
        @if (_view is not null) { <span class="record-status-pill">@StatusText(_view.Status)</span> }
    </div>
    @if (_loading) { <div class="record-empty-box"><strong>讀取設備綜合分析中...</strong></div> }
    else if (_error is not null) { <div class="record-empty-box"><strong>無法讀取設備綜合分析</strong><span>@_error</span></div> }
    else if (_view is null) { <div class="record-empty-box"><strong>尚無設備綜合分析</strong></div> }
    else
    {
        <div class="metadata-inline-values"><span>有效來源：@_view.EligibleDocumentCount 份</span>
            @if (_view.PendingDocumentCount > 0) { <span>其他待處理文件：@_view.PendingDocumentCount 份</span> }
            <span>Manifest：@ShortHash(_view.ManifestHash)</span>
            @if (_view.AnalyzedAt.HasValue) { <span>分析時間：@_view.AnalyzedAt.Value.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</span> }
        </div>
        @if (_view.PendingDocumentCount > 0)
        {
            <div class="aggregate-pending-coverage"><strong>分析尚未涵蓋全部文件</strong><span>目前有 @_view.PendingDocumentCount 份文件仍在等待 KM 單檔分析；完成後將依新的文件集合更新綜合分析。</span></div>
        }
        @if (_view.IsStale) { <div class="aggregate-stale"><strong>待更新</strong><span>文件集合已改變；以下為上一版快照，不代表目前文件集合。</span></div> }
        @if (_view.Result is null)
        {
            <div class="record-empty-box"><strong>@EmptyTitle(_view.Status)</strong><span>@EmptyDescription(_view.Status)</span></div>
        }
        else
        {
            @if (!HasSubstantiveAnalysis(_view.Result))
            {
                <div class="record-empty-box"><strong>資料不足／沒有可用分析</strong><span>KM 回傳內容沒有可驗證的技術規格、測試能力、限制、衝突或來源證據；警告訊息不視為完整分析。</span></div>
            }
            <section><h4>設備概述</h4>
                @if (string.IsNullOrWhiteSpace(_view.Result.Overview)) { <span class="metadata-empty">KM 未提供設備概述。</span> }
                else { <p class="metadata-document-summary">@_view.Result.Overview</p> }
            </section>
            <section><h4>技術規格</h4>
                @if (_view.Result.TechnicalSpecifications.Count == 0) { <span class="metadata-empty">KM 未提供技術規格。</span> }
                else { <div class="metadata-spec-grid">@foreach (var x in _view.Result.TechnicalSpecifications) { <div><span>@x.Name</span><strong>@x.Value @x.Unit</strong><small>證據：@string.Join("、", x.EvidenceIds)</small></div> }</div> }
            </section>
            <section><h4>測試能力</h4>
                @if (_view.Result.TestCapabilities.Count == 0) { <span class="metadata-empty">KM 未提供測試能力。</span> }
                else { <div class="metadata-spec-grid">@foreach (var x in _view.Result.TestCapabilities) { <div><strong>@x.Name</strong>@if (x.Description is not null) { <span>@x.Description</span> }<small>證據：@string.Join("、", x.EvidenceIds)</small></div> }</div> }
            </section>
            <section><h4>限制</h4>@if (_view.Result.Limitations.Count == 0) { <span class="metadata-empty">KM 未提供設備限制。</span> } else { <ul>@foreach (var x in _view.Result.Limitations) { <li>@x</li> }</ul> }</section>
            <section><h4>衝突</h4>@if (_view.Result.Conflicts.Count == 0) { <span class="metadata-empty">KM 未回報跨文件衝突。</span> } else { <ul>@foreach (var x in _view.Result.Conflicts) { <li><strong>@x.Field：</strong>@x.Description <small>（@string.Join("、", x.EvidenceIds)）</small></li> }</ul> }</section>
            <section><h4>來源證據</h4>
                @if (_view.Result.Evidence.Count == 0) { <span class="metadata-empty">KM 未提供來源證據，因此不會形成正式建議。</span> }
                else { <div class="metadata-evidence-list">@foreach (var x in _view.Result.Evidence) { <div class="metadata-evidence"><strong>@x.EvidenceId</strong><span>@x.Description</span>@if (x.Location is not null) { <small>@x.Location</small> }<small>FileId：@x.FileId</small></div> }</div> }
            </section>
            @if (_view.Result.Warnings.Count > 0) { <section><h4>KM 警告</h4><ul>@foreach (var x in _view.Result.Warnings) { <li>@x</li> }</ul></section> }
            <small class="metadata-note">僅呈現 KM 對有效文件集合回傳的快照；不會自動覆寫設備主檔或預約資源能力。</small>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public string ApparatusId { get; set; } = string.Empty;
    [Parameter] public string ModuleCode { get; set; } = "equipment";
    [Parameter] public bool Compact { get; set; }
    [Parameter] public string RefreshKey { get; set; } = string.Empty;
    private EquipmentAggregateAnalysisView? _view;
    private string? _key, _error;
    private bool _loading;
    private int _loadVersion;
    protected override async Task OnParametersSetAsync()
    {
        var key = $"{ModuleCode}:{ApparatusId}:{RefreshKey}";
        if (_key == key) return;
        var loadVersion = ++_loadVersion;
        _key = key; _view = null; _error = null; _loading = true;
        try
        {
            var view = await Api.GetAsync<EquipmentAggregateAnalysisView>($"/api/equipment-aggregate-analysis?apparatusId={Uri.EscapeDataString(ApparatusId)}&moduleCode={Uri.EscapeDataString(ModuleCode)}");
            if (loadVersion == _loadVersion) _view = view;
        }
        catch (Exception ex) { if (loadVersion == _loadVersion) _error = ex.Message; }
        finally { if (loadVersion == _loadVersion) _loading = false; }
    }
    private static string StatusText(string status) => status switch { "Completed" => "分析完成", "Stale" => "待更新", "Pending" => "等待 KM", "Deferred" => "KM 暫停受理", "Failed" => "分析失敗", "NoEligibleDocuments" => "無有效文件", "FeatureDisabled" => "流程尚未啟用", _ => status };
    private static string EmptyTitle(string status) => status switch { "NoEligibleDocuments" => "目前沒有可供綜合分析的有效文件", "FeatureDisabled" => "KM 設備綜合分析流程尚未啟用", "Failed" => "本次 KM 設備綜合分析失敗", _ => "設備綜合分析尚未完成" };
    private static string EmptyDescription(string status) => status switch { "FeatureDisabled" => "Feature Flag 保持關閉；CSIT 不會用單檔結果拼湊或產生假綜合分析。", "NoEligibleDocuments" => "只納入正式入庫、未進入刪除流程且具有有效 KM 單檔分析結果的文件。", _ => "完成後會顯示 KM 回傳快照；既有單檔 KM 工作不會重新派送。" };
    private static bool HasSubstantiveAnalysis(EquipmentAggregateAnalysisResult result) =>
        result.TechnicalSpecifications.Count > 0 || result.TestCapabilities.Count > 0 ||
        result.Limitations.Count > 0 || result.Conflicts.Count > 0 || result.Evidence.Count > 0;
    private static string ShortHash(string hash) => hash.Length <= 12 ? hash : hash[..12];
}
