@using System.Text.Json
@using SIT.DepartmentSystem.Web.Entities
@using SIT.DepartmentSystem.Web.Models.Api
@using SIT.DepartmentSystem.Web.Services
@using SIT.DepartmentSystem.Web.Services.KmIntegration
@inject BrowserApiClient Api
@implements IAsyncDisposable

<div class="form-card equipment-metadata-summary">
    <div class="case-card-head"><div><div class="case-kicker">KM / AI SUGGESTIONS</div><h3>C. AI／KM 根據設備文件擷取建議</h3></div></div>
    @if (_loading)
    {
        <div class="record-empty-box"><strong>讀取 KM 分析結果中...</strong><span>正在取得目前使用者有權查看的設備附件 Metadata。</span></div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="record-empty-box"><strong>無法讀取 KM 分析結果</strong><span>@_error</span></div>
    }
    else if (_results.Count == 0 && LegacySuggestions.Count == 0)
    {
        <div class="record-empty-box">
            <strong>@(HasCompletedKmFile ? "KM 分析已完成，但目前沒有可用的 Metadata 結果" : "尚無 KM 分析結果")</strong>
            <span>完成分析後會在此顯示 KM 實際回傳內容；系統不會自行產生規格或覆寫設備主檔。</span>
        </div>
    }
    else
    {
        @foreach (var item in _results)
        {
            <article class="equipment-km-result" @key="item.Detail.Id">
                <div class="equipment-km-result-head">
                    <div><strong>@item.File.FileName</strong><small>KM Job：@item.Detail.KmJobId · Schema：@item.Detail.MetadataSchemaVersion</small></div>
                </div>

                <section>
                    <h4>文件摘要</h4>
                    @if (!string.IsNullOrWhiteSpace(item.View.Document.Title)) { <strong>@item.View.Document.Title</strong> }
                    @if (!string.IsNullOrWhiteSpace(item.View.Document.Summary))
                    {
                        <p class="metadata-document-summary">@item.View.Document.Summary</p>
                    }
                    else { <span class="metadata-empty">KM 未提供文件摘要。</span> }
                    <div class="metadata-inline-values">
                        @if (!string.IsNullOrWhiteSpace(item.View.Document.DocumentType)) { <span>類型：@item.View.Document.DocumentType</span> }
                        @if (!string.IsNullOrWhiteSpace(item.View.Document.Language)) { <span>語言：@item.View.Document.Language</span> }
                        @if (!string.IsNullOrWhiteSpace(item.View.Document.DocumentDate)) { <span>日期：@item.View.Document.DocumentDate</span> }
                    </div>
                    @if (item.View.Document.Keywords.Count > 0)
                    {
                        <div class="metadata-inline-values"><span>關鍵字：@string.Join("、", item.View.Document.Keywords)</span></div>
                    }
                </section>

                <section>
                    <h4>擷取資訊</h4>
                    <div class="metadata-inline-values">
                        @if (!string.IsNullOrWhiteSpace(item.View.Extraction.SourceFormat)) { <span>格式：@item.View.Extraction.SourceFormat</span> }
                        @if (!string.IsNullOrWhiteSpace(item.View.Extraction.Method)) { <span>方式：@item.View.Extraction.Method</span> }
                        @if (item.View.Extraction.OcrUsed.HasValue) { <span>OCR：@(item.View.Extraction.OcrUsed.Value ? "是" : "否")</span> }
                        @if (item.View.Extraction.PageCount.HasValue) { <span>頁數：@item.View.Extraction.PageCount</span> }
                        @if (item.View.Extraction.ExtractedCharacterCount.HasValue) { <span>擷取字元：@item.View.Extraction.ExtractedCharacterCount</span> }
                        @if (item.View.Extraction.SheetNames.Count > 0) { <span>工作表：@string.Join("、", item.View.Extraction.SheetNames)</span> }
                    </div>
                </section>

                <section>
                    <h4>技術資訊</h4>
                    @if (item.View.Technical.Count == 0)
                    {
                        <span class="metadata-empty">KM 未提供技術資訊。</span>
                    }
                    else
                    {
                        <div class="metadata-spec-grid">
                            @foreach (var group in item.View.Technical)
                            {
                                <div><span>@group.Label</span><strong>@string.Join("、", group.Values)</strong></div>
                            }
                        </div>
                    }
                </section>

                <section>
                    <h4>設備規格建議</h4>
                    @if (item.View.Specifications.Count == 0)
                    {
                        <span class="metadata-empty">KM 分析已完成，未擷取到可填入設備規格的建議。</span>
                    }
                    else
                    {
                        <div class="metadata-spec-grid">
                            @foreach (var specification in item.View.Specifications)
                            {
                                <div>
                                    <span>@specification.Field</span><strong>@specification.Value</strong>
                                    @foreach (var evidence in specification.Evidence) { <small>@evidence</small> }
                                </div>
                            }
                        </div>
                    }
                </section>

                <section>
                    <h4>設備能力與限制</h4>
                    @if (!string.IsNullOrWhiteSpace(item.View.CapabilitySummary))
                    {
                        <p class="metadata-document-summary">@item.View.CapabilitySummary</p>
                    }
                    else { <span class="metadata-empty">KM 未提供設備能力摘要。</span> }
                    @if (item.View.Limitations.Count > 0)
                    {
                        <ul>@foreach (var limitation in item.View.Limitations) { <li>@limitation</li> }</ul>
                    }
                    else { <span class="metadata-empty">KM 未提供設備限制。</span> }
                </section>
                @if (item.View.Evidence.Count > 0)
                {
                    <section><h4>來源證據</h4><ul>@foreach (var evidence in item.View.Evidence) { <li>@evidence</li> }</ul></section>
                }
                @if (item.View.Warnings.Count > 0)
                {
                    <section><h4>KM 警告</h4><ul>@foreach (var warning in item.View.Warnings) { <li>@warning</li> }</ul></section>
                }
                <small class="metadata-note">僅呈現 KM 回傳內容；建議不會自動覆寫設備主檔，仍須人工確認。</small>
            </article>
        }

        @foreach (var suggestion in LegacySuggestions)
        {
            <article class="equipment-km-result legacy-metadata" @key="suggestion.File.Id">
                <div class="equipment-km-result-head"><div><strong>@suggestion.File.FileName</strong><small>舊版設備 Metadata</small></div></div>
                <section><h4>設備規格建議</h4>
                    @if (suggestion.Result.TechnicalSpecifications.Count == 0) { <span class="metadata-empty">尚無技術規格建議。</span> }
                    else { <div class="metadata-spec-grid">@foreach (var spec in suggestion.Result.TechnicalSpecifications) { <div><span>@spec.Field</span><strong>@spec.Value</strong><small>@LegacyEvidenceText(spec.Evidence)</small></div> }</div> }
                </section>
                @if (!string.IsNullOrWhiteSpace(suggestion.Result.CapabilitySummary)) { <section><h4>能力</h4><p>@suggestion.Result.CapabilitySummary</p></section> }
                @if (suggestion.Result.Limitations.Count > 0) { <section><h4>限制</h4><ul>@foreach (var value in suggestion.Result.Limitations) { <li>@value</li> }</ul></section> }
                <small class="metadata-note">舊版建議同樣不會自動覆寫設備主檔。</small>
            </article>
        }
    }
</div>

@code {
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web) { PropertyNameCaseInsensitive = true };
    [Parameter] public IReadOnlyList<ApparatusFileDto> Files { get; set; } = [];

    private readonly List<KmResult> _results = [];
    private string? _fingerprint;
    private string? _error;
    private bool _loading;
    private CancellationTokenSource? _metadataCts;
    private Task? _metadataRetryTask;
    private int _metadataVersion;
    private bool _disposed;
    private const int MaximumMetadataRetryCount = 6;
    private static readonly TimeSpan MetadataRetryInterval = TimeSpan.FromSeconds(5);
    private bool HasCompletedKmFile => Files.Any(x => x.KmStatus == KmIntegrationStatus.Completed.ToString());

    protected override async Task OnParametersSetAsync()
    {
        var fingerprint = string.Join('|', Files.OrderBy(x => x.Id).Select(x =>
            $"{x.Id:N}:{x.FileName}:{x.KmStatus}:{x.MetadataJson?.Length ?? 0}"));
        if (fingerprint == _fingerprint) return;
        _metadataVersion++;
        CancelMetadataWork();
        _metadataCts = new CancellationTokenSource();
        var metadataVersion = _metadataVersion;
        var cancellationToken = _metadataCts.Token;
        _fingerprint = fingerprint;
        _results.Clear();
        _error = null;
        _loading = false;
        var completed = Files.Where(x => x.KmStatus == KmIntegrationStatus.Completed.ToString()).ToList();
        if (completed.Count == 0) return;
        _loading = true;
        try
        {
            await LoadMissingResultsAsync(completed, metadataVersion, cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { return; }
        catch (Exception ex) { if (metadataVersion == _metadataVersion) _error = ex.Message; }
        finally { if (metadataVersion == _metadataVersion) _loading = false; }
        if (!cancellationToken.IsCancellationRequested && metadataVersion == _metadataVersion &&
            completed.Any(file => _results.All(x => x.File.Id != file.Id)))
            _metadataRetryTask = RetryMissingResultsAsync(completed, metadataVersion, cancellationToken);
    }

    private async Task<bool> LoadMissingResultsAsync(IReadOnlyList<ApparatusFileDto> completed,
        int metadataVersion, CancellationToken cancellationToken)
    {
        var changed = false;
        foreach (var file in completed.Where(file => _results.All(x => x.File.Id != file.Id)))
        {
            var page = await Api.GetAsync<KmAnalysisResultPage>(
                $"/api/administration/km-analysis/results?sourceType={KmAnalysisSourceTypes.EquipmentAttachment}&sourceEntityId={file.Id:D}&page=1&pageSize=10",
                cancellationToken);
            foreach (var candidate in page.Items.Where(x => x.SourceType == KmAnalysisSourceTypes.EquipmentAttachment &&
                         x.SourceEntityId == file.Id && x.Status == "Completed" && x.Version == file.KmVersion))
            {
                var detail = await Api.GetAsync<KmAnalysisResultDetail>(
                    $"/api/administration/km-analysis/results/{candidate.Id:D}", cancellationToken);
                if (cancellationToken.IsCancellationRequested || metadataVersion != _metadataVersion) return changed;
                if (detail.SourceType == KmAnalysisSourceTypes.EquipmentAttachment && detail.SourceEntityId == file.Id &&
                    detail.Version == file.KmVersion && detail.SupersededAt is null &&
                    string.Equals(detail.SourceSha256, file.Sha256, StringComparison.OrdinalIgnoreCase))
                {
                    _results.Add(new(file, detail, EquipmentKmMetadataProjection.Project(detail.Result)));
                    changed = true;
                    break;
                }
            }
        }
        return changed;
    }

    private async Task RetryMissingResultsAsync(IReadOnlyList<ApparatusFileDto> completed,
        int metadataVersion, CancellationToken cancellationToken)
    {
        try
        {
            for (var attempt = 0; attempt < MaximumMetadataRetryCount &&
                 completed.Any(file => _results.All(x => x.File.Id != file.Id)); attempt++)
            {
                await Task.Delay(MetadataRetryInterval, cancellationToken);
                try
                {
                    var hadError = _error is not null;
                    var changed = await LoadMissingResultsAsync(completed, metadataVersion, cancellationToken);
                    if (cancellationToken.IsCancellationRequested || metadataVersion != _metadataVersion) return;
                    _error = null;
                    if (changed || hadError) await InvokeAsync(StateHasChanged);
                }
                catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { return; }
                catch (JSDisconnectedException) { return; }
                catch (ObjectDisposedException) when (cancellationToken.IsCancellationRequested) { return; }
                catch (Exception ex)
                {
                    if (metadataVersion == _metadataVersion)
                    {
                        _error = ex.Message;
                        await InvokeAsync(StateHasChanged);
                    }
                }
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) when (cancellationToken.IsCancellationRequested || _disposed) { }
        finally
        {
            if (metadataVersion == _metadataVersion) _metadataRetryTask = null;
        }
    }

    private void CancelMetadataWork()
    {
        var source = _metadataCts;
        _metadataCts = null;
        if (source is not null)
        {
            source.Cancel();
            source.Dispose();
        }
        _metadataRetryTask = null;
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        _metadataVersion++;
        var task = _metadataRetryTask;
        CancelMetadataWork();
        if (task is null) return;
        try { await task; }
        catch (OperationCanceledException) { }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    private IReadOnlyList<(ApparatusFileDto File, EquipmentMetadataSuggestion Result)> LegacySuggestions =>
        Files.Where(file => !_results.Any(x => x.File.Id == file.Id) && !string.IsNullOrWhiteSpace(file.MetadataJson))
            .Select(file => (File: file, Result: ParseLegacy(file.MetadataJson)))
            .Where(x => x.Result is not null).Select(x => (x.File, x.Result!)).ToList();

    private static EquipmentMetadataSuggestion? ParseLegacy(string? json)
    {
        try
        {
            var result = JsonSerializer.Deserialize<EquipmentMetadataSuggestion>(json!, JsonOptions);
            return result is null || result.TechnicalSpecifications is null || result.Limitations is null || result.Evidence is null ||
                result.TechnicalSpecifications.Any(x => x is null || x.Evidence is null) ? null : result;
        }
        catch (JsonException) { return null; }
    }

    private static string LegacyEvidenceText(EquipmentMetadataEvidence evidence)
    {
        var values = new List<string>();
        if (!string.IsNullOrWhiteSpace(evidence.SourceFileName)) values.Add($"文件：{evidence.SourceFileName}");
        if (evidence.Page.HasValue) values.Add($"頁碼：{evidence.Page}");
        if (!string.IsNullOrWhiteSpace(evidence.Section)) values.Add($"段落：{evidence.Section}");
        if (!string.IsNullOrWhiteSpace(evidence.Excerpt)) values.Add($"證據：{evidence.Excerpt}");
        return string.Join("；", values);
    }

    private sealed record KmResult(ApparatusFileDto File, KmAnalysisResultDetail Detail, EquipmentKmMetadataView View);
}
