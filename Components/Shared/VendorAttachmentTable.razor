@using SIT.DepartmentSystem.Web.Entities
@using SIT.DepartmentSystem.Web.Models.Api
@using SIT.DepartmentSystem.Web.Services.Approval

@if (Files.Count == 0 && PendingUploads.Count == 0)
{
    <div class="record-empty-box"><strong>目前沒有廠商附件</strong></div>
}
else
{
    <div class="project-table-wrap">
        <table class="project-table vendor-attachment-table">
            <colgroup>
                <col class="vendor-file-name-column" />
                <col class="vendor-file-type-column" />
                <col class="vendor-file-archive-column" />
                <col class="vendor-file-km-column" />
                <col class="vendor-file-actions-column" />
            </colgroup>
            <thead>
                <tr><th>檔案名稱</th><th>類型</th><th>正式入庫</th><th>KM 分析</th><th>操作</th></tr>
            </thead>
            <tbody>
                @foreach (var upload in PendingUploads)
                {
                    <tr>
                        <td><strong class="vendor-file-name">@upload.FileName</strong><small>@upload.SubmittedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</small></td>
                        <td>@PendingTypeText(upload.FileName)</td>
                        <td><span class="attachment-status @PendingArchiveClass(upload.Status)">@PendingArchiveText(upload.Status)</span>
                            @if (upload.Status == ApprovalStatus.Rejected && !string.IsNullOrWhiteSpace(upload.RejectReason))
                            { <small class="error-text">原因：@upload.RejectReason</small> }
                        </td>
                        <td><span class="attachment-status">尚未建立 KM 排程</span></td>
                        <td>@if (upload.Status == ApprovalStatus.Rejected) { <a class="table-link-btn" href="/my-submissions">查看／重新送審</a> } else { <span>—</span> }</td>
                    </tr>
                }
                @foreach (var file in Files)
                {
                    <tr>
                        <td>
                            @if (file.IsImage) { <img class="vendor-table-thumbnail" src="@file.DownloadUrl" alt="@file.FileName" /> }
                            <strong class="vendor-file-name">@file.FileName</strong>
                            <small>@FormatSize(file.FileSize)</small>
                        </td>
                        <td>@FileTypeText(file)</td>
                        <td><span class="attachment-status @ArchiveClass(file.ArchiveStatus)">@ArchiveText(file.ArchiveStatus)</span>
                            @if (!string.IsNullOrWhiteSpace(file.ArchiveError)) { <small class="error-text">@file.ArchiveError</small> }
                        </td>
                        <td><span class="attachment-status @KmClass(file)">@KmText(file)</span>
                            @if (!string.IsNullOrWhiteSpace(file.KmError)) { <small class="error-text">@file.KmError</small> }
                        </td>
                        <td class="action-cell">
                            <a class="table-link-btn" href="@file.DownloadUrl" target="_blank" rel="noopener">檢視</a>
                            @if (OnDelete.HasDelegate)
                            {
                                <button type="button" class="table-chip-btn danger" disabled="@(!file.CanDelete)"
                                        title="@(file.CanDelete ? null : "已進入審核／KM 追蹤流程，禁止直接刪除")"
                                        @onclick="() => OnDelete.InvokeAsync(file.Id)">刪除</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter] public IReadOnlyList<VendorFileDto> Files { get; set; } = [];
    [Parameter] public IReadOnlyList<OwnApprovalUploadDto> PendingUploads { get; set; } = [];
    [Parameter] public EventCallback<Guid> OnDelete { get; set; }

    private static readonly HashSet<string> ImageExtensions = new(StringComparer.OrdinalIgnoreCase)
    {
        ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp", ".tif", ".tiff", ".svg", ".heic"
    };

    private static string FileTypeText(VendorFileDto file) => file.IsImage
        ? "廠商圖片"
        : "Manual／Datasheet／廠商文件";

    private static string PendingTypeText(string fileName) => ImageExtensions.Contains(Path.GetExtension(fileName))
        ? "廠商圖片"
        : "Manual／Datasheet／廠商文件";

    private static string PendingArchiveText(ApprovalStatus status) => status switch
    {
        ApprovalStatus.Pending => "等待主管審核",
        ApprovalStatus.ApprovedPendingCommit => "已核准，正式入庫中",
        ApprovalStatus.CommitFailed => "正式入庫失敗，等待重試",
        ApprovalStatus.Rejected => "已退回，尚未入庫",
        _ => "尚未完成"
    };

    private static string PendingArchiveClass(ApprovalStatus status) => status switch
    {
        ApprovalStatus.Pending or ApprovalStatus.ApprovedPendingCommit => "processing",
        ApprovalStatus.CommitFailed or ApprovalStatus.Rejected => "failed",
        _ => "warning"
    };

    private static string ArchiveText(string status) => status switch
    {
        FileArchiveStatuses.Archived => "正式入庫完成",
        FileArchiveStatuses.Failed => "正式入庫失敗",
        FileArchiveStatuses.Pending => "核准後歸檔中",
        _ => "尚未完成"
    };

    private static string ArchiveClass(string status) => status switch
    {
        FileArchiveStatuses.Archived => "completed",
        FileArchiveStatuses.Failed => "failed",
        FileArchiveStatuses.Pending => "processing",
        _ => "warning"
    };

    private static string KmText(VendorFileDto file)
    {
        if (!file.HasKmSchedule) return "未建立 KM 排程";
        if (!file.KmEnabled && file.KmStatus == nameof(KmIntegrationStatus.Pending)) return "KM 尚未啟用";
        return file.KmStatus switch
        {
            nameof(KmIntegrationStatus.Pending) => "等待 KM 通知",
            nameof(KmIntegrationStatus.Dispatching) => "KM 派送中",
            nameof(KmIntegrationStatus.Sent) => "KM 已接收",
            nameof(KmIntegrationStatus.Processing) => "KM 分析中",
            nameof(KmIntegrationStatus.Completed) => "KM 分析完成",
            nameof(KmIntegrationStatus.Failed) => "KM 失敗",
            _ => "等待 KM 通知"
        };
    }

    private static string KmClass(VendorFileDto file)
    {
        if (!file.HasKmSchedule || (!file.KmEnabled && file.KmStatus == nameof(KmIntegrationStatus.Pending))) return string.Empty;
        return file.KmStatus switch
        {
            nameof(KmIntegrationStatus.Completed) => "completed",
            nameof(KmIntegrationStatus.Failed) => "failed",
            nameof(KmIntegrationStatus.Dispatching) or nameof(KmIntegrationStatus.Sent) or nameof(KmIntegrationStatus.Processing) => "processing",
            _ => string.Empty
        };
    }

    private static string FormatSize(long size) => size >= 1024 * 1024
        ? $"{size / 1024d / 1024d:0.##} MB"
        : size >= 1024 ? $"{size / 1024d:0.##} KB" : $"{size} B";
}
