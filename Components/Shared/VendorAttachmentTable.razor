@using SIT.DepartmentSystem.Web.Entities
@using SIT.DepartmentSystem.Web.Models.Api
@using SIT.DepartmentSystem.Web.Services.Approval
@using SIT.DepartmentSystem.Web.Services

@if (Files.Count == 0 && PendingUploads.Count == 0)
{
    <div class="record-empty-box"><strong>目前沒有廠商附件</strong></div>
}
else
{
    <div class="project-table-wrap">
        <table class="project-table vendor-attachment-table">
            <colgroup>
                <col class="vendor-file-name-column" />
                <col class="vendor-file-type-column" />
                <col class="vendor-file-uploader-column" />
                <col class="vendor-file-archive-column" />
                <col class="vendor-file-km-column" />
                <col class="vendor-file-actions-column" />
            </colgroup>
            <thead>
                <tr><th>檔案名稱</th><th>類型</th><th>上傳者</th><th>正式入庫</th><th>KM 分析</th><th>操作</th></tr>
            </thead>
            <tbody>
                @foreach (var upload in PendingUploads)
                {
                    <tr>
                        <td><strong class="vendor-file-name">@upload.FileName</strong><small>@upload.SubmittedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</small></td>
                        <td>@PendingTypeText(upload.FileName)</td>
                        <td>@Display(upload.UploadedBy)</td>
                        <td><AttachmentStatusPill Status="@AttachmentStatusPresentation.Archive(upload.Status)" />
                            @if (upload.Status == ApprovalStatus.Rejected && !string.IsNullOrWhiteSpace(upload.RejectReason))
                            { <small class="error-text">原因：@upload.RejectReason</small> }
                        </td>
                        <td><AttachmentStatusPill Status="@AttachmentStatusPresentation.Km(false, true, null)" /></td>
                        <td>@if (upload.Status == ApprovalStatus.Rejected) { <a class="table-link-btn" href="/my-submissions">查看／重新送審</a> } else { <span>—</span> }</td>
                    </tr>
                }
                @foreach (var file in Files)
                {
                    <tr>
                        <td>
                            @if (file.IsImage) { <img class="vendor-table-thumbnail" src="@file.DownloadUrl" alt="@file.FileName" /> }
                            <strong class="vendor-file-name">@file.FileName</strong>
                            <small>@FormatSize(file.FileSize)</small>
                        </td>
                        <td>@FileTypeText(file)</td>
                        <td>@Display(file.UploadedBy)<small>@file.UploadedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</small></td>
                        <td><AttachmentStatusPill Status="@AttachmentStatusPresentation.Archive(file.ArchiveStatus)" Title="@file.ArchiveError" />
                            @if (!string.IsNullOrWhiteSpace(file.ArchiveError)) { <small class="error-text">@file.ArchiveError</small> }
                        </td>
                        <td><AttachmentStatusPill Status="@AttachmentStatusPresentation.Km(file.HasKmSchedule, file.KmEnabled, file.KmStatus)" Title="@file.KmError" />
                            @if (!string.IsNullOrWhiteSpace(file.KmError)) { <small class="error-text">@file.KmError</small> }
                            @if (!string.IsNullOrWhiteSpace(file.DeletionStatus))
                            { <small>刪除：@file.DeletionStatus</small> }
                            @if (!string.IsNullOrWhiteSpace(file.DeletionError))
                            { <small class="error-text">@file.DeletionError</small> }
                        </td>
                        <td class="action-cell">
                            <a class="table-link-btn" href="@file.DownloadUrl" target="_blank" rel="noopener">檢視</a>
                            @if (OnDelete.HasDelegate)
                            {
                                <button type="button" class="table-chip-btn danger" disabled="@(!file.CanDelete)"
                                        title="@(file.CanDelete ? "提出正式版本刪除申請" : "附件版本刪除作業進行中")"
                                        @onclick="() => OnDelete.InvokeAsync(file.Id)">刪除</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter] public IReadOnlyList<VendorFileDto> Files { get; set; } = [];
    [Parameter] public IReadOnlyList<OwnApprovalUploadDto> PendingUploads { get; set; } = [];
    [Parameter] public EventCallback<Guid> OnDelete { get; set; }

    private static readonly HashSet<string> ImageExtensions = new(StringComparer.OrdinalIgnoreCase)
    {
        ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp", ".tif", ".tiff", ".svg", ".heic"
    };

    private static string FileTypeText(VendorFileDto file) => file.IsImage
        ? "廠商圖片"
        : "Manual／Datasheet／廠商文件";

    private static string PendingTypeText(string fileName) => ImageExtensions.Contains(Path.GetExtension(fileName))
        ? "廠商圖片"
        : "Manual／Datasheet／廠商文件";

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private static string FormatSize(long size) => size >= 1024 * 1024
        ? $"{size / 1024d / 1024d:0.##} MB"
        : size >= 1024 ? $"{size / 1024d:0.##} KB" : $"{size} B";
}
