@using SIT.DepartmentSystem.Web.Models.Api

@if (Field.IsEnabled && IsVisible)
{
    <div id="validation-field-@Field.Code" class="validation-field @WidthClass @(Field.FieldType is "Group" or "RepeatableGroup" ? "validation-group" : "") @(IsFocusTarget ? "validation-field-focus" : "")" data-field-code="@Field.Code">
        <label class="validation-field-label">@Field.DisplayLabel @if (IsRequired) { <span class="required-mark">*</span> }</label>
        @if (!string.IsNullOrWhiteSpace(Field.HelpText)) { <div class="validation-help">@Field.HelpText</div> }
        @if (string.Equals(Field.Code, "DEPARTMENT_CODE", StringComparison.OrdinalIgnoreCase))
        {
            @if (ReadOnly)
            {
                <div class="validation-readonly-value">@TextValue</div>
            }
            else
            {
                <select value="@TextValue" @onchange="SetText"><option value="">請選擇</option>@foreach (var option in DepartmentOptions) { <option value="@option.Value">@DepartmentTeamRules.DisplayName(option.Name, option.Value)</option> }</select>
            }
        }
        else @switch (Field.FieldType)
        {
            case "TextArea":
                <textarea value="@TextValue" @oninput="SetText" disabled="@ReadOnly"></textarea>
                break;
            case "SensitiveText":
                <input type="text" value="@TextValue" @oninput="SetText" disabled="@ReadOnly" autocomplete="off" />
                break;
            case "Number":
                <input type="number" value="@TextValue" @oninput="SetText" disabled="@ReadOnly" />
                break;
            case "Dropdown":
            case "SingleSelect":
                @if (Field.DataSource == "ValidationProductType")
                {
                    <select value="@TextValue" @onchange="SetProductType" disabled="@ReadOnly"><option value="">請選擇</option>@foreach (var option in ProductTypes.Where(x => x.IsEnabled).OrderBy(x => x.DisplayOrder)) { <option value="@option.Code">@option.DisplayLabel</option> }</select>
                }
                else
                {
                    <select value="@TextValue" @onchange="SetText" disabled="@ReadOnly"><option value="">請選擇</option>@foreach (var option in Field.Options.Where(x => x.IsEnabled)) { <option value="@option.ValueCode" disabled="@IsUnavailableLocation(option.ValueCode)">@option.DisplayLabel</option> }</select>
                }
                break;
            case "MultiSelect":
                <div class="validation-choice-list">@foreach (var option in Field.Options.Where(x => x.IsEnabled)) { <label><input type="checkbox" checked="@Contains(option.ValueCode)" disabled="@ReadOnly" @onchange="e => SetMulti(option.ValueCode, e)" /> @option.DisplayLabel</label> }</div>
                break;
            case "Checkbox":
                <label class="validation-checkbox"><input type="checkbox" checked="@BoolValue" disabled="@ReadOnly" @onchange="SetBool" /> 是</label>
                break;
            case "Attachment":
                @if (string.Equals(Field.Code, "OTHER_PRODUCT_INFO", StringComparison.OrdinalIgnoreCase) &&
                    (AttachmentApplicationId.HasValue || AttachmentsManageable || EnsureAttachmentApplicationId is not null))
                {
                    <ValidationApplicationAttachments ApplicationId="AttachmentApplicationId"
                                                      CanManage="AttachmentsManageable"
                                                      EnsureApplicationId="EnsureAttachmentApplicationId"
                                                      DraftEnsured="AttachmentDraftEnsured" />
                }
                else
                {
                    <div class="validation-upload-placeholder" aria-disabled="true"><span>附件</span><small>此附件欄位尚未啟用</small></div>
                }
                break;
            case "Lookup":
                <input value="@TextValue" @oninput="SetText" disabled="@ReadOnly" />
                break;
            case "RepeatableText":
                <div class="validation-repeatable">
                    @for (var index = 0; index < RepeatableTextCount; index++)
                    {
                        var row = index;
                        <div><input value="@TextAt(row)" @oninput="e => SetTextAt(row, e)" disabled="@ReadOnly" />@if (!ReadOnly && RepeatableTextCount > 1) { <button type="button" @onclick="() => RemoveTextRow(row)">移除</button> }</div>
                    }
                    @if (!ReadOnly) { <button type="button" @onclick="AddTextRow">＋ 新增</button> }
                </div>
                break;
            case "RepeatableGroup":
                @for (var index = 0; index < RepeatableGroupCount; index++)
                {
                    var row = index;
                    <div class="validation-group-fields">@foreach (var child in Field.Children) { <ValidationRequestFieldPreview Field="child" Values="Values" ValuesChanged="ValuesChanged" ProductTypes="ProductTypes" ProductTypeChanged="ProductTypeChanged" DepartmentOptions="DepartmentOptions" ReadOnly="ReadOnly" ValueIndex="row" AttachmentApplicationId="AttachmentApplicationId" AttachmentsManageable="AttachmentsManageable" EnsureAttachmentApplicationId="EnsureAttachmentApplicationId" AttachmentDraftEnsured="AttachmentDraftEnsured" FocusFieldCode="FocusFieldCode" /> }</div>
                    @if (!ReadOnly && RepeatableGroupCount > 1) { <button type="button" class="validation-add-row" @onclick="() => RemoveGroupRow(row)">移除此組</button> }
                }
                @if (!ReadOnly) { <button type="button" class="validation-add-row" @onclick="AddGroupRow">＋ 新增一組</button> }
                break;
            case "Group":
                <div class="validation-group-fields">@foreach (var child in Field.Children) { <ValidationRequestFieldPreview Field="child" Values="Values" ValuesChanged="ValuesChanged" ProductTypes="ProductTypes" ProductTypeChanged="ProductTypeChanged" DepartmentOptions="DepartmentOptions" ReadOnly="ReadOnly" AttachmentApplicationId="AttachmentApplicationId" AttachmentsManageable="AttachmentsManageable" EnsureAttachmentApplicationId="EnsureAttachmentApplicationId" AttachmentDraftEnsured="AttachmentDraftEnsured" FocusFieldCode="FocusFieldCode" /> }</div>
                break;
            default:
                <input value="@TextValue" @oninput="SetText" disabled="@ReadOnly" />
                break;
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public ValidationFieldDto Field { get; set; } = null!;
    [Parameter, EditorRequired] public Dictionary<string, List<string>> Values { get; set; } = null!;
    [Parameter] public EventCallback ValuesChanged { get; set; }
    [Parameter] public IReadOnlyList<ValidationProductTypeDto> ProductTypes { get; set; } = [];
    [Parameter] public IReadOnlyList<SystemOptionDto> DepartmentOptions { get; set; } = [];
    [Parameter] public EventCallback<string> ProductTypeChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public int? ValueIndex { get; set; }
    [Parameter] public Guid? AttachmentApplicationId { get; set; }
    [Parameter] public bool AttachmentsManageable { get; set; }
    [Parameter] public Func<Task<Guid>>? EnsureAttachmentApplicationId { get; set; }
    [Parameter] public EventCallback<Guid> AttachmentDraftEnsured { get; set; }
    [Parameter] public string? FocusFieldCode { get; set; }
    private string TextValue => TextAt(ValueIndex ?? 0);
    private bool BoolValue => string.Equals(TextValue, "true", StringComparison.OrdinalIgnoreCase);
    private bool Contains(string value) => Values.TryGetValue(Field.Code, out var v) && v.Contains(value, StringComparer.OrdinalIgnoreCase);
    private bool IsFocusTarget => string.Equals(Field.Code, FocusFieldCode, StringComparison.OrdinalIgnoreCase);
    private bool IsUnavailableLocation(string value) =>
        string.Equals(Field.Code, "LOCATION", StringComparison.OrdinalIgnoreCase) &&
        string.Equals(value, "WUJIANG", StringComparison.OrdinalIgnoreCase);
    private bool IsVisible => Field.Conditions.Where(x => x.Action == "Visible").All(Evaluate);
    private bool IsRequired => Field.IsRequired || Field.Conditions.Where(x => x.Action == "Required").Any(Evaluate);
    private string WidthClass => Field.FieldType is "TextArea" or "Attachment" or "Group" or "RepeatableGroup" or "RepeatableText" || Field.DisplayLabel.Length > 42 ? "validation-field-wide" : "";
    private bool Evaluate(ValidationConditionDto c)
    {
        Values.TryGetValue(c.SourceFieldCode, out var value); value ??= []; var expected = c.ExpectedValue ?? "";
        return c.Operator switch
        {
            "Equals" => value.Any(x => string.Equals(x, expected, StringComparison.OrdinalIgnoreCase)),
            "NotEquals" => value.All(x => !string.Equals(x, expected, StringComparison.OrdinalIgnoreCase)),
            "Contains" => value.Contains(expected, StringComparer.OrdinalIgnoreCase),
            "NotContains" => !value.Contains(expected, StringComparer.OrdinalIgnoreCase),
            "IsTrue" => value.Any(x => string.Equals(x, "true", StringComparison.OrdinalIgnoreCase)),
            "IsFalse" => value.All(x => !string.Equals(x, "true", StringComparison.OrdinalIgnoreCase)), _ => false
        };
    }
    private int RepeatableTextCount => Math.Max(1, Values.TryGetValue(Field.Code, out var values) ? values.Count : 0);
    private int RepeatableGroupCount => Math.Max(1, Field.Children.Select(x => Values.TryGetValue(x.Code, out var values) ? values.Count : 0).DefaultIfEmpty().Max());
    private string TextAt(int index) => Values.TryGetValue(Field.Code, out var values) && index < values.Count ? values[index] : "";
    private async Task SetText(ChangeEventArgs e) => await SetTextAt(ValueIndex ?? 0, e);
    private async Task SetTextAt(int index, ChangeEventArgs e) { if (!Values.TryGetValue(Field.Code, out var values)) Values[Field.Code] = values = []; while (values.Count <= index) values.Add(""); values[index] = e.Value?.ToString() ?? ""; await ValuesChanged.InvokeAsync(); }
    private async Task SetProductType(ChangeEventArgs e) { var code = e.Value?.ToString() ?? ""; Values[Field.Code] = [code]; await ValuesChanged.InvokeAsync(); await ProductTypeChanged.InvokeAsync(code); }
    private async Task SetBool(ChangeEventArgs e) { Values[Field.Code] = [string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase) ? "true" : "false"]; await ValuesChanged.InvokeAsync(); }
    private async Task SetMulti(string value, ChangeEventArgs e) { if (!Values.TryGetValue(Field.Code, out var set)) Values[Field.Code] = set = []; if (string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase)) { if (!set.Contains(value, StringComparer.OrdinalIgnoreCase)) set.Add(value); } else set.RemoveAll(x => string.Equals(x, value, StringComparison.OrdinalIgnoreCase)); await ValuesChanged.InvokeAsync(); }
    private void AddTextRow() { if (!Values.TryGetValue(Field.Code, out var values)) Values[Field.Code] = values = []; values.Add(""); }
    private void RemoveTextRow(int index) { if (Values.TryGetValue(Field.Code, out var values) && index < values.Count) values.RemoveAt(index); }
    private void AddGroupRow() { foreach (var child in Field.Children) { if (!Values.TryGetValue(child.Code, out var values)) Values[child.Code] = values = []; values.Add(""); } }
    private void RemoveGroupRow(int index) { foreach (var child in Field.Children) if (Values.TryGetValue(child.Code, out var values) && index < values.Count) values.RemoveAt(index); }
}
