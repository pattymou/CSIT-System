@using SIT.DepartmentSystem.Web.Models.Api
@using SIT.DepartmentSystem.Web.Services.ValidationRequests
<style>
    .validation-test-item > input,
    .validation-choice-list input[type="checkbox"],
    .validation-checkbox input[type="checkbox"] {
        width:16px!important;
        height:16px!important;
        min-height:0!important;
        flex:0 0 16px;
        margin:2px 0 0;
    }
</style>

@if (Preview is not null)
{
    <div class="validation-preview">
        @if (ShowPreviewBadge) { <div class="validation-preview-intro"><strong>預覽模式</strong><span>目前僅供檢視欄位與區塊配置，送出功能將於後續階段開放。</span></div> }
        @if (ExpandSections && ReadOnly)
        {
            @foreach (var expandedSection in Preview.Sections.OrderBy(x => x.Code == "COMMON_PRODUCT_INFO" ? 0 : 1))
            {
                <section class="dashboard-card validation-section-group" data-section-code="@expandedSection.Code">
                    <div class="validation-section-heading"><h2>@ValidationRequestPresentation.SectionLabel(expandedSection)</h2></div>
                    @foreach (var group in ValidationRequestPresentation.Groups(expandedSection).Where(x => x.Fields.Count > 0))
                    {
                        <div class="validation-snapshot-group">
                            <h3>@group.Label</h3>
                            <div class="validation-fields">
                                @foreach (var field in group.Fields)
                                {
                                    <ValidationRequestFieldReadOnly Field="field" Values="Values" ProductTypes="ProductTypes"
                                                                    ApplicationId="AttachmentApplicationId" />
                                }
                            </div>
                        </div>
                    }
                </section>
            }
        }
        else
        {
        <nav class="validation-form-tabs" role="tablist" aria-label="申請單區塊">
            @foreach (var tabSection in Preview.Sections)
            {
                <button type="button" role="tab" class="@(_activeTab == tabSection.Code ? "active" : null)"
                        aria-selected="@(_activeTab == tabSection.Code)" @onclick="() => _activeTab = tabSection.Code">@ValidationRequestPresentation.SectionLabel(tabSection)</button>
            }
            <button type="button" role="tab" class="@(_activeTab == TestItemsTab ? "active" : null)"
                    aria-selected="@(_activeTab == TestItemsTab)" @onclick="() => _activeTab = TestItemsTab">測試項目</button>
        </nav>

        @if (ActiveSection is { } section)
        {
            <div class="validation-section-stack" data-section-code="@section.Code">
                @foreach (var group in ValidationRequestPresentation.Groups(section).Where(x => x.Fields.Count > 0))
                {
                    <section class="dashboard-card validation-section-group">
                        <div class="validation-section-heading">
                            <div><span>申請內容</span><h2>@group.Label</h2></div>
                            @if (!string.IsNullOrWhiteSpace(section.Description)) { <p>@section.Description</p> }
                        </div>
                        <div class="validation-fields">
                            @foreach (var field in group.Fields)
                            {
                                <ValidationRequestFieldPreview Field="field" Values="Values" ValuesChanged="StateHasChanged" FocusFieldCode="FocusFieldCode"
                                                               ProductTypes="ProductTypes" ProductTypeChanged="HandleProductTypeChanged" DepartmentOptions="DepartmentOptions" ReadOnly="ReadOnly"
                                                               AttachmentApplicationId="AttachmentApplicationId" AttachmentsManageable="AttachmentsManageable"
                                                               EnsureAttachmentApplicationId="EnsureAttachmentApplicationId" AttachmentDraftEnsured="AttachmentDraftEnsured" />
                            }
                        </div>
                    </section>
                }
            </div>
        }
        else if (_activeTab == TestItemsTab)
        {
            <section class="dashboard-card validation-section-group validation-test-items">
                <div class="validation-section-heading"><div><span>測試內容</span><h2>測試項目</h2></div></div>
                @foreach (var category in Preview.TestCategories)
                {
                    <div class="validation-category" data-category-code="@category.Code">
                        <h3>@ValidationRequestPresentation.CategoryLabel(category)</h3>
                        @if (category.TestItems.Count == 0) { <div class="validation-empty">目前沒有設定測試項目</div> }
                        <div class="validation-test-grid">
                            @foreach (var item in category.TestItems.Where(x => x.IsEnabled))
                            {
                                <label class="validation-test-item @(item.IsMandatory ? "mandatory" : null)">
                                    <input type="checkbox" checked="@IsSelected(item)" disabled="@(ReadOnly || item.IsMandatory)" @onchange="e => SetTestItem(item, e)" />
                                    <span><strong>@item.DisplayLabel</strong><small>@(item.IsMandatory ? "必選" : "可選")</small>
                                        @if (!string.IsNullOrWhiteSpace(item.Description)) { <small>@item.Description</small> }
                                    </span>
                                </label>
                                @if (IsSelected(item) && item.Parameters.Count > 0)
                                {
                                    <div class="validation-test-parameters">
                                        @foreach (var parameter in item.Parameters.Where(x => x.IsEnabled))
                                        {
                                            <ValidationRequestParameterInput Parameter="parameter" Values="ParameterValues(item.Code)" ReadOnly="ReadOnly" />
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            </section>
        }
        }
    </div>
}

@code {
    private const string TestItemsTab = "__TEST_ITEMS";
    [Parameter] public ValidationRequestPreviewDto? Preview { get; set; }
    [Parameter] public IReadOnlyList<ValidationProductTypeDto> ProductTypes { get; set; } = [];
    [Parameter] public IReadOnlyList<SystemOptionDto> DepartmentOptions { get; set; } = [];
    [Parameter] public string SelectedProductCode { get; set; } = "";
    [Parameter] public EventCallback<string> SelectedProductCodeChanged { get; set; }
    [Parameter] public bool ShowPreviewBadge { get; set; }
    [Parameter] public Dictionary<string, List<string>> Values { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    [Parameter] public HashSet<string> SelectedTestItemCodes { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    [Parameter] public Dictionary<string, Dictionary<string, List<string>>> TestParameterValues { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool ExpandSections { get; set; }
    [Parameter] public Guid? AttachmentApplicationId { get; set; }
    [Parameter] public bool AttachmentsManageable { get; set; }
    [Parameter] public Func<Task<Guid>>? EnsureAttachmentApplicationId { get; set; }
    [Parameter] public EventCallback<Guid> AttachmentDraftEnsured { get; set; }
    [Parameter] public string? RequestedActiveTab { get; set; }
    [Parameter] public int ActiveTabRequestVersion { get; set; }
    [Parameter] public string? FocusFieldCode { get; set; }
    private string? _activeTab;
    private string? _lastProductCode;
    private int _lastActiveTabRequestVersion = -1;
    private ValidationSectionDto? ActiveSection => Preview?.Sections.FirstOrDefault(x => x.Code == _activeTab);

    protected override void OnParametersSet()
    {
        if (Preview is null) return;
        if (_lastProductCode != Preview.ProductTypeCode)
        {
            _lastProductCode = Preview.ProductTypeCode;
            Values["PRODUCT_TYPE"] = [Preview.ProductTypeCode];
            foreach (var mandatory in Preview.TestCategories.SelectMany(x => x.TestItems).Where(x => x.IsEnabled && x.IsMandatory))
                SelectedTestItemCodes.Add(mandatory.Code);
        }
        if (_activeTab is null || (_activeTab != TestItemsTab && Preview.Sections.All(x => x.Code != _activeTab)))
            _activeTab = Preview.Sections.FirstOrDefault()?.Code ?? TestItemsTab;
        if (!string.IsNullOrWhiteSpace(RequestedActiveTab) &&
            _lastActiveTabRequestVersion != ActiveTabRequestVersion &&
            (RequestedActiveTab == TestItemsTab || Preview.Sections.Any(x => x.Code == RequestedActiveTab)))
        {
            _activeTab = RequestedActiveTab;
            _lastActiveTabRequestVersion = ActiveTabRequestVersion;
        }
    }

    private async Task HandleProductTypeChanged(string code)
    {
        Values["PRODUCT_TYPE"] = [code];
        if (SelectedProductCodeChanged.HasDelegate) await SelectedProductCodeChanged.InvokeAsync(code);
    }

    private bool IsSelected(ValidationTestItemDto item) => item.IsMandatory || SelectedTestItemCodes.Contains(item.Code);
    private void SetTestItem(ValidationTestItemDto item, ChangeEventArgs e)
    {
        if (item.IsMandatory || ReadOnly) return;
        if (string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase)) SelectedTestItemCodes.Add(item.Code);
        else SelectedTestItemCodes.Remove(item.Code);
    }
    private Dictionary<string, List<string>> ParameterValues(string itemCode)
    {
        if (!TestParameterValues.TryGetValue(itemCode, out var values))
            TestParameterValues[itemCode] = values = new(StringComparer.OrdinalIgnoreCase);
        return values;
    }
}
