@page "/reservations/new"
@page "/reservations/{Id:guid}/edit"
@layout RdLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Policy = SystemAuthorization.Policies.RdApplicant)]
@using SIT.DepartmentSystem.Web.Entities
@inject ReservationApiClient Api
@inject NavigationManager Nav

<PageTitle>@(_isEdit ? "修改設備預約" : "新增設備預約")</PageTitle>
<h3 class="page-title">@(_isEdit ? "修改設備預約" : "新增設備預約")</h3>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="surface-card @(_isError ? "error-text" : "workflow-note")">
        @_message
    </div>
}

@if (_loading)
{
    <div class="surface-card">載入中...</div>
}
else if (_canEdit)
{
    <div class="reservation-form">
        <section class="surface-card reservation-section">
            <div class="reservation-section-heading"><span>1</span><div><h4>選擇設備</h4><p>先選擇預約方式與設備，再填寫借用時間及用途。</p></div></div>
            <div class="reservation-mode-cards" role="radiogroup" aria-label="設備配置方式">
                <label class="reservation-mode-card @(_mode == ReservationMode.Direct ? "selected" : "")">
                    <input class="reservation-mode-radio" type="radio" name="reservation-mode" checked="@(_mode == ReservationMode.Direct)" disabled="@_isEdit" @onchange="() => SetMode(ReservationMode.Direct)" />
                    <span class="reservation-mode-copy"><strong class="reservation-mode-title">自行選擇設備</strong><small>自己指定本次要借用的實體設備</small></span>
                </label>
                <label class="reservation-mode-card @(_mode == ReservationMode.Environment ? "selected" : "")">
                    <input class="reservation-mode-radio" type="radio" name="reservation-mode" checked="@(_mode == ReservationMode.Environment)" disabled="@_isEdit" @onchange="() => SetMode(ReservationMode.Environment)" />
                    <span class="reservation-mode-copy"><strong class="reservation-mode-title">依測試環境配置</strong><small>使用測試環境群組目前配置的完整設備</small></span>
                </label>
            </div>
            @if (_isEdit) { <div class="hint-text mode-lock-note">草稿建立後不可切換預約方式。</div> }

        @if (_mode == ReservationMode.Direct)
        {
            <div class="equipment-section">
                <div class="section-heading">
                    <div><h4>可選設備</h4><span class="hint-text">一次只能選擇一台目前可借用的設備；改選會取代原選擇。</span></div>
                    <input class="equipment-search" @bind="_keyword" @bind:event="oninput" placeholder="搜尋名稱、財產編號、類型、品牌、型號、編號或地點" />
                </div>
                <div class="equipment-grid">
                    @foreach (var item in FilteredEquipment)
                    {
                        <article class="equipment-card @(_directSelectedIds.Contains(item.Id) ? "selected" : "") @(item.IsDirectReservationLocked ? "environment-locked" : "")">
                            @EquipmentCard(item)
                            <div class="equipment-card-actions"><button type="button" class="btn-secondary" disabled="@_saving" @onclick="() => OpenCalendar(item)">查看預約</button><button type="button" class="@(_directSelectedIds.Contains(item.Id) ? "btn-secondary" : "btn-primary")" disabled="@(_saving || (item.IsDirectReservationLocked && !_directSelectedIds.Contains(item.Id)))" @onclick="() => ToggleDirect(item.Id)">@(item.IsDirectReservationLocked && !_directSelectedIds.Contains(item.Id) ? "不可單獨預約" : _directSelectedIds.Contains(item.Id) ? "移除" : _directSelectedIds.Count == 0 ? "選擇" : "改選")</button></div>
                        </article>
                    }
                </div>
                @SelectedEquipmentBlock(_directSelectedIds, true)
            </div>
        }
        else
        {
            <div class="environment-section">
                <div class="environment-cascade">
                    <div class="form-row"><label>負責 Team *</label>
                        <select value="@(_selectedTeamOptionId?.ToString() ?? string.Empty)" disabled="@_saving" @onchange="EnvironmentTeamChangedAsync">
                            <option value="">請選擇 Team</option>
                            @foreach (var team in _environmentTeams)
                            {
                                <option value="@team.TeamOptionId">@team.DisplayName</option>
                            }
                        </select>
                    </div>
                    <div class="form-row environment-group-select"><label>測試環境群組 *</label>
                        <select value="@(_environmentGroupId?.ToString() ?? string.Empty)" disabled="@(!_selectedTeamOptionId.HasValue || _loadingEnvironmentGroups || _saving)" @onchange="EnvironmentGroupChanged">
                            <option value="">@EnvironmentGroupPlaceholder</option>
                            @foreach (var group in _environmentGroups)
                            {
                                <option value="@group.Id">@group.Name (@group.Code)</option>
                            }
                        </select>
                    </div>
                </div>

                @if (_selectedTeamOptionId.HasValue && !_loadingEnvironmentGroups && _environmentGroups.Count == 0)
                {
                    <div class="environment-empty">此 Team 目前沒有可用的測試環境群組。</div>
                }

                @if (SelectedEnvironmentGroup is not null)
                {
                    var group = SelectedEnvironmentGroup;
                    <div class="environment-group-summary">
                        <div class="environment-group-title">
                            <div><strong>@group.Name</strong><span>@group.Code</span></div>
                            <div class="environment-group-title-actions"><span class="completeness-badge @CompletenessClass(group.CompletenessStatus)">@CompletenessName(group.CompletenessStatus)</span><button type="button" class="btn-secondary" @onclick="() => OpenEnvironmentCalendar(group)">查看預約</button></div>
                        </div>
                        <div class="environment-summary-grid">
                            <div><span>負責 Team</span><strong>@DisplaySnapshot(group.OwnerTeamName)</strong></div>
                            <div><span>Site</span><strong>@DisplaySnapshot(group.Site)</strong></div>
                            <div><span>設備完整性</span><strong>@group.InEnvironmentDeviceCount / @group.TotalDeviceCount</strong></div>
                            <div><span>完整性狀態</span><strong>@CompletenessName(group.CompletenessStatus)</strong></div>
                        </div>
                    </div>
                    @if (!group.CanReserve)
                    {
                        <div class="environment-blocking" role="alert">
                            @foreach (var reason in group.BlockingReasons) { <div>@reason</div> }
                        </div>
                    }

                    <div class="environment-device-section">
                        <div><h4>環境設備清單</h4><span class="hint-text">預約設備由後端依群組正式 membership 建立，無法在此增減。</span></div>
                        <div class="environment-device-grid">
                        @foreach (var device in group.Devices)
                        {
                            <article class="environment-device-card @(!device.IsInEnvironment ? "missing" : "")">
                                <div><strong>@device.Name</strong><span>@ReservationUi.Display(device.ProductsId) · @device.ApparatusId</span></div>
                                <div>@ReservationUi.Display(device.Kind) · @ReservationUi.Display(device.Brand) / @ReservationUi.Display(device.Model)</div>
                                <div class="environment-device-state"><span>@(device.IsInEnvironment ? "在環境" : "已移出")</span><span>@ReservationUi.Display(device.ReservationStatus)</span></div>
                            </article>
                        }
                        </div>
                    </div>
                }
                else if (_environmentGroupId.HasValue)
                {
                    <div class="environment-blocking">舊版測試環境預約或群組目前已停用；請返回明細查看原預約內容。</div>
                }
            </div>
        }

        </section>

        <section class="surface-card reservation-section">
            <div class="reservation-section-heading"><span>2</span><div><h4>借用時間</h4><p>請以本地時間選擇設備實際借用期間。</p></div></div>
            <div class="time-grid">
                <div class="form-row"><label>開始時間（本地時間）*</label><div class="datetime-control"><input @ref="_startInput" class="datetime-input" type="datetime-local" value="@_startLocal" @onchange="StartTimeChanged" /><button type="button" class="picker-button" title="選擇開始時間" @onclick="OpenStartPickerAsync" aria-label="選擇開始時間">▣</button></div></div>
                <div class="form-row"><label>結束時間（本地時間）*</label><div class="datetime-control"><input @ref="_endInput" class="datetime-input" type="datetime-local" value="@_endLocal" @onchange="EndTimeChanged" /><button type="button" class="picker-button" title="選擇結束時間" @onclick="OpenEndPickerAsync" aria-label="選擇結束時間">▣</button></div></div>
            </div>
            <div class="duration-hint">
                @if (BorrowDuration is { } duration)
                {
                    <span>借用期間：@DurationText(duration)</span>
                    @if (_policySettings is not null)
                    {
                        <span>單次借用上限：@_policySettings.MaxBorrowDays 天</span>
                        @if (duration > TimeSpan.FromDays(_policySettings.MaxBorrowDays)) { <strong>借用期間已超過目前單次上限 @_policySettings.MaxBorrowDays 天。</strong> }
                    }
                }
                else { <span>請選擇有效的開始與結束時間。</span> }
            </div>
        </section>

        <section class="surface-card reservation-section">
            <div class="reservation-section-heading"><span>3</span><div><h4>測試 / 專案資訊</h4><p>填寫此次設備借用的任務與專案資訊。</p></div></div>
            <div class="reservation-data-grid project-data-grid">
                <div class="form-row purpose-field"><label>任務名稱 / 預約用途 *</label><textarea @bind="_purpose" placeholder="請說明設備用途"></textarea></div>
                <div class="form-row"><label>機種名稱 *</label><input @bind="_productModelName" maxlength="300" /></div>
                <div class="form-row"><label>客戶 *</label>
                    <select @bind="_customer">
                        <option value="">請選擇客戶</option>
                        @foreach (var option in CustomerOptions) { <option value="@option.Value">@option.Label</option> }
                    </select>
                    @if (_applicationOptions is not null && _applicationOptions.Customers.Count == 0) { <div class="option-warning">目前尚未設定客戶選項，請聯絡系統管理者。</div> }
                </div>
                <div class="form-row"><label>專案 / 機種 Sub-PU *</label>
                    <select @bind="_projectSubPu">
                        <option value="">請選擇 Sub-PU</option>
                        @foreach (var option in SubPuOptions) { <option value="@option.Value">@option.Label</option> }
                    </select>
                    @if (_applicationOptions is not null && _applicationOptions.SubPus.Count == 0) { <div class="option-warning">目前尚未設定 Sub-PU 選項，請聯絡系統管理者。</div> }
                </div>
                <div class="form-row full-width"><label>Reservation 備註</label><textarea @bind="_note" maxlength="2000"></textarea></div>
            </div>
        </section>

        <section class="surface-card reservation-section">
            <div class="reservation-section-heading"><span>4</span><div><h4>申請 / 聯絡資訊</h4><p>申請人資料由登入身份自動保留；分機與代理聯絡人可填寫。</p></div></div>
            <div class="reservation-data-grid applicant-data-grid">
                <div class="snapshot-field"><span>申請人</span><strong>@DisplaySnapshot(_applicantName)</strong></div>
                <div class="snapshot-field"><span>部門</span><strong>@DisplaySnapshot(_applicantDepartment)</strong></div>
                <div class="snapshot-field"><span>Email</span><strong>@DisplaySnapshot(_applicantEmail)</strong></div>
                <div class="form-row extension-field"><label>分機 *</label><input @bind="_applicantExtension" maxlength="30" placeholder="例如：1234" /></div>
                <div class="form-row"><label>代理聯絡人姓名 *</label><input @bind="_applicantAgentName" maxlength="200" /></div>
                <div class="form-row"><label>代理聯絡人分機 *</label><input @bind="_applicantAgentExtension" maxlength="30" /></div>
                <div class="form-row"><label>代理聯絡人 Email *</label><input @bind="_applicantAgentEmail" maxlength="320" type="email" /></div>
            </div>
        </section>

        <div class="form-actions reservation-actions">
            <button type="button" class="btn-secondary" disabled="@_saving" @onclick="Back">取消 / 返回</button>
            <button type="button" class="btn-secondary" disabled="@_saving" @onclick="() => SaveAsync(false)">儲存草稿</button>
            <button type="button" class="btn-primary" disabled="@(_saving || !CanSubmitWithApplicationOptions)" @onclick="() => SaveAsync(true)">@(_saving ? "處理中..." : "送出預約")</button>
            @if (_savedId.HasValue) { <button type="button" class="btn-secondary" @onclick="ViewSaved">查看已儲存草稿</button> }
        </div>
    </div>

    @if (_calendarEquipment is not null || _calendarEnvironmentGroup is not null)
    {
        <div class="reservation-calendar-backdrop" @onclick="CloseCalendar"></div>
        <aside class="reservation-calendar-drawer" role="dialog" aria-label="@(_calendarEnvironmentGroup is null ? "設備預約" : "測試環境預約")">
            <div class="reservation-calendar-drawer-head">
                @if (_calendarEnvironmentGroup is not null)
                {
                    <div><p>TEST ENVIRONMENT RESERVATION</p><h4>@_calendarEnvironmentGroup.Name</h4><span>@_calendarEnvironmentGroup.Code · @ReservationUi.Display(_calendarEnvironmentGroup.OwnerTeamName) · @ReservationUi.Display(_calendarEnvironmentGroup.Site)</span><span>設備 @_calendarEnvironmentGroup.InEnvironmentDeviceCount / @_calendarEnvironmentGroup.TotalDeviceCount · @CompletenessName(_calendarEnvironmentGroup.CompletenessStatus)</span></div>
                }
                else if (_calendarEquipment is not null)
                {
                    <div><p>APPARATUS RESERVATION</p><h4>@_calendarEquipment.Name</h4><span>@ReservationUi.Display(_calendarEquipment.ProductsId) · @ReservationUi.Display(_calendarEquipment.Kind) · @ReservationUi.Display(_calendarEquipment.Brand) / @ReservationUi.Display(_calendarEquipment.Model) · @ReservationUi.Display(_calendarEquipment.Place)</span></div>
                }
                <button type="button" class="btn-secondary" @onclick="CloseCalendar">關閉</button>
            </div>
            <ApparatusReservationCalendar ApparatusId="@(_calendarEquipment?.Id)" EnvironmentGroupId="@(_calendarEnvironmentGroup?.Id)" />
            @if (_calendarEquipment is not null)
            {
                <div class="reservation-calendar-drawer-actions">
                    @if (CalendarEquipmentSelected) { <span class="hint-text">已選擇此設備</span> }
                    else if (_mode == ReservationMode.Direct) { <button type="button" class="btn-primary" disabled="@(_calendarEquipment.IsDirectReservationLocked && !_directSelectedIds.Contains(_calendarEquipment.Id))" @onclick="SelectCalendarEquipment">@(_calendarEquipment.IsDirectReservationLocked ? "不可單獨預約" : "選擇此設備")</button> }
                </div>
            }
        </aside>
    }
}

@code {
    [Parameter] public Guid? Id { get; set; }
    [Parameter] public string BasePath { get; set; } = "/reservations";
    private ElementReference _startInput;
    private ElementReference _endInput;
    private readonly HashSet<string> _directSelectedIds = new(StringComparer.Ordinal);
    private ApparatusListItemDto? _calendarEquipment;
    private ReservationEnvironmentGroupDto? _calendarEnvironmentGroup;
    private List<ApparatusListItemDto> _equipment = [];
    private List<ReservationEnvironmentGroupTeamDto> _environmentTeams = [];
    private List<ReservationEnvironmentGroupDto> _environmentGroups = [];
    private ReservationApplicationOptionsDto? _applicationOptions;
    private ReservationMode _mode = ReservationMode.Direct;
    private Guid? _selectedTeamOptionId;
    private Guid? _environmentGroupId;
    private string _purpose = string.Empty;
    private string _productModelName = string.Empty, _customer = string.Empty, _projectSubPu = string.Empty, _note = string.Empty;
    private string _applicantAgentName = string.Empty, _applicantAgentExtension = string.Empty, _applicantAgentEmail = string.Empty;
    private string _applicantExtension = string.Empty;
    private string _applicantName = string.Empty, _applicantDepartment = string.Empty, _applicantEmail = string.Empty;
    private string _startLocal = string.Empty;
    private string _endLocal = string.Empty;
    private string _keyword = string.Empty;
    private bool _loading = true, _loadingEnvironmentGroups, _saving, _canEdit = true, _isError = true;
    private string? _message;
    private ReservationPolicySettings? _policySettings;
    private Guid? _savedId;
    private bool _isEdit => Id.HasValue;
    private IEnumerable<ApparatusListItemDto> FilteredEquipment => string.IsNullOrWhiteSpace(_keyword) ? _equipment : _equipment.Where(MatchesKeyword);
    private IEnumerable<ReservationOptionDto> CustomerOptions => WithStoredOption(_applicationOptions?.Customers ?? [], _customer);
    private IEnumerable<ReservationOptionDto> SubPuOptions => WithStoredOption(_applicationOptions?.SubPus ?? [], _projectSubPu);
    private ReservationEnvironmentGroupDto? SelectedEnvironmentGroup =>
        _environmentGroups.FirstOrDefault(x => x.Id == _environmentGroupId);
    private string EnvironmentGroupPlaceholder => !_selectedTeamOptionId.HasValue
        ? "請先選擇 Team"
        : _loadingEnvironmentGroups ? "載入中..." : "請選擇測試環境群組";
    private bool CanSubmitWithApplicationOptions => _applicationOptions is { Customers.Count: > 0, SubPus.Count: > 0 };
    private TimeSpan? BorrowDuration => DateTime.TryParse(_startLocal, out var start)
        && DateTime.TryParse(_endLocal, out var end)
        && start < end ? end - start : null;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            _equipment = await Api.GetBookableApparatusAsync();
            _environmentTeams = await Api.GetEnvironmentGroupTeamsAsync();
            _environmentGroups = [];
            _applicationOptions = await Api.GetApplicationOptionsAsync();
            if (_isEdit)
            {
                var item = await Api.GetAsync(Id!.Value);
                if (item.Status != ReservationStatus.Draft) { _canEdit = false; _message = "只有草稿狀態的設備預約可以修改。"; return; }
                _purpose = item.Purpose;
                _productModelName = item.ProductModelName ?? string.Empty; _customer = item.Customer ?? string.Empty; _projectSubPu = item.ProjectSubPu ?? string.Empty; _note = item.Note ?? string.Empty;
                _applicantExtension = item.ApplicantExtension ?? string.Empty;
                _applicantName = item.ApplicantName;
                _applicantDepartment = item.ApplicantDepartment;
                _applicantEmail = item.ApplicantEmail ?? string.Empty;
                _applicantAgentName = item.ApplicantAgentName ?? string.Empty; _applicantAgentExtension = item.ApplicantAgentExtension ?? string.Empty; _applicantAgentEmail = item.ApplicantAgentEmail ?? string.Empty;
                _startLocal = await Api.UtcToLocalInputAsync(item.StartTime);
                _endLocal = await Api.UtcToLocalInputAsync(item.EndTime);
                _mode = item.Mode;
                if (_mode == ReservationMode.Direct)
                {
                    if (item.Items.Count > 1)
                    {
                        _message = "此草稿原有多台設備，請重新選擇 1 台設備後再儲存。";
                        _isError = false;
                    }
                    else
                    {
                        foreach (var apparatusId in item.Items.Select(x => x.ApparatusId)) _directSelectedIds.Add(apparatusId);
                    }
                }
                else
                {
                    _environmentGroupId = item.EquipmentGroupId;
                    if (_environmentGroupId.HasValue)
                    {
                        try
                        {
                            var group = await Api.GetEnvironmentGroupAsync(_environmentGroupId.Value);
                            _selectedTeamOptionId = group.OwnerTeamOptionId;
                            _environmentGroups = await Api.GetEnvironmentGroupsAsync(_selectedTeamOptionId);
                        }
                        catch (ReservationApiException ex) when (ex.StatusCode == 404)
                        {
                            _environmentGroups = [];
                        }
                    }
                }
            }
            else
            {
                _applicantName = _applicationOptions.Applicant.Name;
                _applicantDepartment = _applicationOptions.Applicant.Department;
                _applicantEmail = _applicationOptions.Applicant.Email ?? string.Empty;
                _startLocal = await Api.UtcToLocalInputAsync(DateTime.UtcNow.AddHours(1));
                _endLocal = await Api.UtcToLocalInputAsync(DateTime.UtcNow.AddHours(2));
            }
            try { _policySettings = await Api.GetPolicySettingsAsync(); }
            catch { _policySettings = null; }
        }
        catch (Exception ex) { _canEdit = false; _message = ex.Message; }
        finally { _loading = false; }
    }

    private void SetMode(ReservationMode mode)
    {
        if (_isEdit) return;
        CloseCalendar();
        _mode = mode;
        _message = null;
        if (mode == ReservationMode.Environment)
            _directSelectedIds.Clear();
        else
        {
            _selectedTeamOptionId = null;
            _environmentGroupId = null;
            _environmentGroups = [];
            _loadingEnvironmentGroups = false;
        }
    }

    private async Task EnvironmentTeamChangedAsync(ChangeEventArgs e)
    {
        var teamOptionId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : (Guid?)null;
        _selectedTeamOptionId = teamOptionId;
        CloseCalendar();
        _environmentGroupId = null;
        _environmentGroups = [];
        _loadingEnvironmentGroups = false;
        _message = null;
        if (!teamOptionId.HasValue) return;

        _loadingEnvironmentGroups = true;
        StateHasChanged();
        try
        {
            var groups = await Api.GetEnvironmentGroupsAsync(teamOptionId);
            if (_mode == ReservationMode.Environment && _selectedTeamOptionId == teamOptionId)
                _environmentGroups = groups;
        }
        catch (Exception ex)
        {
            if (_mode == ReservationMode.Environment && _selectedTeamOptionId == teamOptionId)
                _message = ex.Message;
        }
        finally
        {
            if (_selectedTeamOptionId == teamOptionId)
                _loadingEnvironmentGroups = false;
        }
    }

    private void EnvironmentGroupChanged(ChangeEventArgs e)
    {
        CloseCalendar();
        _environmentGroupId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
        _message = null;
    }
    private void StartTimeChanged(ChangeEventArgs e)
    {
        _startLocal = e.Value?.ToString() ?? string.Empty;
    }

    private void EndTimeChanged(ChangeEventArgs e)
    {
        _endLocal = e.Value?.ToString() ?? string.Empty;
    }

    private Task OpenStartPickerAsync() => Api.ShowDateTimePickerAsync(_startInput);
    private Task OpenEndPickerAsync() => Api.ShowDateTimePickerAsync(_endInput);

    private async Task SaveAsync(bool submit)
    {
        _message = null; _isError = true;
        if (string.IsNullOrWhiteSpace(_applicantExtension)) { _message = "請輸入分機。"; return; }
        if (string.IsNullOrWhiteSpace(_purpose)) { _message = "請輸入預約用途。"; return; }
        if (submit && (string.IsNullOrWhiteSpace(_applicantAgentName)
            || string.IsNullOrWhiteSpace(_applicantAgentExtension)
            || string.IsNullOrWhiteSpace(_applicantAgentEmail)))
        {
            _message = "送出預約前，請完整填寫代理聯絡人姓名、分機與 Email。";
            return;
        }
        if (_mode == ReservationMode.Direct && _directSelectedIds.Count != 1) { _message = "Direct 預約一次只能選擇 1 台設備。"; return; }
        if (_mode == ReservationMode.Environment && !ValidateEnvironmentGroup(out _message)) return;
        _saving = true;
        try
        {
            var startUtc = await Api.LocalInputToUtcAsync(_startLocal);
            var endUtc = await Api.LocalInputToUtcAsync(_endLocal);
            if (startUtc >= endUtc) throw new InvalidOperationException("結束時間必須晚於開始時間。");
            var items = _mode == ReservationMode.Direct ? _directSelectedIds.Select(x => new ReservationItemRequest { ApparatusId = x }).ToList() : [];
            var selections = new List<ReservationRequirementSelectionRequest>();
            var editId = Id ?? _savedId;
            ReservationDetailDto saved = editId.HasValue
                ? await Api.UpdateAsync(editId.Value, BuildUpdateRequest(startUtc, endUtc, items, selections))
                : await Api.CreateAsync(BuildCreateRequest(startUtc, endUtc, items, selections));
            _savedId = saved.Id;
            if (!submit) { Nav.NavigateTo($"{BasePath}/{saved.Id}"); return; }
            try { await Api.SubmitAsync(saved.Id); Nav.NavigateTo($"{BasePath}/{saved.Id}"); }
            catch (ReservationApiException ex) when (ex.StatusCode == 409)
            {
                _message = $"草稿已建立或更新，但送出失敗：{ex.Message}";
            }
            catch (Exception ex) { _message = $"草稿已建立或更新，但送出失敗：{ex.Message}"; }
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _saving = false; }
    }


    private bool ValidateEnvironmentGroup(out string? error)
    {
        error = null;
        if (!_selectedTeamOptionId.HasValue)
        {
            error = "請選擇負責 Team。";
            return false;
        }
        if (!_environmentGroupId.HasValue || SelectedEnvironmentGroup is null)
        {
            error = "請選擇測試環境群組。";
            return false;
        }
        if (SelectedEnvironmentGroup.OwnerTeamOptionId != _selectedTeamOptionId.Value)
        {
            error = "測試環境群組與負責 Team 不一致，請重新選擇。";
            return false;
        }
        if (!SelectedEnvironmentGroup.CanReserve)
        {
            error = SelectedEnvironmentGroup.BlockingReasons.FirstOrDefault()
                ?? "此測試環境群組目前不可預約。";
            return false;
        }
        return true;
    }
    private static IEnumerable<ReservationOptionDto> WithStoredOption(
        IReadOnlyCollection<ReservationOptionDto> activeOptions,
        string? storedValue)
    {
        if (string.IsNullOrWhiteSpace(storedValue)
            || activeOptions.Any(x => string.Equals(x.Value, storedValue, StringComparison.Ordinal)))
            return activeOptions;

        return [new ReservationOptionDto
        {
            Value = storedValue,
            Label = $"{storedValue}（原值，目前已停用）"
        }, .. activeOptions];
    }
    private static string DisplaySnapshot(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private CreateReservationRequest BuildCreateRequest(DateTime start, DateTime end, List<ReservationItemRequest> items, List<ReservationRequirementSelectionRequest> selections) => new() { Mode = _mode, Purpose = _purpose, ApplicantExtension = _applicantExtension, StartTime = start, EndTime = end, Items = items, EnvironmentGroupId = _mode == ReservationMode.Environment ? _environmentGroupId : null, TestExecutionProfileId = null, Selections = selections, ProductModelName = _productModelName, Customer = _customer, ProjectSubPu = _projectSubPu, Note = _note, ApplicantAgentName = _applicantAgentName, ApplicantAgentExtension = _applicantAgentExtension, ApplicantAgentEmail = _applicantAgentEmail };
    private UpdateReservationRequest BuildUpdateRequest(DateTime start, DateTime end, List<ReservationItemRequest> items, List<ReservationRequirementSelectionRequest> selections) => new() { Mode = _mode, Purpose = _purpose, ApplicantExtension = _applicantExtension, StartTime = start, EndTime = end, Items = items, EnvironmentGroupId = _mode == ReservationMode.Environment ? _environmentGroupId : null, TestExecutionProfileId = null, Selections = selections, ProductModelName = _productModelName, Customer = _customer, ProjectSubPu = _projectSubPu, Note = _note, ApplicantAgentName = _applicantAgentName, ApplicantAgentExtension = _applicantAgentExtension, ApplicantAgentEmail = _applicantAgentEmail };

    private void ToggleDirect(string id)
    {
        if (_directSelectedIds.Remove(id)) return;
        var item = _equipment.FirstOrDefault(x => x.Id == id);
        if (item?.IsDirectReservationLocked == true)
        {
            _message = $"設備 {ReservationUi.Display(item.ProductsId)} 固定於測試環境 {item.EnvironmentGroupName}，目前不可單獨預約。";
            return;
        }
        _directSelectedIds.Clear();
        _directSelectedIds.Add(id);
    }
    private bool MatchesKeyword(ApparatusListItemDto item) => new[] { item.ProductsId, item.Name, item.Kind, item.Brand, item.Model, item.Number, item.Place }.Any(x => x?.Contains(_keyword.Trim(), StringComparison.OrdinalIgnoreCase) == true);
    private RenderFragment EquipmentCard(ApparatusListItemDto item) => @<div class="equipment-card-content">
        <div class="equipment-card-head"><strong>@item.Name</strong><span>@item.ReservationStatus</span></div>
        <div>@ReservationUi.Display(item.ProductsId) · @ReservationUi.Display(item.Kind)</div><div>@ReservationUi.Display(item.Brand) / @ReservationUi.Display(item.Model)</div>
        <div>@ReservationUi.Display(item.Number) · @ReservationUi.Display(item.Place)</div><div>保管人：@ReservationUi.Display(item.Custodian)</div>
        @if (_mode == ReservationMode.Direct && item.IsDirectReservationLocked)
        {
            <div class="environment-lock-message">🔒 固定於測試環境：@item.EnvironmentGroupName<br />不可單獨預約</div>
        }
    </div>;
    private RenderFragment SelectedEquipmentBlock(HashSet<string> ids, bool removable) => @<div class="selected-equipment">
        <div class="selected-equipment-heading"><strong>已選設備（@ids.Count）</strong><span>本次預約只使用這一台設備</span></div>
        @if (ids.Count == 0) { <div class="selected-empty">尚未選擇設備，請從上方搜尋結果加入設備。</div> }
        else
        {
            <div class="selected-equipment-grid">
                @foreach (var item in _equipment.Where(x => ids.Contains(x.Id)))
                {
                    <article class="selected-equipment-card">
                        <div><strong>@item.Name</strong><span>@ReservationUi.Display(item.ProductsId) · @ReservationUi.Display(item.Kind)</span></div>
                        <div>@ReservationUi.Display(item.Brand) / @ReservationUi.Display(item.Model) · @ReservationUi.Display(item.Place)</div>
                        <div>保管人：@ReservationUi.Display(item.Custodian)　保管代理人：@ReservationUi.Display(item.Agent)</div>
                        @if (!string.IsNullOrWhiteSpace(item.Note)) { <div>設備備註：@item.Note</div> }
                        <div class="selected-equipment-actions"><button type="button" class="btn-secondary" disabled="@_saving" @onclick="() => OpenCalendar(item)">查看預約</button>@if (removable) { <button type="button" class="btn-secondary" disabled="@_saving" @onclick="() => ToggleDirect(item.Id)">移除</button> }</div>
                    </article>
                }
            </div>
        }
    </div>;
    private bool CalendarEquipmentSelected => _calendarEquipment is not null && _directSelectedIds.Contains(_calendarEquipment.Id);
    private void OpenCalendar(ApparatusListItemDto item) { _calendarEnvironmentGroup = null; _calendarEquipment = item; }
    private void OpenEnvironmentCalendar(ReservationEnvironmentGroupDto group) { _calendarEquipment = null; _calendarEnvironmentGroup = group; }
    private void CloseCalendar() { _calendarEquipment = null; _calendarEnvironmentGroup = null; }
    private void SelectCalendarEquipment()
    {
        if (_calendarEquipment is null) return;
        if (_mode == ReservationMode.Direct && _calendarEquipment.IsDirectReservationLocked && !_directSelectedIds.Contains(_calendarEquipment.Id)) return;
        if (_mode == ReservationMode.Direct) { if (!_directSelectedIds.Contains(_calendarEquipment.Id)) ToggleDirect(_calendarEquipment.Id); }
        CloseCalendar();
    }
    private static string DurationText(TimeSpan duration) => $"{(int)duration.TotalDays} 天 {duration.Hours} 小時";
    private static string CompletenessName(EquipmentGroupCompletenessStatus status) => status switch
    {
        EquipmentGroupCompletenessStatus.Complete => "設備齊全",
        EquipmentGroupCompletenessStatus.Incomplete => "設備不齊全",
        _ => "尚未配置"
    };
    private static string CompletenessClass(EquipmentGroupCompletenessStatus status) => status switch
    {
        EquipmentGroupCompletenessStatus.Complete => "complete",
        EquipmentGroupCompletenessStatus.Incomplete => "incomplete",
        _ => "unconfigured"
    };
    private void ViewSaved() => Nav.NavigateTo($"{BasePath}/{_savedId}");
    private void Back() => Nav.NavigateTo(_isEdit && Id.HasValue ? $"{BasePath}/{Id}" : BasePath);
}

