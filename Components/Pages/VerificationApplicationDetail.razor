@page "/verification-applications/{Id:guid}"
@layout ApplicantLayout
@rendermode InteractiveServer
@attribute [Authorize(Policy = SystemAuthorization.Policies.ReservationUser)]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using SIT.DepartmentSystem.Web.Entities
@inject IVerificationApplicationService Applications
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Nav

@if (!string.IsNullOrWhiteSpace(_message)) { <div class="surface-card error-text">@_message</div> }
@if (_loading) { <div class="surface-card">載入中...</div> }
else if (_item is not null)
{
    <div class="surface-card">
        @if (_item.ValidationRequest is not null)
        {
            <ValidationRequestSubmissionView Submission="_item.ValidationRequest" ApplicationId="Id" />
        }

        @if (_item.Status == VerificationApplicationStatus.Returned)
        { <div class="workflow-note"><strong>退回原因：</strong>@Display(_item.ProcessingNote)</div> }
        else if (_item.Status == VerificationApplicationStatus.Rejected)
        { <div class="workflow-note"><strong>拒絕原因：</strong>@Display(_item.ProcessingNote)</div> }
        else if (_item.Status == VerificationApplicationStatus.Submitted)
        { <div class="workflow-note">等待 Team Leader 審核</div> }
        else if (_item.Status == VerificationApplicationStatus.Accepted)
        { <div class="workflow-note">此申請已接受並建立 CSIT Project。</div> }

        <div class="form-actions verification-detail-actions">
            @if (_item.Status is VerificationApplicationStatus.Draft or VerificationApplicationStatus.Returned)
            {
                @if (_directApproval)
                {
                    <div class="form-row full-width direct-approval-date">
                        <label>預計結束日期（主管自行送單直接核准必填）</label>
                        <DatePickerInput @bind-Value="_expectedEndDate" PickerLabel="選擇預計結束日期" />
                    </div>
                }
                <button type="button" class="btn-secondary" @onclick="Edit">修改</button>
                <button type="button" class="btn-primary" disabled="@_working" @onclick="SubmitAsync">送出申請</button>
            }
            <button type="button" class="btn-secondary" @onclick="Back">返回清單</button>
        </div>
    </div>
}

<style>
    .workflow-note { margin-top:20px; padding:14px; border-radius:10px; background:rgba(14,165,164,.12); }
    .direct-approval-date { width:100%; margin-bottom:12px; }
    .verification-detail-actions { display:flex; flex-wrap:wrap; align-items:center; gap:12px; }
    .verification-detail-actions button { width:auto; min-width:max-content; padding:12px 18px; white-space:nowrap; writing-mode:horizontal-tb; }
</style>

@code {
    [Parameter] public Guid Id { get; set; }
    private VerificationApplicationDto? _item;
    private bool _loading = true;
    private bool _working;
    private string? _message;
    private bool _directApproval;
    private DateOnly? _expectedEndDate;

    protected override async Task OnParametersSetAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        _loading = true; _message = null;
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            _directApproval = await Applications.IsDirectApprovalApplicantAsync(user);
            _item = await Applications.GetForApplicantAsync(Id, user);
            if (_item is null) _message = "找不到申請，或您無權存取。";
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _loading = false; }
    }

    private async Task SubmitAsync()
    {
        _working = true; _message = null;
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            _item = await Applications.SubmitAsync(Id, user, _expectedEndDate);
        }
        catch (VerificationApplicationValidationException ex)
        {
            var issue = ex.Issues[0];
            var target = $"/validation-requests/{Id}?validationArea={Uri.EscapeDataString(issue.AreaCode)}" +
                         $"&validationAreaLabel={Uri.EscapeDataString(issue.AreaLabel)}" +
                         $"&validationMessage={Uri.EscapeDataString(ex.Message)}";
            if (!string.IsNullOrWhiteSpace(issue.FieldCode))
                target += $"&validationField={Uri.EscapeDataString(issue.FieldCode)}";
            Nav.NavigateTo(target);
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _working = false; }
    }

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private void Edit() => Nav.NavigateTo(_item?.ValidationRequest is null ? $"/verification-applications/{Id}/edit" : $"/validation-requests/{Id}");
    private void Back() => Nav.NavigateTo("/verification-applications");
    private static string FormatDate(DateTime? value) => value?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—";
    private static string StatusText(VerificationApplicationStatus status) => status switch
    {
        VerificationApplicationStatus.Draft => "草稿", VerificationApplicationStatus.Submitted => "待審核",
        VerificationApplicationStatus.Returned => "已退回", VerificationApplicationStatus.Rejected => "已拒絕",
        VerificationApplicationStatus.Accepted => "已接受", _ => status.ToString()
    };
}
