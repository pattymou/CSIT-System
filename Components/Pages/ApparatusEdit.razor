@page "/apparatus/new"
@page "/apparatus/{Id}/edit"
@page "/assets/{ModuleCode}/new"
@page "/assets/{ModuleCode}/{Id}/edit"
@attribute [Authorize(Policy = SystemAuthorization.Policies.CsitStaff)]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Components.Forms
@using global::System.Text.Json
@using SIT.DepartmentSystem.Web.Models.Api
@using SIT.DepartmentSystem.Web.Services.Interfaces
@inject BrowserApiClient Api
@inject NavigationManager Nav
@inject IMenuManagementService MenuService
@inject IJSRuntime JS
@inject SIT.DepartmentSystem.Web.Services.Approval.ApprovalContextUploads ContextUploads
@inject AuthenticationStateProvider AuthProvider

<h3>@PageTitle</h3>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="form-card error-text">@_message</div>
}

@if (_loading)
{
    <div class="form-card">載入中...</div>
}

<div hidden="@_loading">
<div class="form-card">
    <div class="case-card-head">
        <div>
            <div class="case-kicker">@PageKicker</div>
            <h3>基本資料</h3>
        </div>
        <div class="case-no-badge">ID：@_form.Id</div>
    </div>

    @if (IsEquipment)
    {
        <div class="form-grid equipment-primary-grid">
            <div class="form-row"><label>財產編號</label><input @bind="_form.ProductsId" /></div>
            <div class="form-row"><label>設備分類 *</label><select @bind="_form.Kind"><option value="">請選擇設備分類</option>@foreach (var option in _apparatusKindOptions) { <option value="@option.Value">@option.Name</option> }</select></div>
            <div class="form-row"><label>設備名稱 *</label><input @bind="_form.Name" /></div>
            <div class="form-row full-width equipment-brand-group">
                <label>廠牌</label>
                <select required="@(!_isEdit)" value="@VendorSelectionValue" @onchange="OnVendorChanged">
                    @if (_isEdit && !_form.VendorId.HasValue && !string.IsNullOrWhiteSpace(_form.Brand))
                    {
                        <option value="">原始廠牌：@_form.Brand（尚未連結）</option>
                    }
                    else if (!_isEdit)
                    {
                        <option value="">請選擇啟用中的廠商</option>
                    }
                    else if (!_form.VendorId.HasValue)
                    {
                        <option value="">尚未連結廠商主檔</option>
                    }
                    @foreach (var vendor in _vendorOptions)
                    {
                        <option value="@vendor.Id">@vendor.Name@(!vendor.IsActive ? "（已停用，僅保留歷史關聯）" : "")</option>
                    }
                </select>
                <small>選擇廠商主檔即可；舊設備未連結時會保留原始廠牌，不會自動猜測配對。</small>
            </div>
            <div class="form-row"><label>型號</label><input @bind="_form.Model" /></div>
            <div class="form-row"><label>序號</label><input @bind="_form.Number" /></div>
            <div class="form-row"><label>設備位置</label><input @bind="_form.Place" /></div>
            <div class="form-row"><label>保管人 *</label><select required @bind="_form.CustodianAccount" @bind:after="OnCustodianChanged"><option value="">請選擇保管人</option>@foreach (var user in AllowedCustodians) { <option value="@user.Account">@user.DisplayName</option> }</select></div>
            <div class="form-row"><label>設備狀態</label><select @bind="_form.ReservationStatus"><option>可借用</option><option>校驗中</option><option>異常維修中</option><option>不可借用</option><option>採購中</option></select></div>
        </div>

        @if (ShowOwnershipCorrection)
        {
        <details class="equipment-details equipment-ownership-correction" open>
            <summary>歸屬資料需要確認</summary>
            <p class="equipment-warning">@_ownershipMessage</p>
            <div class="form-grid">
                <div class="form-row"><label>部門 *</label><select required @bind="_form.DepartmentOptionId" @bind:after="OnDepartmentChanged"><option value="">請選擇部門</option>@foreach (var department in _ownershipOptions.Departments) { <option value="@department.Id">@DepartmentTeamRules.DisplayName(department.Name, department.Value)</option> }</select></div>
                <div class="form-row"><label>設備所屬 Team *</label><select required @bind="_form.OwnerTeamOptionId" @bind:after="OnOwnerTeamChanged"><option value="">請選擇設備所屬 Team</option>@foreach (var team in AllowedOwnerTeams) { <option value="@team.Id">@DepartmentTeamRules.DisplayName(team.Name, team.Value)</option> }</select></div>
            </div>
            @if (RequiresOwnershipChangeConfirmation)
            {
                <label class="equipment-ownership-confirm"><input type="checkbox" @bind="_form.ConfirmOwnershipChange" /> 我已確認此次保管人歸屬變更及 Team 轉移</label>
            }
        </details>
        }
        else
        {
            <div class="equipment-ownership-auto">@OwnershipAutoText</div>
        }

        <details class="equipment-details">
            <summary>其他資料</summary>
            <div class="form-grid">
                <div class="form-row"><label>設備名稱（英文）</label><input @bind="_form.NameEn" /></div>
                <div class="form-row"><label>料號</label><input @bind="_form.PartNo" /></div>
                <div class="form-row"><label>廠商貨品編號</label><input @bind="_form.ManufacturerNumber" /></div>
                <div class="form-row"><label>對應採購</label><input @bind="_form.ProcurementStaff" /></div>
                <div class="form-row"><label>IMEI</label><input @bind="_form.Imei" /></div>
                <div class="form-row"><label>OS</label><select @bind="_form.Os"><option value="">請選擇 OS</option><option>IOS</option><option>Android</option></select></div>
                <div class="form-row"><label>OS Ver.</label><input @bind="_form.OsVersion" /></div>
                <div class="form-row"><label>檢查日期</label><input type="date" @bind="_form.InspectionDate" /></div>
                <div class="form-row"><label>保養日期</label><input type="date" @bind="_form.MaintenanceDate" /></div>
                <div class="form-row"><label>取得成本</label><input @bind="_form.CostPrice" /></div>
                <div class="form-row"><label>使用年限</label><input @bind="_form.YearsUse" /></div>
                <div class="form-row"><label>使用天數</label><input @bind="_form.DaysUse" /></div>
                <div class="form-row"><label>使用價格</label><input @bind="_form.PriceUse" /></div>
                <div class="form-row"><label>保管代理人</label><input @bind="_form.Agent" /></div>
                <div class="form-row full-width"><label>Feature</label><textarea class="text-area" rows="5" @bind="_form.Feature"></textarea></div>
                <div class="form-row full-width"><label>Specification</label><textarea class="text-area" rows="5" @bind="_form.Spec"></textarea></div>
                <div class="form-row full-width"><label>備註</label><textarea class="text-area" rows="5" @bind="_form.Note"></textarea></div>
            </div>
        </details>
    }
    else
    {
    <div class="form-grid">
        <div class="form-row">
            <label>財產編號</label>
            <input @bind="_form.ProductsId" />
        </div>

        <div class="form-row">
            <label>名稱(中文) *</label>
            <input @bind="_form.Name" />
        </div>

        <div class="form-row">
            <label>名稱(英文)</label>
            <input @bind="_form.NameEn" />
        </div>

        <div class="form-row">
            <label>類別 *</label>
            <select @bind="_form.Kind">
                <option value="">請選擇類別</option>
                @foreach (var option in _apparatusKindOptions)
                {
                    <option value="@option.Value">@option.Name</option>
                }
            </select>
        </div>

        <div class="form-row">
            <label>料號</label>
            <input @bind="_form.PartNo" />
        </div>

        @if (IsEquipment)
        {
            <div class="form-row">
                <label>廠商 *</label>
                <select required @bind="_form.VendorId">
                    <option value="">請選擇啟用中的廠商</option>
                    @foreach (var vendor in _vendorOptions)
                    {
                        <option value="@vendor.Id">@vendor.Name@(!vendor.IsActive ? "（已停用，僅保留歷史關聯）" : "")</option>
                    }
                </select>
            </div>
            @if (_isEdit && !_form.VendorId.HasValue && !string.IsNullOrWhiteSpace(_form.Manufacturer))
            {
                <div class="form-row">
                    <label>舊廠商文字（尚未連結）</label>
                    <input value="@_form.Manufacturer" readonly />
                </div>
            }
        }
        else
        {
            <div class="form-row">
                <label>廠商(中/英文)</label>
                <input @bind="_form.Manufacturer" />
            </div>
        }

        <div class="form-row">
            <label>廠商貨品編號</label>
            <input @bind="_form.ManufacturerNumber" />
        </div>

        <div class="form-row">
            <label>廠牌</label>
            <input @bind="_form.Brand" />
        </div>

        <div class="form-row">
            <label>型號</label>
            <input @bind="_form.Model" />
        </div>

        <div class="form-row">
            <label>序號</label>
            <input @bind="_form.Number" />
        </div>

        <div class="form-row">
            <label>對應採購</label>
            <input @bind="_form.ProcurementStaff" />
        </div>

        <div class="form-row">
            <label>IMEI</label>
            <input @bind="_form.Imei" />
        </div>

        <div class="form-row">
            <label>OS</label>
            <select @bind="_form.Os">
                <option value="">請選擇 OS</option>
                <option>IOS</option>
                <option>Android</option>
            </select>
        </div>

        <div class="form-row">
            <label>OS Ver.</label>
            <input @bind="_form.OsVersion" />
        </div>

        <div class="form-row">
            <label>檢查日期</label>
            <input type="date" @bind="_form.InspectionDate" />
        </div>

        <div class="form-row">
            <label>保養日期</label>
            <input type="date" @bind="_form.MaintenanceDate" />
        </div>

        <div class="form-row">
            <label>放置地點</label>
            <input @bind="_form.Place" />
        </div>

        <div class="form-row">
            <label>取得成本</label>
            <input @bind="_form.CostPrice" />
        </div>

        <div class="form-row">
            <label>使用年限</label>
            <input @bind="_form.YearsUse" />
        </div>

        <div class="form-row">
            <label>使用天數</label>
            <input @bind="_form.DaysUse" />
        </div>

        <div class="form-row">
            <label>使用價格</label>
            <input @bind="_form.PriceUse" />
        </div>

        <div class="form-row">
            <label>部門 *</label>
            <select required @bind="_form.DepartmentOptionId" @bind:after="OnDepartmentChanged">
                <option value="">請選擇部門</option>
                @foreach (var department in _ownershipOptions.Departments)
                {
                    <option value="@department.Id">@DepartmentTeamRules.DisplayName(department.Name, department.Value)</option>
                }
            </select>
        </div>
        <div class="form-row">
            <label>設備所屬 Team *</label>
            <select required @bind="_form.OwnerTeamOptionId" @bind:after="OnOwnerTeamChanged">
                <option value="">請選擇設備所屬 Team</option>
                @foreach (var team in AllowedOwnerTeams)
                {
                    <option value="@team.Id">@DepartmentTeamRules.DisplayName(team.Name, team.Value)</option>
                }
            </select>
        </div>

        <div class="form-row">
            <label>保管人 *</label>
            <select required @bind="_form.CustodianAccount">
                <option value="">請選擇保管人</option>
                @foreach (var user in AllowedCustodians)
                {
                    <option value="@user.Account">@user.DisplayName</option>
                }
            </select>
        </div>

        <div class="form-row">
            <label>保管代理人</label>
            <input @bind="_form.Agent" />
        </div>

        <div class="form-row">
            <label>狀態</label>
            <select @bind="_form.ReservationStatus">
                <option>可借用</option>
                <option>校驗中</option>
                <option>異常維修中</option>
                <option>不可借用</option>
                <option>採購中</option>
            </select>
        </div>

        <div class="form-row full-width">
            <label>Feature</label>
            <textarea class="text-area" rows="5" @bind="_form.Feature"></textarea>
        </div>

        <div class="form-row full-width">
            <label>Specification</label>
            <textarea class="text-area" rows="5" @bind="_form.Spec"></textarea>
        </div>

        <div class="form-row full-width">
            <label>備註</label>
            <textarea class="text-area" rows="5" @bind="_form.Note"></textarea>
        </div>
    </div>
    }
</div>

@if (IsEquipment && _isEdit)
{
    <div class="form-card environment-membership-card">
        <div class="case-card-head">
            <div>
                <div class="case-kicker">TEST ENVIRONMENT</div>
                <h3>測試環境</h3>
            </div>
        </div>
        @if (_environmentAssignment is null)
        {
            <div class="record-empty-box"><strong>未加入測試環境群組</strong></div>
        }
        else
        {
            <div class="environment-membership-grid">
                <div><span>測試環境</span><strong>@_environmentAssignment.EquipmentGroupName</strong><small>@_environmentAssignment.EquipmentGroupCode</small></div>
                <div><span>管理 Team</span><strong>@_environmentAssignment.OwnerTeamName</strong></div>
                <div><span>環境狀態</span><strong class="@(_environmentAssignment.IsInEnvironment ? "present" : "away")">@(_environmentAssignment.IsInEnvironment ? "在測試環境" : "已移出測試環境")</strong></div>
            </div>
            @if (!string.IsNullOrWhiteSpace(_environmentAssignment.Warning))
            {
                <div class="environment-warning">⚠ @_environmentAssignment.Warning</div>
            }
            @if (_environmentAssignment.CanUpdatePresence)
            {
                <div class="form-actions environment-actions">
                    <button type="button" class="btn-secondary" disabled="@_savingEnvironmentPresence" @onclick="ToggleEnvironmentPresenceAsync">
                        @(_savingEnvironmentPresence ? "處理中..." : _environmentAssignment.IsInEnvironment ? "移出測試環境" : "放回測試環境")
                    </button>
                </div>
            }
        }
    </div>
}

@if (IsEquipment)
{
    <div class="form-card">
        <div class="case-card-head">
            <div>
                <div class="case-kicker">RESERVATION RESOURCE</div>
                <h3>預約資源能力</h3>
            </div>
            @if (_isEdit && _resourceCatalog.Count > 0)
            {
                <button type="button" class="primary-btn" @onclick="AddResourceCapability">新增能力</button>
            }
        </div>

        @if (!_isEdit)
        {
            <div class="record-empty-box">
                <strong>請先建立設備</strong>
                <span>建立完成後即可設定預約資源能力。</span>
            </div>
        }
        else if (_resourceCatalog.Count == 0)
        {
            <div class="record-empty-box">
                <strong>目前尚未建立設備組合需求</strong>
                <span>請先至「測試環境設定」建立設備組合與需求。</span>
                <button type="button" class="btn-secondary" @onclick="OpenTestEnvironmentSettings">前往測試環境設定</button>
            </div>
        }
        else
        {
            @if (_resourceMappings.Count == 0)
            {
                <p class="empty-text">目前尚未設定預約資源能力。</p>
            }
            @for (var i = 0; i < _resourceMappings.Count; i++)
            {
                var index = i;
                var mapping = _resourceMappings[index];
                <div class="form-grid resource-capability-row">
                    <div class="form-row">
                        <label>ResourceType</label>
                        <select value="@mapping.ResourceType" @onchange="e => OnResourceTypeChanged(index, e)">
                            <option value="">請選擇</option>
                            @foreach (var type in ResourceTypes)
                            {
                                <option value="@type">@type</option>
                            }
                        </select>
                    </div>
                    <div class="form-row">
                        <label>CapabilityTag</label>
                        <select @bind="mapping.CapabilityTag">
                            <option value="">無（僅 ResourceType）</option>
                            @foreach (var tag in CapabilityTags(mapping.ResourceType))
                            {
                                <option value="@tag">@tag</option>
                            }
                        </select>
                    </div>
                    <div class="form-row resource-remove">
                        <label>操作</label>
                        <button type="button" class="table-chip-btn danger" @onclick="() => RemoveResourceCapability(index)">刪除能力</button>
                    </div>
                </div>
            }
            <div class="form-actions">
                <button type="button" class="primary-btn" disabled="@_savingResourceCapabilities" @onclick="SaveResourceCapabilitiesAsync">
                    @(_savingResourceCapabilities ? "儲存中..." : "儲存能力")
                </button>
            </div>
        }
    </div>
}

<div id="apparatus-file-upload" class="form-card">
    <div class="case-card-head">
        <div>
            <div class="case-kicker">FILE UPLOAD</div>
            <h3>@PageFileTitle</h3>
        </div>

        @if (IsPersisted)
        {
            <button class="primary-btn"
                    @onclick="UploadFilesAsync"
                    disabled="@(_selectedFiles.Count == 0 || _uploading)">
                @(_uploading ? "提交中..." : "提交所選附件")
            </button>
        }
    </div>

    <div class="upload-box" @ref="_fileInputContainer">
        <InputFile OnChange="OnFilesSelected" multiple />
        <span class="empty-text">已選擇 @_selectedFiles.Count 個檔案。新增設備時會與基本資料由同一個「確定」動作提交。</span>
        @if (IsEquipment && string.IsNullOrWhiteSpace(_form.ProductsId))
        { <span class="equipment-warning">缺少財產編號時不能正式歸檔；系統不會以序號或假值取代既定 NAS 命名。</span> }
    </div>

    @if (_selectedFiles.Count > 0)
    {
        <div class="upload-list">
            @foreach (var f in _selectedFiles)
            {
                <div class="upload-file-item">
                    <span>@f.FileName</span>
                    <strong>@FormatSize(f.Size)</strong>
                </div>
            }
        </div>
    }

    @if (IsEquipment)
    {
        <SIT.DepartmentSystem.Web.Components.Shared.EquipmentFileTable Files="_files"
            CanManageMetadata="true" OnDelete="DeleteFileAsync" OnChanged="LoadFilesAsync" />
    }
    else if (_files.Count > 0)
    {
        <div class="upload-list">
            @foreach (var file in _files)
            {
                <div class="upload-file-item">
                    @if (file.IsImage)
                    {
                        <img class="apparatus-file-thumbnail" src="@file.ImageUrl" alt="@file.FileName" />
                    }
                    <div>
                        <a href="@file.DownloadUrl" target="_blank" rel="noopener">@file.FileName</a>
                        <small>@FormatSize(file.FileSize) · @ArchiveStatusText(file.ArchiveStatus)</small>
                        @if (!string.IsNullOrWhiteSpace(file.Sha256))
                        {
                            <small>SHA256：@file.Sha256</small>
                        }
                    </div>
                    <button type="button" class="table-chip-btn danger" @onclick="() => DeleteFileAsync(file.Id)">
                        刪除
                    </button>
                </div>
            }
        </div>
    }
    <SIT.DepartmentSystem.Web.Components.Shared.OwnApprovalUploadList Items="_ownUploads" />
</div>

<div class="form-actions">
    <button class="primary-btn" @onclick="SaveAsync" disabled="@_saving">
        @(_saving ? "儲存中..." : "確定")
    </button>

    <button class="btn-secondary" @onclick="Back">
        回上一頁
    </button>
</div>
</div>

@code {
    [Parameter] public string? ModuleCode { get; set; }
    [Parameter] public string? Id { get; set; }

    private string EffectiveModuleCode => string.IsNullOrWhiteSpace(ModuleCode) ? "equipment" : ModuleCode.Trim();

    private string AssetTitle { get; set; } = "資產管理";
    private string PageTitle => _isEdit ? $"修改{AssetDisplayName}" : $"新增{AssetDisplayName}";
    private string PageKicker => $"ASSET / {EffectiveModuleCode.ToUpperInvariant()}";
    private string PageFileTitle => $"{AssetDisplayName}檔案";
    private string AssetDisplayName => GetAssetDisplayName();
    private bool IsEquipment => string.Equals(EffectiveModuleCode, "equipment", StringComparison.OrdinalIgnoreCase);

    private bool _isEdit => !string.IsNullOrWhiteSpace(Id);
    private bool _saving;
    private bool _uploading;
    private string? _message;
    private ElementReference _fileInputContainer;
    private bool _reloadRequested;
    private bool _focusFilesAfterLoad;
    private bool _filesFocusCompleted;
    private bool _loading = true;
    private bool _savingResourceCapabilities;
    private bool _savingEnvironmentPresence;
    private string? _createdAssetId;
    private ApparatusEnvironmentAssignmentDto? _environmentAssignment;
    private List<ResourceMatchingCatalogValueDto> _resourceCatalog = new();
    private List<ApparatusResourceCapabilityInput> _resourceMappings = new();
    private IEnumerable<string> ResourceTypes => _resourceCatalog.Select(x => x.ResourceType).Distinct(StringComparer.Ordinal).OrderBy(x => x);

    private ApparatusUpsertRequest _form = new()
    {
        ReservationStatus = "可借用"
    };

    private List<SelectedUploadFile> _selectedFiles = new();
    private List<ApparatusFileDto> _files = new();
    private IReadOnlyList<SIT.DepartmentSystem.Web.Services.Approval.OwnApprovalUploadDto> _ownUploads = [];

    private List<SystemOptionDto> _apparatusKindOptions = new();
    private List<VendorOptionDto> _vendorOptions = new();
    private ApparatusOwnershipOptionsDto _ownershipOptions = new();
    private string? _originalCustodianAccount;
    private Guid? _originalDepartmentOptionId;
    private Guid? _originalOwnerTeamOptionId;
    private bool _ownershipNeedsAttention;
    private string _ownershipMessage = string.Empty;
    private bool IsPersisted => _isEdit || !string.IsNullOrWhiteSpace(_createdAssetId);
    private string? CurrentAssetId => _createdAssetId ?? _form.Id;
    private string VendorSelectionValue => _form.VendorId?.ToString() ?? string.Empty;
    private IReadOnlyList<ApparatusOwnerTeamOptionDto> AllowedOwnerTeams => !_form.DepartmentOptionId.HasValue ? []
        : DepartmentTeamRules.GetAllowedTeamsForDepartment(
            _ownershipOptions.Departments.FirstOrDefault(x => x.Id == _form.DepartmentOptionId)?.Value,
            _ownershipOptions.Teams, team => team.Name, team => team.Value);
    private IReadOnlyList<ApparatusCustodianOptionDto> AllowedCustodians =>
        IsEquipment
            ? _ownershipOptions.Users
            : !_form.DepartmentOptionId.HasValue || !_form.OwnerTeamOptionId.HasValue
            ? []
            : GetAllowedCustodians();
    private bool RequiresOwnershipChangeConfirmation => IsEquipment && _isEdit &&
        (_form.DepartmentOptionId != _originalDepartmentOptionId ||
         _form.OwnerTeamOptionId != _originalOwnerTeamOptionId);
    private bool ShowOwnershipCorrection => IsEquipment &&
        (_ownershipNeedsAttention || RequiresOwnershipChangeConfirmation);
    private string OwnershipAutoText => string.IsNullOrWhiteSpace(_form.CustodianAccount)
        ? "選擇保管人後，系統會依 Shared Identity 正式資料自動帶入部門與 Team。"
        : "部門與設備所屬 Team 已依保管人的 Shared Identity 正式資料驗證。";

    protected override void OnParametersSet()
    {
        _reloadRequested = true;
        _loading = true;
        _message = null;
        _focusFilesAfterLoad = _isEdit &&
            string.Equals(Focus, "files", StringComparison.OrdinalIgnoreCase);
        _filesFocusCompleted = false;
    }

    [SupplyParameterFromQuery(Name = "focus")]
    public string? Focus { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_reloadRequested)
        {
            _reloadRequested = false;

            try
            {
                await InitializeAsync();
            }
            catch (Exception ex)
            {
                _message = $"載入資料失敗：{ex.Message}";
            }
            finally
            {
                _loading = false;
                StateHasChanged();
            }

            return;
        }

        if (_focusFilesAfterLoad && !_filesFocusCompleted && _isEdit && !_loading)
        {
            _filesFocusCompleted = true;
            await JS.InvokeVoidAsync("csitScrollIntoView", "apparatus-file-upload");
        }
    }

    private async Task InitializeAsync()
    {
        _message = null;
        _form = new ApparatusUpsertRequest { ReservationStatus = "可借用" };
        _selectedFiles = new();
        _files = new();
        _ownUploads = [];
        _apparatusKindOptions = new();
        _ownershipOptions = new();
        _resourceCatalog = new();
        _resourceMappings = new();
        _environmentAssignment = null;
        _createdAssetId = null;
        _vendorOptions = new();
        _originalCustodianAccount = null;
        _originalDepartmentOptionId = null;
        _originalOwnerTeamOptionId = null;
        _ownershipNeedsAttention = false;
        _ownershipMessage = string.Empty;

        await LoadPageMetaAsync();
        await LoadOptionsAsync();

        if (_isEdit)
        {
            Console.WriteLine($"[ApparatusEdit] Edit load start. moduleCode={EffectiveModuleCode}, id={Id}");

            var detail = await Api.GetAsync<ApparatusDetailDto>(
                $"/api/assets/{Uri.EscapeDataString(EffectiveModuleCode)}/{Id}");

            if (detail != null)
            {
                _form = new ApparatusUpsertRequest
                {
                    Id = detail.Id,
                    RowVersion = detail.RowVersion,
                    ProductsId = detail.ProductsId,
                    Name = detail.Name,
                    NameEn = detail.NameEn,
                    Kind = detail.Kind,
                    PartNo = detail.PartNo,
                    Manufacturer = detail.Manufacturer,
                    ManufacturerNumber = detail.ManufacturerNumber,
                    VendorId = detail.VendorId,
                    Brand = detail.Brand,
                    Model = detail.Model,
                    Number = detail.Number,
                    ProcurementStaff = detail.ProcurementStaff,
                    Imei = detail.Imei,
                    Os = detail.Os,
                    OsVersion = detail.OsVersion,
                    InspectionDate = detail.InspectionDate,
                    MaintenanceDate = detail.MaintenanceDate,
                    Place = detail.Place,
                    CostPrice = detail.CostPrice,
                    YearsUse = detail.YearsUse,
                    DaysUse = detail.DaysUse,
                    PriceUse = detail.PriceUse,
                    CustodianAccount = detail.CustodianAccount,
                    DepartmentOptionId = detail.DepartmentOptionId,
                    OwnerTeamOptionId = detail.OwnerTeamOptionId,
                    Agent = detail.Agent,
                    ReservationStatus = string.IsNullOrWhiteSpace(detail.ReservationStatus) ? "可借用" : detail.ReservationStatus,
                    Feature = detail.Feature,
                    Spec = detail.Spec,
                    Note = detail.Note
                };

                _files = detail.Files ?? new();
                await LoadFilesAsync();
                if (IsEquipment) await LoadVendorOptionsAsync(detail.VendorId);

                _originalCustodianAccount = _form.CustodianAccount;
                _originalDepartmentOptionId = _form.DepartmentOptionId;
                _originalOwnerTeamOptionId = _form.OwnerTeamOptionId;
                if (IsEquipment) EvaluateExistingOwnership();
                else OnDepartmentChanged();

                if (IsEquipment)
                {
                    await LoadResourceCapabilitiesAsync();
                    await LoadEnvironmentAssignmentAsync();
                }

                EnsureCurrentOption(_apparatusKindOptions, _form.Kind);
                Console.WriteLine($"[ApparatusEdit] Edit load done. id={_form.Id}, kind={_form.Kind}");
            }

            return;
        }

        var newId = await Api.GetAsync<NewApparatusIdResponse>(
            $"/api/assets/{Uri.EscapeDataString(EffectiveModuleCode)}/new-id");

        _form.Id = newId?.Id ?? "";
        _form.ReservationStatus = string.IsNullOrWhiteSpace(_form.ReservationStatus) ? "可借用" : _form.ReservationStatus;
        if (IsEquipment) await LoadVendorOptionsAsync();

        Console.WriteLine($"[ApparatusEdit] New asset id loaded. moduleCode={EffectiveModuleCode}, id={_form.Id}");
    }

    private async Task LoadPageMetaAsync()
    {
        try
        {
            var sections = await MenuService.GetSectionsAsync();

            var departmentSection = sections.FirstOrDefault(x =>
                string.Equals(x.Code, "department", StringComparison.OrdinalIgnoreCase));

            if (departmentSection == null)
            {
                AssetTitle = GetFallbackAssetTitle();
                return;
            }

            var items = await MenuService.GetItemsBySectionAsync(departmentSection.Id);

            var menu = items.FirstOrDefault(x =>
                string.Equals(x.TemplateType, "Asset", StringComparison.OrdinalIgnoreCase) &&
                string.Equals(x.ModuleCode, EffectiveModuleCode, StringComparison.OrdinalIgnoreCase));

            AssetTitle = string.IsNullOrWhiteSpace(menu?.Title)
                ? GetFallbackAssetTitle()
                : menu.Title.Trim();

            Console.WriteLine($"[ApparatusEdit] Load page meta done. moduleCode={EffectiveModuleCode}, title={AssetTitle}");
        }
        catch (Exception ex)
        {
            AssetTitle = GetFallbackAssetTitle();
            Console.WriteLine($"[ApparatusEdit] LoadPageMeta exception: {ex}");
        }
    }

    private string GetFallbackAssetTitle()
    {
        return string.Equals(EffectiveModuleCode, "equipment", StringComparison.OrdinalIgnoreCase)
            ? "設備管理"
            : $"資產管理 - {EffectiveModuleCode}";
    }

    private string GetAssetDisplayName()
    {
        var title = AssetTitle;

        if (title.EndsWith("管理", StringComparison.OrdinalIgnoreCase))
        {
            title = title[..^2];
        }

        return string.IsNullOrWhiteSpace(title) ? "資產" : title;
    }

    private async Task SaveAsync()
    {
        _message = null;

        if (string.IsNullOrWhiteSpace(_form.Name))
        {
            _message = "名稱不可空白。";
            Console.WriteLine("[ApparatusEdit] Save blocked. Name is empty.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_form.Kind))
        {
            _message = "類別不可空白。";
            Console.WriteLine("[ApparatusEdit] Save blocked. Kind is empty.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_form.CustodianAccount))
        {
            _message = "請選擇保管人。";
            return;
        }

        if (!_form.DepartmentOptionId.HasValue)
        {
            _message = "請選擇部門。";
            return;
        }

        if (!_form.OwnerTeamOptionId.HasValue)
        {
            _message = "請選擇設備所屬 Team。";
            return;
        }

        if (IsEquipment && _ownershipNeedsAttention)
        {
            _message = string.IsNullOrWhiteSpace(_ownershipMessage)
                ? "保管人的部門與 Team 歸屬尚未完成驗證。"
                : _ownershipMessage;
            return;
        }

        if (RequiresOwnershipChangeConfirmation && !_form.ConfirmOwnershipChange)
        {
            _message = "保管人歸屬跨部門或 Team 變更，請確認歸屬變更後再儲存。";
            return;
        }

        if (IsEquipment && !_isEdit && !IsPersisted && !_form.VendorId.HasValue)
        {
            _message = "新增設備必須選擇啟用中的廠商。";
            return;
        }

        _saving = true;

        try
        {
            BrowserApiResponse response;

            if (IsPersisted)
            {
                Console.WriteLine($"[ApparatusEdit] Update start. moduleCode={EffectiveModuleCode}, id={CurrentAssetId}, name={_form.Name}, kind={_form.Kind}");
                response = await Api.PutJsonAsync($"/api/assets/{Uri.EscapeDataString(EffectiveModuleCode)}/{Uri.EscapeDataString(CurrentAssetId!)}", _form);
            }
            else
            {
                Console.WriteLine($"[ApparatusEdit] Create start. moduleCode={EffectiveModuleCode}, id={_form.Id}, name={_form.Name}, kind={_form.Kind}");
                response = await Api.PostJsonAsync($"/api/assets/{Uri.EscapeDataString(EffectiveModuleCode)}", _form);
            }

            var body = response.Body;

            if (response.IsSuccessStatusCode)
            {
                Console.WriteLine($"[ApparatusEdit] Save success. status={response.StatusCode}, body={body}");
                if (!IsPersisted)
                {
                    var createdId = _form.Id ?? string.Empty;
                    try
                    {
                        var created = JsonSerializer.Deserialize<NewApparatusIdResponse>(
                            body, new JsonSerializerOptions(JsonSerializerDefaults.Web));
                        if (!string.IsNullOrWhiteSpace(created?.Id))
                            createdId = created.Id;
                    }
                    catch (JsonException)
                    {
                        // The create endpoint normally returns the canonical id; use the preallocated id as fallback.
                    }
                    _createdAssetId = createdId;
                    _form.Id = createdId;
                    if (_selectedFiles.Count > 0 && !await UploadFilesForAssetAsync(createdId))
                    {
                        _message = $"設備已建立（ID：{createdId}），但附件提交失敗；請保留本頁並按『提交所選附件』安全重試。{_message}";
                        return;
                    }
                    Nav.NavigateTo($"/assets/{Uri.EscapeDataString(EffectiveModuleCode)}");
                }
                else
                {
                    Nav.NavigateTo($"/assets/{Uri.EscapeDataString(EffectiveModuleCode)}");
                }
                return;
            }

            _message = $"儲存失敗：{response.StatusCode} {body}";
            Console.WriteLine($"[ApparatusEdit] Save failed. status={response.StatusCode}, body={body}");
        }
        catch (Exception ex)
        {
            _message = $"儲存發生例外：{ex.Message}";
            Console.WriteLine($"[ApparatusEdit] Save exception: {ex}");
        }
        finally
        {
            _saving = false;
        }
    }

    private void OnFilesSelected(InputFileChangeEventArgs e)
    {
        _selectedFiles.Clear();

        foreach (var file in e.GetMultipleFiles(20))
        {
            _selectedFiles.Add(new SelectedUploadFile
            {
                FileName = file.Name,
                ContentType = file.ContentType,
                Size = file.Size
            });
        }

        Console.WriteLine($"[ApparatusEdit] Files selected. count={_selectedFiles.Count}");
    }

    private async Task UploadFilesAsync()
    {
        if (!IsPersisted)
        {
            _message = "請先儲存設備，再上傳檔案。";
            Console.WriteLine("[ApparatusEdit] Upload blocked. Asset is not saved.");
            return;
        }

        if (string.IsNullOrWhiteSpace(CurrentAssetId))
        {
            _message = "尚未取得 ID。";
            Console.WriteLine("[ApparatusEdit] Upload blocked. Asset id is empty.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_form.Name) ||
            string.IsNullOrWhiteSpace(_form.Kind) ||
            string.IsNullOrWhiteSpace(_form.CustodianAccount))
        {
            _message = "請先填寫名稱、類別、保管人，再上傳檔案。";
            Console.WriteLine("[ApparatusEdit] Upload blocked. Required field missing.");
            return;
        }

        if (_selectedFiles.Count == 0)
        {
            _message = "請先選擇檔案。";
            Console.WriteLine("[ApparatusEdit] Upload blocked. No selected files.");
            return;
        }

        await UploadFilesForAssetAsync(CurrentAssetId!);
    }

    private async Task<bool> UploadFilesForAssetAsync(string assetId)
    {
        _uploading = true;
        _message = null;
        try
        {
            var response = await Api.UploadFilesAsync(
                $"/api/assets/{Uri.EscapeDataString(EffectiveModuleCode)}/{Uri.EscapeDataString(assetId)}/files",
                _fileInputContainer);
            if (!response.IsSuccessStatusCode)
            {
                _message = $"附件提交失敗：{response.StatusCode} {response.Body}";
                return false;
            }
            _selectedFiles.Clear();
            await LoadFilesAsync();
            _message = response.StatusCode == 202
                ? "附件已送主管審核，核准後才會建立正式檔案。"
                : IsEquipment
                    ? "附件已完成正式入庫；設備文件已建立 KM 排程，照片維持原有預覽且不進行 KM 分析。"
                    : "附件已完成正式提交。";
            return true;
        }
        catch (Exception ex)
        {
            _message = $"附件提交發生例外：{ex.Message}";
            return false;
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task LoadFilesAsync()
    {
        if (string.IsNullOrWhiteSpace(CurrentAssetId))
        {
            _files = new();
            return;
        }

        Console.WriteLine($"[ApparatusEdit] LoadFiles start. moduleCode={EffectiveModuleCode}, id={_form.Id}");

        _files = await Api.GetAsync<List<ApparatusFileDto>>(
            $"/api/assets/{Uri.EscapeDataString(EffectiveModuleCode)}/{Uri.EscapeDataString(CurrentAssetId!)}/files");
        var user = (await AuthProvider.GetAuthenticationStateAsync()).User;
        _ownUploads = await ContextUploads.ForAssetAsync(user, EffectiveModuleCode, CurrentAssetId!);

        Console.WriteLine($"[ApparatusEdit] LoadFiles done. id={_form.Id}, count={_files.Count}");
    }

    private async Task DeleteFileAsync(Guid fileId)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "確定要刪除此設備附件嗎？已送達 KM 的文件會先等待 KM 清理確認。"))
            return;
        Console.WriteLine($"[ApparatusEdit] DeleteFile start. fileId={fileId}");

        var response = await Api.DeleteAsync($"/api/assets/files/{fileId}");
        var body = response.Body;

        if (response.IsSuccessStatusCode)
        {
            Console.WriteLine($"[ApparatusEdit] DeleteFile success. fileId={fileId}");
            await LoadFilesAsync();
        }
        else
        {
            _message = $"刪除失敗：{response.StatusCode} {body}";
            Console.WriteLine($"[ApparatusEdit] DeleteFile failed. fileId={fileId}, status={response.StatusCode}, body={body}");
        }
    }

    private async Task LoadOptionsAsync()
    {
        Console.WriteLine("[ApparatusEdit] LoadOptions start.");

        _apparatusKindOptions = await LoadOptionCategoryAsync("ApparatusKind");
        _ownershipOptions = await Api.GetAsync<ApparatusOwnershipOptionsDto>(
            "/api/assets/ownership-options");

        EnsureCurrentOption(_apparatusKindOptions, _form.Kind);

        Console.WriteLine($"[ApparatusEdit] LoadOptions done. kind={_apparatusKindOptions.Count}, teams={_ownershipOptions.Teams.Count}, users={_ownershipOptions.Users.Count}");
    }

    private async Task LoadVendorOptionsAsync(Guid? includeVendorId = null)
    {
        var suffix = includeVendorId.HasValue ? $"?includeVendorId={includeVendorId.Value}" : string.Empty;
        _vendorOptions = await Api.GetAsync<List<VendorOptionDto>>($"/api/vendors/options{suffix}");
    }

    private void OnVendorChanged(ChangeEventArgs args)
    {
        if (!Guid.TryParse(args.Value?.ToString(), out var vendorId))
        {
            // Legacy equipment may remain unlinked until the user explicitly selects a vendor.
            if (!_isEdit) _form.VendorId = null;
            return;
        }

        var vendor = _vendorOptions.SingleOrDefault(x => x.Id == vendorId);
        if (vendor is null || (!vendor.IsActive && vendorId != _form.VendorId))
            return;

        if (_form.VendorId != vendorId)
        {
            _form.VendorId = vendorId;
            _form.Brand = vendor.Name;
        }
    }

    private async Task LoadEnvironmentAssignmentAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.Id))
        {
            _environmentAssignment = null;
            return;
        }
        _environmentAssignment = await Api.GetOptionalAsync<ApparatusEnvironmentAssignmentDto>(
            $"/api/apparatus/{Uri.EscapeDataString(_form.Id)}/environment-assignment");
    }

    private async Task ToggleEnvironmentPresenceAsync()
    {
        if (_environmentAssignment is null) return;
        _savingEnvironmentPresence = true;
        try
        {
            var target = !_environmentAssignment.IsInEnvironment;
            var response = await Api.PutJsonAsync(
                $"/api/test-catalog/equipment-group-devices/{_environmentAssignment.MembershipId}/presence",
                new UpdateEquipmentGroupDevicePresenceRequest { IsInEnvironment = target });
            response.EnsureSuccess();
            await LoadEnvironmentAssignmentAsync();
            _message = target ? "設備已放回測試環境。" : "設備已移出測試環境。";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _savingEnvironmentPresence = false;
        }
    }

    private void OnDepartmentChanged()
    {
        _form.ConfirmOwnershipChange = false;
        if (_form.OwnerTeamOptionId.HasValue &&
            AllowedOwnerTeams.All(team => team.Id != _form.OwnerTeamOptionId.Value))
        {
            _form.OwnerTeamOptionId = null;
        }

        if (!IsEquipment) ClearCustodianIfNotAllowed();
        UpdateManualOwnershipState();
    }

    private void OnOwnerTeamChanged()
    {
        _form.ConfirmOwnershipChange = false;
        if (!IsEquipment) ClearCustodianIfNotAllowed();
        UpdateManualOwnershipState();
    }

    private void OnCustodianChanged()
    {
        _form.ConfirmOwnershipChange = false;
        if (string.IsNullOrWhiteSpace(_form.CustodianAccount))
        {
            if (!_isEdit)
            {
                _form.DepartmentOptionId = null;
                _form.OwnerTeamOptionId = null;
                _ownershipNeedsAttention = false;
                _ownershipMessage = string.Empty;
                return;
            }
            _ownershipNeedsAttention = true;
            _ownershipMessage = "請先選擇保管人，系統才能從 Shared Identity 驗證部門與 Team。";
            return;
        }

        if (_isEdit && string.Equals(_form.CustodianAccount, _originalCustodianAccount,
                StringComparison.OrdinalIgnoreCase))
        {
            _form.DepartmentOptionId = _originalDepartmentOptionId;
            _form.OwnerTeamOptionId = _originalOwnerTeamOptionId;
            EvaluateExistingOwnership();
            return;
        }

        var users = _ownershipOptions.Users.Where(x =>
            string.Equals(x.Account, _form.CustodianAccount, StringComparison.OrdinalIgnoreCase)).ToList();
        if (users.Count != 1)
        {
            SetOwnershipResolutionFailure("Shared Identity 無法唯一識別所選保管人，請確認必要的部門與 Team。", clear: true);
            return;
        }

        var user = users[0];
        var departments = _ownershipOptions.Departments.Where(x =>
            string.Equals(x.Value?.Trim(), user.Department?.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
        if (departments.Count != 1)
        {
            SetOwnershipResolutionFailure("Shared Identity 的保管人部門無法唯一對應 CSIT 部門選項，請人工確認。", clear: true);
            return;
        }

        var department = departments[0];
        var teams = DepartmentTeamRules.GetAllowedTeamsForDepartment(
                department.Value, _ownershipOptions.Teams, team => team.Name, team => team.Value)
            .Where(x => string.Equals(x.Value?.Trim(), user.TeamCode?.Trim(),
                StringComparison.OrdinalIgnoreCase)).ToList();
        if (teams.Count != 1)
        {
            SetOwnershipResolutionFailure("Shared Identity 的保管人 Team 無法唯一對應該部門可用 Team，請人工確認。", clear: true);
            return;
        }

        _form.DepartmentOptionId = department.Id;
        _form.OwnerTeamOptionId = teams[0].Id;
        _ownershipNeedsAttention = false;
        _ownershipMessage = RequiresOwnershipChangeConfirmation
            ? "所選保管人屬於不同部門或 Team；請確認這是合法的設備歸屬變更。"
            : string.Empty;
    }

    private void EvaluateExistingOwnership()
    {
        if (!_form.DepartmentOptionId.HasValue || !_form.OwnerTeamOptionId.HasValue)
        {
            SetOwnershipResolutionFailure("既有設備缺少部門或 Team 歸屬，請修正後再儲存。", clear: false);
            return;
        }

        var departments = _ownershipOptions.Departments
            .Where(x => x.Id == _form.DepartmentOptionId.Value).ToList();
        var department = departments.Count == 1 ? departments[0] : null;
        var teams = department is null ? [] : DepartmentTeamRules.GetAllowedTeamsForDepartment(
                department.Value, _ownershipOptions.Teams, item => item.Name, item => item.Value)
            .Where(x => x.Id == _form.OwnerTeamOptionId.Value).ToList();
        var team = teams.Count == 1 ? teams[0] : null;
        var custodians = _ownershipOptions.Users.Where(x =>
            string.Equals(x.Account, _form.CustodianAccount, StringComparison.OrdinalIgnoreCase)).ToList();
        var custodian = custodians.Count == 1 ? custodians[0] : null;
        if (department is null || team is null || custodian is null ||
            !string.Equals(custodian.Department?.Trim(), department.Value?.Trim(), StringComparison.OrdinalIgnoreCase) ||
            !string.Equals(custodian.TeamCode?.Trim(), team.Value?.Trim(), StringComparison.OrdinalIgnoreCase))
        {
            SetOwnershipResolutionFailure("既有歸屬與目前 Shared Identity 正式資料不一致，請確認必要的部門與 Team。", clear: false);
            return;
        }

        _ownershipNeedsAttention = false;
        _ownershipMessage = string.Empty;
    }

    private void SetOwnershipResolutionFailure(string message, bool clear)
    {
        if (clear)
        {
            _form.DepartmentOptionId = null;
            _form.OwnerTeamOptionId = null;
        }
        _ownershipNeedsAttention = true;
        _ownershipMessage = message;
    }

    private void UpdateManualOwnershipState()
    {
        if (!_form.DepartmentOptionId.HasValue || !_form.OwnerTeamOptionId.HasValue ||
            string.IsNullOrWhiteSpace(_form.CustodianAccount))
        {
            _ownershipNeedsAttention = true;
            _ownershipMessage = "請確認保管人的部門與設備所屬 Team；伺服器將以 Shared Identity 再次驗證。";
            return;
        }

        var allowed = GetAllowedCustodians().Any(x =>
            string.Equals(x.Account, _form.CustodianAccount, StringComparison.OrdinalIgnoreCase));
        _ownershipNeedsAttention = !allowed;
        _ownershipMessage = allowed && RequiresOwnershipChangeConfirmation
            ? "部門或 Team 與原設備歸屬不同；請確認這是合法的歸屬變更。"
            : allowed ? string.Empty : "所選保管人不屬於目前部門與 Team，請重新選擇。";
    }

    private IReadOnlyList<ApparatusCustodianOptionDto> GetAllowedCustodians()
    {
        var department = _ownershipOptions.Departments
            .FirstOrDefault(x => x.Id == _form.DepartmentOptionId)?.Value;
        var team = _ownershipOptions.Teams
            .FirstOrDefault(x => x.Id == _form.OwnerTeamOptionId)?.Value;
        if (string.IsNullOrWhiteSpace(department) || string.IsNullOrWhiteSpace(team))
            return [];

        return _ownershipOptions.Users
            .Where(user =>
                string.Equals(user.Department?.Trim(), department.Trim(), StringComparison.OrdinalIgnoreCase) &&
                string.Equals(user.TeamCode?.Trim(), team.Trim(), StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private void ClearCustodianIfNotAllowed()
    {
        if (string.IsNullOrWhiteSpace(_form.CustodianAccount))
            return;

        if (GetAllowedCustodians().All(user =>
                !string.Equals(user.Account, _form.CustodianAccount, StringComparison.OrdinalIgnoreCase)))
        {
            _form.CustodianAccount = null;
        }
    }

    private async Task<List<SystemOptionDto>> LoadOptionCategoryAsync(string category)
    {
        try
        {
            var url = $"/api/system-options/category/{Uri.EscapeDataString(category)}";

            Console.WriteLine($"[ApparatusEdit] LoadOptionCategory start. category={category}, url={url}");

            var result = await Api.GetAsync<List<SystemOptionDto>>(url);

            var list = result
                .Where(x => x.IsEnabled)
                .OrderBy(x => x.Sort)
                .ThenBy(x => x.Name)
                .ToList();

            Console.WriteLine($"[ApparatusEdit] LoadOptionCategory done. category={category}, count={list.Count}");

            return list;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ApparatusEdit] LoadOptionCategory exception. category={category}, error={ex}");
            return new();
        }
    }

    private static void EnsureCurrentOption(List<SystemOptionDto> options, string? currentValue)
    {
        if (string.IsNullOrWhiteSpace(currentValue))
        {
            return;
        }

        var exists = options.Any(x =>
            string.Equals(x.Value, currentValue, StringComparison.OrdinalIgnoreCase));

        if (exists)
        {
            return;
        }

        options.Insert(0, new SystemOptionDto
        {
            Id = Guid.Empty,
            Category = "",
            Name = $"{currentValue}（舊值）",
            Value = currentValue,
            Sort = -999,
            IsEnabled = true
        });
    }

    private void Back()
    {
        Nav.NavigateTo($"/assets/{EffectiveModuleCode}");
    }

    private static string FormatSize(long size)
    {
        if (size >= 1024 * 1024) return $"{size / 1024d / 1024d:0.##} MB";
        if (size >= 1024) return $"{size / 1024d:0.##} KB";
        return $"{size} B";
    }

    private static string ArchiveStatusText(string? status) => status switch
    {
        "Archived" => "正式入庫",
        "Failed" => "歸檔失敗，可安全重試",
        "Pending" => "等待歸檔",
        _ => "既有檔案"
    };

