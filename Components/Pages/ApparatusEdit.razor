    private async Task ToggleEnvironmentPresenceAsync()
    {
        if (_environmentAssignment is null) return;
        _savingEnvironmentPresence = true;
        try
        {
            var target = !_environmentAssignment.IsInEnvironment;
            var response = await Api.PutJsonAsync(
                $"/api/test-catalog/equipment-group-devices/{_environmentAssignment.MembershipId}/presence",
                new UpdateEquipmentGroupDevicePresenceRequest { IsInEnvironment = target });
            response.EnsureSuccess();
            await LoadEnvironmentAssignmentAsync();
            _message = target ? "設備已放回測試環境。" : "設備已移出測試環境。";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _savingEnvironmentPresence = false;
        }
    }

    private void OnDepartmentChanged()
    {
        if (_form.OwnerTeamOptionId.HasValue &&
            AllowedOwnerTeams.All(team => team.Id != _form.OwnerTeamOptionId.Value))
        {
            _form.OwnerTeamOptionId = null;
        }

        ClearCustodianIfNotAllowed();
    }

    private void OnOwnerTeamChanged()
    {
        ClearCustodianIfNotAllowed();
    }

    private IReadOnlyList<ApparatusCustodianOptionDto> GetAllowedCustodians()
    {
        var department = _ownershipOptions.Departments
            .FirstOrDefault(x => x.Id == _form.DepartmentOptionId)?.Value;
        var team = _ownershipOptions.Teams
            .FirstOrDefault(x => x.Id == _form.OwnerTeamOptionId)?.Value;
        if (string.IsNullOrWhiteSpace(department) || string.IsNullOrWhiteSpace(team))
            return [];

        return _ownershipOptions.Users
            .Where(user =>
                string.Equals(user.Department?.Trim(), department.Trim(), StringComparison.OrdinalIgnoreCase) &&
                string.Equals(user.TeamCode?.Trim(), team.Trim(), StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private void ClearCustodianIfNotAllowed()
    {
        if (string.IsNullOrWhiteSpace(_form.CustodianAccount))
            return;

        if (AllowedCustodians.All(user =>
                !string.Equals(user.Account, _form.CustodianAccount, StringComparison.OrdinalIgnoreCase)))
        {
            _form.CustodianAccount = null;
        }
    }

    private async Task<List<SystemOptionDto>> LoadOptionCategoryAsync(string category)
    {
        try
        {
            var url = $"/api/system-options/category/{Uri.EscapeDataString(category)}";

            Console.WriteLine($"[ApparatusEdit] LoadOptionCategory start. category={category}, url={url}");

            var result = await Api.GetAsync<List<SystemOptionDto>>(url);

            var list = result
                .Where(x => x.IsEnabled)
                .OrderBy(x => x.Sort)
                .ThenBy(x => x.Name)
                .ToList();

            Console.WriteLine($"[ApparatusEdit] LoadOptionCategory done. category={category}, count={list.Count}");

            return list;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ApparatusEdit] LoadOptionCategory exception. category={category}, error={ex}");
            return new();
        }
    }

    private static void EnsureCurrentOption(List<SystemOptionDto> options, string? currentValue)
    {
        if (string.IsNullOrWhiteSpace(currentValue))
        {
            return;
        }

        var exists = options.Any(x =>
            string.Equals(x.Value, currentValue, StringComparison.OrdinalIgnoreCase));

        if (exists)
        {
            return;
        }

        options.Insert(0, new SystemOptionDto
        {
            Id = Guid.Empty,
            Category = "",
            Name = $"{currentValue}（舊值）",
            Value = currentValue,
            Sort = -999,
            IsEnabled = true
        });
    }

