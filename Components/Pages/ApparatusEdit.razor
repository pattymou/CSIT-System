    private async Task LoadResourceCapabilitiesAsync()
    {
        _resourceCatalog = await Api.GetAsync<List<ResourceMatchingCatalogValueDto>>(
            "/api/apparatus/resource-capabilities/catalog-values");
        var existing = await Api.GetAsync<List<ApparatusResourceCapabilityDto>>(
            $"/api/apparatus/{Uri.EscapeDataString(_form.Id ?? string.Empty)}/resource-capabilities");
        _resourceMappings = existing.Select(x => new ApparatusResourceCapabilityInput
        {
            ResourceType = x.ResourceType,
            CapabilityTag = x.CapabilityTag
        }).ToList();
    }

    private IEnumerable<string> CapabilityTags(string? resourceType) => _resourceCatalog
        .Where(x => string.Equals(x.ResourceType, resourceType, StringComparison.Ordinal) && !string.IsNullOrWhiteSpace(x.CapabilityTag))
        .Select(x => x.CapabilityTag!)
        .Distinct(StringComparer.Ordinal)
        .OrderBy(x => x);

    private void AddResourceCapability()
    {
        _resourceMappings.Add(new ApparatusResourceCapabilityInput
        {
            ResourceType = ResourceTypes.FirstOrDefault() ?? string.Empty
        });
    }

    private void RemoveResourceCapability(int index)
    {
        if (index >= 0 && index < _resourceMappings.Count)
            _resourceMappings.RemoveAt(index);
    }

    private void OnResourceTypeChanged(int index, ChangeEventArgs args)
    {
        if (index < 0 || index >= _resourceMappings.Count) return;
        _resourceMappings[index].ResourceType = args.Value?.ToString() ?? string.Empty;
        _resourceMappings[index].CapabilityTag = null;
    }

    private async Task SaveResourceCapabilitiesAsync()
    {
        _savingResourceCapabilities = true;
        _message = null;
        try
        {
            var response = await Api.PutJsonAsync(
                $"/api/apparatus/{Uri.EscapeDataString(_form.Id ?? string.Empty)}/resource-capabilities",
                new ReplaceApparatusResourceCapabilitiesRequest { Mappings = _resourceMappings });
            if (!response.IsSuccessStatusCode)
            {
                _message = $"儲存預約資源能力失敗：{response.Body}";
                return;
            }
            await LoadResourceCapabilitiesAsync();
            _message = "預約資源能力已儲存。";
        }
        catch (Exception ex)
        {
            _message = $"儲存預約資源能力失敗：{ex.Message}";
        }
        finally
        {
            _savingResourceCapabilities = false;
        }
    }

