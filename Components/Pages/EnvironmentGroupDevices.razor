@page "/test-environment-groups/{GroupId:guid}/devices"
@attribute [Authorize(Policy = SystemAuthorization.Policies.CsitStaff)]
@layout MainLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SIT.DepartmentSystem.Web.Entities
@using SIT.DepartmentSystem.Web.Models.Api
@inject BrowserApiClient Api
@inject NavigationManager Nav

<div class="case-title-row">
    <div>
        <div class="case-kicker">ENVIRONMENT GROUP DEVICES</div>
        <h3 class="page-title">測試環境設備管理</h3>
    </div>
    <button type="button" class="btn-secondary" @onclick="Back">返回測試環境群組設定</button>
</div>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="form-card @(_isError ? "error-text" : "success-text")">@_message</div>
}

@if (_loading)
{
    <div class="form-card">載入中...</div>
}
else if (_group is not null)
{
    <section class="form-card group-summary">
        <div>
            <span>測試環境群組</span>
            <strong>@_group.Name</strong>
            <small>@_group.Code</small>
        </div>
        <div><span>管理 Team</span><strong>@_group.OwnerTeamName</strong></div>
        <div><span>Site</span><strong>@_group.Site</strong></div>
        <div>
            <span>完整性</span>
            <strong class="@CompletenessClass">@CompletenessName</strong>
            <small>@_group.InEnvironmentDeviceCount / @_group.TotalDeviceCount 在環境</small>
        </div>
    </section>

    <section class="form-card">
        <div class="section-head">
            <div>
                <h4>目前環境設備</h4>
                <p>暫時移出會保留標準組成；從群組移除則永久修改群組組成。</p>
            </div>
            <button type="button" class="primary-btn" @onclick="ToggleCandidates">@(_showCandidates ? "關閉加入設備" : "+ 加入設備")</button>
        </div>

        @if (_devices.Count == 0)
        {
            <div class="record-empty-box"><strong>未設定設備</strong><span>請使用「加入設備」選擇既有實體設備。</span></div>
        }
        else
        {
            <div class="project-table-wrap">
                <table class="project-table">
                    <thead><tr><th>設備編號</th><th>設備名稱</th><th>類別</th><th>型號</th><th>保管人</th><th>設備狀態</th><th>目前位置</th><th>環境狀態</th><th>操作</th></tr></thead>
                    <tbody>
                        @foreach (var device in _devices)
                        {
                            <tr>
                                <td>@DeviceNumber(device.ProductsId, device.ApparatusId)</td>
                                <td>@device.ApparatusName</td>
                                <td>@Display(device.Kind)</td>
                                <td>@Display(device.Model)</td>
                                <td>@Display(device.Custodian)</td>
                                <td>@Display(device.ReservationStatus)</td>
                                <td>@Display(device.Place)</td>
                                <td><span class="presence-badge @(device.IsInEnvironment ? "present" : "away")">@(device.IsInEnvironment ? "在測試環境" : "已移出測試環境")</span></td>
                                <td class="action-cell">
                                    <button type="button" class="table-chip-btn" disabled="@_saving" @onclick="() => SetPresenceAsync(device, !device.IsInEnvironment)">
                                        @(device.IsInEnvironment ? "暫時移出環境" : "放回測試環境")
                                    </button>
                                    <button type="button" class="table-chip-btn danger" disabled="@_saving" @onclick="() => RemoveAsync(device)">從群組移除</button>
                                </td>
                            </tr>
                            @if (!string.IsNullOrWhiteSpace(device.Warning))
                            {
                                <tr class="warning-row"><td colspan="9">⚠ @device.Warning</td></tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (_showCandidates)
    {
        <section class="form-card candidate-panel">
            <div class="section-head">
                <div><h4>加入設備</h4><p>僅使用設備主檔中 ModuleCode = equipment 的既有設備。</p></div>
                <div class="candidate-actions">
                    <input @bind="_keyword" @bind:event="oninput" placeholder="搜尋 ID、名稱、類別、品牌、型號、編號、保管人或地點" />
                    <button type="button" class="btn-secondary" @onclick="LoadCandidatesAsync">搜尋</button>
                    <button type="button" class="primary-btn" disabled="@(_saving || _selectedIds.Count == 0)" @onclick="AddSelectedAsync">加入測試環境（@_selectedIds.Count）</button>
                </div>
            </div>
            <div class="candidate-grid">
                @foreach (var item in _candidates)
                {
                    <label class="candidate-card @(!item.CanAdd ? "disabled" : null)">
                        <input type="checkbox" disabled="@(!item.CanAdd || _saving)" checked="@_selectedIds.Contains(item.ApparatusId)" @onchange="e => ToggleCandidate(item.ApparatusId, e)" />
                        <span>
                            <strong>@DeviceNumber(item.ProductsId, item.ApparatusId) · @item.ApparatusName</strong>
                            <small>@Display(item.Kind) · @Display(item.Brand) / @Display(item.Model) · @Display(item.Place)</small>
                            <small>保管人：@Display(item.Custodian)　所屬 Team：@Display(item.OwnerTeamName)</small>
                            @if (!item.CanAdd) { <em>@item.UnavailableReason</em> }
                        </span>
                    </label>
                }
            </div>
            @if (_candidates.Count == 0)
            {
                <div class="record-empty-box"><strong>查無設備</strong></div>
            }
        </section>
    }
}

@code {
    [Parameter] public Guid GroupId { get; set; }

    private EquipmentGroupDto? _group;
    private List<EquipmentGroupDeviceDto> _devices = [];
    private List<EquipmentGroupDeviceCandidateDto> _candidates = [];
    private readonly HashSet<string> _selectedIds = new(StringComparer.Ordinal);
    private string _keyword = string.Empty;
    private string? _message;
    private bool _isError;
    private bool _loading = true;
    private bool _saving;
    private bool _showCandidates;
    private Guid _loadedGroupId;

    private string CompletenessName => _group?.CompletenessStatus switch
    {
        EquipmentGroupCompletenessStatus.Complete => "設備齊全",
        EquipmentGroupCompletenessStatus.Incomplete => "設備不齊全",
        _ => "未設定設備"
    };
    private string CompletenessClass => _group?.CompletenessStatus switch
    {
        EquipmentGroupCompletenessStatus.Complete => "complete",
        EquipmentGroupCompletenessStatus.Incomplete => "incomplete",
        _ => "unconfigured"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_loadedGroupId == GroupId) return;
        _loadedGroupId = GroupId;
        try { await ReloadAsync(); }
        catch (Exception ex) { ShowError(ex.Message); }
        finally { _loading = false; StateHasChanged(); }
    }

    private async Task ReloadAsync()
    {
        _group = await Api.GetAsync<EquipmentGroupDto>($"/api/test-catalog/equipment-groups/{GroupId}");
        _devices = await Api.GetAsync<List<EquipmentGroupDeviceDto>>($"/api/test-catalog/equipment-groups/{GroupId}/devices");
    }

    private async Task ToggleCandidates()
    {
        _showCandidates = !_showCandidates;
        _selectedIds.Clear();
        if (_showCandidates) await LoadCandidatesAsync();
    }

    private async Task LoadCandidatesAsync()
    {
        try
        {
            _candidates = await Api.GetAsync<List<EquipmentGroupDeviceCandidateDto>>(
                $"/api/test-catalog/equipment-groups/{GroupId}/device-candidates?keyword={Uri.EscapeDataString(_keyword)}");
            _selectedIds.RemoveWhere(id => !_candidates.Any(x => x.ApparatusId == id && x.CanAdd));
        }
        catch (Exception ex) { ShowError(ex.Message); }
    }

    private void ToggleCandidate(string apparatusId, ChangeEventArgs args)
    {
        if (args.Value is true) _selectedIds.Add(apparatusId);
        else _selectedIds.Remove(apparatusId);
    }

    private async Task AddSelectedAsync()
    {
        _saving = true;
        try
        {
            var response = await Api.PostJsonAsync($"/api/test-catalog/equipment-groups/{GroupId}/devices",
                new AddEquipmentGroupDevicesRequest { ApparatusIds = _selectedIds.ToList() });
            response.EnsureSuccess();
            _selectedIds.Clear();
            await ReloadAsync();
            await LoadCandidatesAsync();
            ShowSuccess("設備已加入測試環境。");
        }
        catch (Exception ex) { ShowError(ex.Message); }
        finally { _saving = false; }
    }

    private async Task SetPresenceAsync(EquipmentGroupDeviceDto device, bool isInEnvironment)
    {
        _saving = true;
        try
        {
            var response = await Api.PutJsonAsync($"/api/test-catalog/equipment-group-devices/{device.Id}/presence",
                new UpdateEquipmentGroupDevicePresenceRequest { IsInEnvironment = isInEnvironment });
            response.EnsureSuccess();
            await ReloadAsync();
            if (_showCandidates) await LoadCandidatesAsync();
            ShowSuccess(isInEnvironment ? "設備已放回測試環境。" : "設備已暫時移出測試環境。");
        }
        catch (Exception ex) { ShowError(ex.Message); }
        finally { _saving = false; }
    }

    private async Task RemoveAsync(EquipmentGroupDeviceDto device)
    {
        _saving = true;
        try
        {
            var response = await Api.DeleteAsync($"/api/test-catalog/equipment-group-devices/{device.Id}");
            response.EnsureSuccess();
            await ReloadAsync();
            if (_showCandidates) await LoadCandidatesAsync();
            ShowSuccess("設備已永久從群組組成移除。");
        }
        catch (Exception ex) { ShowError(ex.Message); }
        finally { _saving = false; }
    }

    private void Back() => Nav.NavigateTo("/test-environment-settings");
    private void ShowError(string message) { _message = message; _isError = true; }
    private void ShowSuccess(string message) { _message = message; _isError = false; }
    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private static string DeviceNumber(string? productsId, string id) => string.IsNullOrWhiteSpace(productsId) ? id : productsId;
}
