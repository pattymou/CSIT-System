@page "/validation-request-applications/work/{RecordId:guid}/tasks/{TaskId:guid}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = SystemAuthorization.Policies.CsitStaff)]
@using Microsoft.AspNetCore.Authorization
@using SIT.DepartmentSystem.Web.Models.Api
@inject BrowserApiClient Api

<PageTitle>測試項目明細</PageTitle>
<nav class="work-breadcrumb" aria-label="頁面導覽">
    <a href="/validation-request-applications">驗證申請專區</a><span>›</span>
    <a href="@($"/validation-request-applications/work/{RecordId}")">測試項目</a><span>›</span><span>項目明細</span>
</nav>
<h3 class="page-title">測試項目明細</h3>

@if (_error is not null) { <div class="surface-card error-text">@_error</div> }
else if (_loading) { <div class="surface-card">載入中...</div> }
else if (_item is not null)
{
    <section class="surface-card task-context">
        <div><span>Model Name</span><strong>@_item.ModelName</strong></div>
        <div><span>申請編號</span><strong>@_item.ApplicationNo</strong></div>
        <div><span>分類</span><strong>@_item.SelectedItem.Category</strong></div>
    </section>
    @if (_item.DeletionStatus is null or "Prepared")
    {
        <VerificationWorkTaskCard RecordId="RecordId" Task="_item.Task" Engineers="_engineers" OnChanged="ReloadAsync" />
    }
    else
    {
        <section class="surface-card work-notice" role="status">案件已凍結，測試工作與報告操作已停止。</section>
    }
}

@code {
    [Parameter] public Guid RecordId { get; set; }
    [Parameter] public Guid TaskId { get; set; }
    private VerificationWorkTaskDetailDto? _item;
    private IReadOnlyList<AssignableEngineerDto> _engineers = [];
    private bool _loading = true;
    private string? _error;

    protected override Task OnParametersSetAsync() => ReloadAsync();
    private async Task ReloadAsync()
    {
        try
        {
            _error = null;
            _item = await Api.GetOptionalAsync<VerificationWorkTaskDetailDto>(
                $"/api/verification-work/{RecordId}/tasks/{TaskId}");
            if (_item is null) { _error = "找不到屬於此案件的可管理測試項目。"; return; }
            if (_item.DeletionStatus is null or "Prepared")
                _engineers = await Api.GetAsync<List<AssignableEngineerDto>>(
                    $"/api/records/{RecordId}/assignable-engineers");
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }
}
