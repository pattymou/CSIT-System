@page "/reservation-overdue"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Policy = SystemAuthorization.Policies.CsitStaff)]
@inject ReservationApiClient Api
@inject NavigationManager Nav

<PageTitle>逾期未歸還</PageTitle>
<h3 class="page-title">逾期未歸還</h3>
@if (!string.IsNullOrWhiteSpace(_message)) { <div class="surface-card error-text">@_message</div> }
else if (_loading) { <div class="surface-card">載入中...</div> }
else
{
    <div class="surface-card"><div class="project-table-wrap"><table class="project-table">
        <thead><tr><th>預約</th><th>借用人 / 部門 / 分機</th><th>設備</th><th>借出時間</th><th>應歸還</th><th>逾期</th></tr></thead>
        <tbody>
        @if (_items.Count == 0) { <tr><td colspan="6" class="empty-row">目前沒有逾期未歸還設備。</td></tr> }
        @foreach (var item in _items)
        {
            <tr class="clickable-row" @onclick="() => Open(item.Id)"><td>@item.ReservationNo</td>
                <td>@item.ApplicantName<br /><span class="hint-text">@item.ApplicantDepartment / #@item.ApplicantExtension</span></td>
                <td>@ReservationUi.EquipmentSummary(item.ApparatusNames, item.ItemCount)</td><td>@if (item.BorrowedAt.HasValue) { <LocalDateTime Value="item.BorrowedAt" /> }</td>
                <td><LocalDateTime Value="item.EndTime" /></td><td>@OverdueText(item.EndTime)</td></tr>
        }
        </tbody></table></div>
        <div class="form-actions"><button class="btn-secondary" @onclick='() => Nav.NavigateTo("/reservation-review")'>返回管理</button></div>
    </div>
}
@code {
    private List<ReservationListDto> _items = [];
    private bool _loading = true;
    private string? _message;
    protected override async Task OnInitializedAsync() { try { _items = await Api.OverdueAsync(); } catch (Exception ex) { _message = ex.Message; } finally { _loading = false; } }
    private static string OverdueText(DateTime end) { var span = DateTime.UtcNow - end; return span.TotalDays >= 1 ? $"{(int)span.TotalDays} 天 {span.Hours} 小時" : $"{Math.Max(0, (int)span.TotalHours)} 小時"; }
    private void Open(Guid id) => Nav.NavigateTo($"/reservation-review/{id}");
}
