@page "/validation-request-applications/work/{RecordId:guid}/selected/{ItemCode}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = SystemAuthorization.Policies.CsitStaff)]
@using Microsoft.AspNetCore.Authorization
@using SIT.DepartmentSystem.Web.Models.Api
@inject BrowserApiClient Api

<PageTitle>原申請測試項目</PageTitle>
<nav class="work-breadcrumb" aria-label="頁面導覽">
    <a href="/validation-request-applications">驗證申請專區</a><span>›</span>
    <a href="@($"/validation-request-applications/work/{RecordId}")">測試項目</a><span>›</span><span>原申請資訊</span>
</nav>
<h3 class="page-title">原申請測試項目</h3>

@if (_error is not null) { <div class="surface-card error-text">@_error</div> }
else if (_loading) { <div class="surface-card">載入中...</div> }
else if (_item is not null && _selected is not null)
{
    <section class="surface-card selected-context">
        <div><span>Model Name</span><strong>@_item.ModelName</strong></div>
        <div><span>申請編號</span><strong>@_item.ApplicationNo</strong></div>
        <div><span>分類</span><strong>@_selected.Category</strong></div>
        <div><span>測試項目</span><strong>@_selected.Name</strong></div>
    </section>
    <div class="selected-notice">此項目尚未建立可管理的測試工作，以下為原申請資訊，無法指派工程師、變更狀態或上傳測試報告。</div>
    <section class="surface-card selected-parameters">
        <h4>原申請測試參數</h4>
        @if (_selected.Parameters.Count == 0) { <p>原申請未填寫測試參數。</p> }
        else
        {
            <dl>
                @foreach (var parameter in _selected.Parameters)
                {
                    <dt>@parameter.Name</dt><dd>@string.Join("、", parameter.Values)</dd>
                }
            </dl>
        }
    </section>
}

@code {
    [Parameter] public Guid RecordId { get; set; }
    [Parameter] public string ItemCode { get; set; } = string.Empty;
    private VerificationWorkDetailDto? _item;
    private SelectedVerificationTestItemDto? _selected;
    private bool _loading = true;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _error = null;
            _item = await Api.GetOptionalAsync<VerificationWorkDetailDto>($"/api/verification-work/{RecordId}");
            _selected = _item?.SelectedTestItems.SingleOrDefault(x =>
                string.Equals(x.Code, ItemCode, StringComparison.OrdinalIgnoreCase) && x.TaskId is null);
            if (_selected is null) _error = "找不到此案件的唯讀原申請測試項目。";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }
}
