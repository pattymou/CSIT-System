@page "/apparatus/{Id}"
@page "/assets/{ModuleCode}/{Id}"
@attribute [Authorize(Policy = SystemAuthorization.Policies.CsitStaff)]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SIT.DepartmentSystem.Web.Services.Interfaces
@inject BrowserApiClient Api
@inject NavigationManager Nav
@inject IMenuManagementService MenuService

<h3>@PageTitle</h3>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="form-card error-text">@_message</div>
}

@if (_item == null)
{
    <div class="form-card">Loading...</div>
}
else
{
    <div class="form-actions apparatus-view-actions">
        <button class="primary-btn" @onclick="Edit">修改設備資訊</button>
        <button class="table-chip-btn danger" @onclick="DeleteAsync">刪除此設備資訊</button>
        <button class="btn-secondary" @onclick="Back">上一頁</button>
    </div>

    <div class="form-card">
        <div class="case-card-head">
            <div>
                <div class="case-kicker">@PageTitle</div>
                <h3>@_item.Name</h3>
            </div>
            <span class="record-status-pill">@Display(_item.ReservationStatus)</span>
        </div>

        @if (IsEquipment)
        {
        <div class="record-detail-grid">
            <div class="record-detail-item"><span>財產編號</span><strong>@Display(_item.ProductsId)</strong></div>
            <div class="record-detail-item"><span>設備分類</span><strong>@Display(_item.Kind)</strong></div>
            <div class="record-detail-item"><span>設備名稱</span><strong>@Display(_item.Name)</strong></div>
            <div class="record-detail-item"><span>廠牌</span><strong>@Display(_item.VendorName ?? _item.Brand)</strong>@if (!_item.VendorId.HasValue && !string.IsNullOrWhiteSpace(_item.Brand)) { <small>原始廠牌值（尚未連結廠商主檔）</small> }</div>
            <div class="record-detail-item"><span>型號</span><strong>@Display(_item.Model)</strong></div>
            <div class="record-detail-item"><span>序號</span><strong>@Display(_item.Number)</strong></div>
            <div class="record-detail-item"><span>設備位置</span><strong>@Display(_item.Place)</strong></div>
            <div class="record-detail-item"><span>保管人</span><strong>@Display(_item.Custodian)</strong></div>
            <div class="record-detail-item"><span>設備狀態</span><strong>@Display(_item.ReservationStatus)</strong></div>
        </div>
        <details class="equipment-view-details"><summary>其他資料</summary><div class="record-detail-grid">
            <div class="record-detail-item"><span>設備名稱（英文）</span><strong>@Display(_item.NameEn)</strong></div>
            <div class="record-detail-item"><span>料號</span><strong>@Display(_item.PartNo)</strong></div>
            <div class="record-detail-item"><span>廠商貨品編號</span><strong>@Display(_item.ManufacturerNumber)</strong></div>
            <div class="record-detail-item"><span>對應採購</span><strong>@Display(_item.ProcurementStaff)</strong></div>
            <div class="record-detail-item"><span>IMEI</span><strong>@Display(_item.Imei)</strong></div>
            <div class="record-detail-item"><span>OS</span><strong>@Display(_item.Os)</strong></div>
            <div class="record-detail-item"><span>OS Ver.</span><strong>@Display(_item.OsVersion)</strong></div>
            <div class="record-detail-item"><span>檢查日期</span><strong>@DisplayDate(_item.InspectionDate)</strong></div>
            <div class="record-detail-item"><span>保養日期</span><strong>@DisplayDate(_item.MaintenanceDate)</strong></div>
            <div class="record-detail-item"><span>取得成本</span><strong>@Display(_item.CostPrice)</strong></div>
            <div class="record-detail-item"><span>使用年限</span><strong>@Display(_item.YearsUse)</strong></div>
            <div class="record-detail-item"><span>使用天數</span><strong>@Display(_item.DaysUse)</strong></div>
            <div class="record-detail-item"><span>使用價格</span><strong>@Display(_item.PriceUse)</strong></div>
            <div class="record-detail-item"><span>保管代理人</span><strong>@Display(_item.Agent)</strong></div>
            <div class="record-detail-item record-detail-full"><span>Feature</span><strong>@Display(_item.Feature)</strong></div>
            <div class="record-detail-item record-detail-full"><span>Specification</span><strong>@Display(_item.Spec)</strong></div>
            <div class="record-detail-item record-detail-full"><span>備註</span><strong>@Display(_item.Note)</strong></div>
        </div></details>
        <div class="equipment-record-timestamps">
            建立：@DisplayDateTime(_item.CreatedAt) <span aria-hidden="true">｜</span> 更新：@DisplayDateTime(_item.UpdatedAt)
        </div>
        }
        else
        {
        <div class="record-detail-grid">
            <div class="record-detail-item"><span>財產編號</span><strong>@Display(_item.ProductsId)</strong></div>
            <div class="record-detail-item"><span>設備名稱(中文)</span><strong>@Display(_item.Name)</strong></div>
            <div class="record-detail-item"><span>設備名稱(英文)</span><strong>@Display(_item.NameEn)</strong></div>

            <div class="record-detail-item"><span>類別</span><strong>@Display(_item.Kind)</strong></div>
            <div class="record-detail-item"><span>料號</span><strong>@Display(_item.PartNo)</strong></div>
            <div class="record-detail-item"><span>廠商</span><strong>@Display(_item.VendorName ?? _item.Manufacturer)</strong></div>

            <div class="record-detail-item"><span>廠商貨品編號</span><strong>@Display(_item.ManufacturerNumber)</strong></div>
            <div class="record-detail-item"><span>廠牌</span><strong>@Display(_item.Brand)</strong></div>
            <div class="record-detail-item"><span>型號</span><strong>@Display(_item.Model)</strong></div>

            <div class="record-detail-item"><span>序號</span><strong>@Display(_item.Number)</strong></div>
            <div class="record-detail-item"><span>對應採購</span><strong>@Display(_item.ProcurementStaff)</strong></div>
            <div class="record-detail-item"><span>IMEI</span><strong>@Display(_item.Imei)</strong></div>

            <div class="record-detail-item"><span>OS</span><strong>@Display(_item.Os)</strong></div>
            <div class="record-detail-item"><span>OS Ver.</span><strong>@Display(_item.OsVersion)</strong></div>
            <div class="record-detail-item"><span>放置地點</span><strong>@Display(_item.Place)</strong></div>

            <div class="record-detail-item"><span>檢查日期</span><strong>@DisplayDate(_item.InspectionDate)</strong></div>
            <div class="record-detail-item"><span>保養日期</span><strong>@DisplayDate(_item.MaintenanceDate)</strong></div>
            <div class="record-detail-item"><span>設備狀態</span><strong>@Display(_item.ReservationStatus)</strong></div>

            <div class="record-detail-item"><span>取得成本</span><strong>@Display(_item.CostPrice)</strong></div>
            <div class="record-detail-item"><span>使用年限</span><strong>@Display(_item.YearsUse)</strong></div>
            <div class="record-detail-item"><span>使用天數</span><strong>@Display(_item.DaysUse)</strong></div>

            <div class="record-detail-item"><span>使用價格</span><strong>@Display(_item.PriceUse)</strong></div>
            <div class="record-detail-item"><span>部門</span><strong>@Display(_item.DepartmentName)</strong></div>
            <div class="record-detail-item"><span>設備所屬 Team</span><strong>@Display(_item.OwnerTeamName)</strong></div>
            <div class="record-detail-item"><span>保管人</span><strong>@Display(_item.Custodian)</strong></div>

            <div class="record-detail-item"><span>保管代理人</span><strong>@Display(_item.Agent)</strong></div>

            <div class="record-detail-item record-detail-full"><span>Feature</span><strong>@Display(_item.Feature)</strong></div>
            <div class="record-detail-item record-detail-full"><span>Specification</span><strong>@Display(_item.Spec)</strong></div>
            <div class="record-detail-item record-detail-full"><span>備註</span><strong>@Display(_item.Note)</strong></div>
        </div>
        }
    </div>

    @if (IsEquipment)
    {
        <SIT.DepartmentSystem.Web.Components.Shared.EquipmentMetadataSummary Files="_item.Files" />
    }

    <div class="form-card">
        <div class="case-card-head">
            <div>
                <div class="case-kicker">APPARATUS DOCUMENTS</div>
                <h3>設備文件與照片</h3>
            </div>
        </div>

        @if (IsEquipment)
        {
            var photos = _item.Files.Where(x => x.IsImage).ToList();
            @if (photos.Count > 0)
            {
                <div class="equipment-photo-gallery" aria-label="設備照片">
                    @foreach (var photo in photos)
                    {
                        <a href="@photo.ImageUrl" target="_blank" rel="noopener" title="開啟原圖：@photo.FileName">
                            <img src="@photo.ImageUrl" alt="設備照片 @photo.FileName" loading="lazy" />
                            <span>@photo.FileName</span>
                        </a>
                    }
                </div>
            }
            <SIT.DepartmentSystem.Web.Components.Shared.EquipmentFileTable Files="_item.Files" />
        }
        else if (_item.Files.Count == 0)
        {
            <div class="record-empty-box">
                <strong>目前沒有文件</strong>
                <span>請到修改頁選取並提交設備文件。</span>
            </div>
        }
        else
        {
            <div class="upload-list">
                @foreach (var file in _item.Files)
                {
                    <div class="upload-file-item">
                        @if (file.IsImage)
                        {
                            <img class="apparatus-view-thumbnail" src="@file.ImageUrl" alt="@file.FileName" />
                        }
                        <div>
                            <a href="@file.DownloadUrl" target="_blank" rel="noopener">@file.FileName</a>
                            <small>@FormatSize(file.FileSize) · @ArchiveStatusText(file.ArchiveStatus)</small>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public string? ModuleCode { get; set; }
    [Parameter] public string Id { get; set; } = "";

    private string EffectiveModuleCode => string.IsNullOrWhiteSpace(ModuleCode) ? "equipment" : ModuleCode.Trim();
    private bool IsEquipment => string.Equals(EffectiveModuleCode, "equipment", StringComparison.OrdinalIgnoreCase);

    private ApparatusDetailDto? _item;
    private string? _message;
    private bool _reloadRequested;

    // ⭐ 新增：頁面標題
    private string PageTitle = "";

    protected override void OnParametersSet()
    {
        _reloadRequested = true;
        _item = null;
        _message = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_reloadRequested) return;
        _reloadRequested = false;

        await LoadMenuTitle(); // ⭐ 新增

        try
        {
            _item = await Api.GetAsync<ApparatusDetailDto>(
                $"/api/assets/{Uri.EscapeDataString(EffectiveModuleCode)}/{Uri.EscapeDataString(Id)}");
        }
        catch (Exception ex)
        {
            _message = $"載入資料失敗：{ex.Message}";
        }

        StateHasChanged();
    }

    // ⭐ 核心：抓「子選單名稱」
    private async Task LoadMenuTitle()
    {
        try
        {
            var sections = await MenuService.GetSectionsAsync();

            var dept = sections.FirstOrDefault(x =>
                x.Code.Equals("department", StringComparison.OrdinalIgnoreCase));

            if (dept == null)
            {
                PageTitle = $"資產管理 - {EffectiveModuleCode}";
                return;
            }

            var items = await MenuService.GetItemsBySectionAsync(dept.Id);

            var menu = items.FirstOrDefault(x =>
                x.TemplateType == "Asset" &&
                string.Equals(x.ModuleCode, EffectiveModuleCode, StringComparison.OrdinalIgnoreCase));

            if (menu != null)
            {
                PageTitle = menu.Title; // ⭐ 重點：用子選單名稱
                return;
            }

            // fallback
            PageTitle = $"資產管理 - {EffectiveModuleCode}";
        }
        catch (Exception ex)
        {
            PageTitle = $"資產管理 - {EffectiveModuleCode}";
            Console.WriteLine($"[Apparatus] LoadMenuTitle error: {ex.Message}");
        }
    }

    private void Edit()
    {
        Nav.NavigateTo($"/assets/{EffectiveModuleCode}/{Id}/edit");
    }

    private void Back()
    {
        Nav.NavigateTo($"/assets/{EffectiveModuleCode}");
    }

    private async Task DeleteAsync()
    {
        var response = await Api.DeleteAsync(
            $"/api/assets/{Uri.EscapeDataString(EffectiveModuleCode)}/{Uri.EscapeDataString(Id)}");

        if (response.IsSuccessStatusCode)
        {
            Nav.NavigateTo($"/assets/{EffectiveModuleCode}");
            return;
        }

        _message = $"刪除失敗：{response.StatusCode} {response.Body}";
    }

    private static string Display(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : value;
    }

    private static string DisplayDate(DateOnly? value)
    {
        return value?.ToString("yyyy/MM/dd") ?? "-";
    }

    private static string DisplayDateTime(DateTime value) =>
        value == default ? "—" : value.ToLocalTime().ToString("yyyy/MM/dd HH:mm");

    private static string FormatSize(long size) => size >= 1024 * 1024
        ? $"{size / 1024d / 1024d:0.##} MB"
        : size >= 1024 ? $"{size / 1024d:0.##} KB" : $"{size} B";

    private static string ArchiveStatusText(string? value) => value switch
    {
        "Archived" => "正式入庫",
        "Failed" => "歸檔失敗",
        "Pending" => "等待歸檔",
        _ => "既有檔案"
    };
}

<style>
    .apparatus-view-thumbnail { width:96px; height:72px; object-fit:cover; border-radius:8px; margin-right:.75rem; }
    .upload-file-item small { display:block; color:var(--text-muted,#64748b); }
    .record-detail-item small { display:block; margin-top:.25rem; color:var(--text-muted,#64748b); }
    .equipment-view-details { margin-top:1rem; border-top:1px solid var(--border-color,#d6dbe3); padding-top:.75rem; }
    .equipment-view-details summary { cursor:pointer; font-weight:700; margin-bottom:1rem; }
    .equipment-record-timestamps { margin-top:1rem; color:var(--text-muted,#64748b); font-size:.78rem; }
    .equipment-photo-gallery { display:grid; grid-template-columns:repeat(auto-fill,minmax(170px,1fr)); gap:12px; margin-bottom:1rem; }
    .equipment-photo-gallery a { display:grid; gap:.4rem; padding:.5rem; border:1px solid rgba(148,163,184,.22); border-radius:10px; color:inherit; text-decoration:none; background:rgba(15,23,42,.2); }
    .equipment-photo-gallery a:hover,.equipment-photo-gallery a:focus-visible { border-color:rgba(34,211,238,.5); background:rgba(34,211,238,.07); }
    .equipment-photo-gallery img { width:100%; height:150px; object-fit:cover; border-radius:7px; background:#0f172a; }
    .equipment-photo-gallery span { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:.82rem; }
</style>
