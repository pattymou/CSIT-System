    private bool MatchesSearch(ManualSection section)
    {
        var query = _searchText.Trim();
        return section.Title.Contains(query, StringComparison.OrdinalIgnoreCase)
            || section.Summary.Contains(query, StringComparison.OrdinalIgnoreCase)
            || section.Keywords.Contains(query, StringComparison.OrdinalIgnoreCase)
            || section.Steps.Any(x => x.Contains(query, StringComparison.OrdinalIgnoreCase))
            || section.Rules.Any(x => x.Contains(query, StringComparison.OrdinalIgnoreCase))
            || section.Notes.Any(x => x.Contains(query, StringComparison.OrdinalIgnoreCase))
            || section.Figures.Any(x =>
                x.Title.Contains(query, StringComparison.OrdinalIgnoreCase)
                || x.Caption.Contains(query, StringComparison.OrdinalIgnoreCase)
                || x.ImageAlt.Contains(query, StringComparison.OrdinalIgnoreCase));
    }

    private void ClearSearch() => _searchText = string.Empty;

    private ManualFigure? _lightboxFigure;

    private bool IsManualImageAvailable(string imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl) || string.IsNullOrWhiteSpace(HostEnvironment.WebRootPath))
            return false;

        var relativePath = imageUrl.TrimStart('/').Replace('/', Path.DirectorySeparatorChar);
        return File.Exists(Path.Combine(HostEnvironment.WebRootPath, relativePath));
    }

    private void OpenFigure(ManualFigure figure)
    {
        if (IsManualImageAvailable(figure.ImageUrl))
            _lightboxFigure = figure;
    }

    private void CloseFigure() => _lightboxFigure = null;

    private void HandleLightboxKeyDown(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Escape", StringComparison.Ordinal))
            CloseFigure();
    }

