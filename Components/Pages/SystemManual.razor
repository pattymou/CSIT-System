@page "/help/manual"
@attribute [Authorize(Policy = SystemAuthorization.Policies.CsitStaff)]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Hosting
@using Microsoft.AspNetCore.Components.Web
@inject IWebHostEnvironment HostEnvironment

<PageTitle>CSIT 操作手冊</PageTitle>

<div class="manual-page">
    <section class="manual-hero" aria-labelledby="manual-title">
        <div class="manual-hero-copy">
            <div class="manual-eyebrow">SYSTEM HELP / MANUAL</div>
            <h1 id="manual-title">CSIT 操作手冊</h1>
            <p class="manual-subtitle">系統操作、流程與使用規範</p>
            <p class="manual-intro">可從下方選擇功能，查看操作步驟、系統規則與注意事項。</p>
        </div>
        <div class="manual-hero-mark" aria-hidden="true">?</div>
    </section>

    <div class="manual-toolbar">
        <label class="manual-search">
            <span class="visually-hidden">搜尋操作說明</span>
            <span class="manual-search-icon" aria-hidden="true">⌕</span>
            <input @bind="_searchText" @bind:event="oninput" placeholder="搜尋操作說明，例如：新增設備、檔案報告、權限" />
            @if (!string.IsNullOrWhiteSpace(_searchText))
            {
                <button type="button" class="manual-clear" @onclick="ClearSearch" aria-label="清除搜尋">×</button>
            }
        </label>
        <div class="manual-result-count">顯示 @_visibleSections.Count / @_sections.Count 個章節</div>
    </div>

    @if (_visibleSections.Count == 0)
    {
        <div class="manual-empty">
            <strong>找不到符合的操作說明</strong>
            <span>請換個關鍵字試試看。</span>
        </div>
    }
    else
    {
        <div class="manual-layout">
            <aside class="manual-toc" aria-label="操作手冊章節">
                <div class="manual-toc-title">章節目錄</div>
                <nav>
                    @foreach (var section in _visibleSections)
                    {
                        <a href="#@section.Id" class="manual-toc-link">
                            <span class="manual-toc-number">@section.Number</span>
                            <span>@section.Title</span>
                        </a>
                    }
                </nav>
            </aside>

            <main class="manual-content">
                @foreach (var section in _visibleSections)
                {
                    <article id="@section.Id" class="manual-section">
                        <div class="manual-section-heading">
                            <span class="manual-section-number">@section.Number</span>
                            <div>
                                <h2>@section.Title</h2>
                                <p>@section.Summary</p>
                            </div>
                        </div>

                        @if (section.Id == "test-report-versions")
                        {
                            <div class="manual-approval-flow" aria-label="檔案送審完整流程">
                                <section class="manual-workflow" aria-labelledby="approval-submit-title">
                                    <h3 id="approval-submit-title">4.1 檔案送審流程</h3>
                                    <p>一般 Engineer 在原 Project、Case、Task 或對應功能上傳需主管審核的檔案後，提交會進入待審核。主管在「主管待審」核准或退回；核准完成後，回到原功能頁查看正式檔案；退回後，Engineer 從「我的提交項目」查看原因並重新送審修正版。</p>
                                    <p>測試報告從既有 Task 上傳：尚無報告時在 FILE UPLOAD 點「上傳測試報告」，已有報告時從 TEST REPORT VERSIONS 點「上傳新版」。待審中的新版不會取代目前正式版本。</p>
                                    <div class="manual-workflow-figures">
                                        @foreach (var figure in ReportReviewFigures.Take(2))
                                        {
                                            <figure class="manual-figure manual-workflow-figure">
                                                @if (IsManualImageAvailable(figure.ImageUrl))
                                                {
                                                    <button type="button" class="manual-figure-button" @onclick="() => OpenFigure(figure)">
                                                        <img src="@figure.ImageUrl" alt="@figure.ImageAlt" loading="lazy" />
                                                        <span class="manual-figure-zoom">放大查看</span>
                                                    </button>
                                                }
                                                <figcaption><strong>@figure.Title</strong><span>@figure.Caption</span></figcaption>
                                            </figure>
                                        }
                                    </div>
                                </section>

                                <section class="manual-workflow" aria-labelledby="approval-engineer-title">
                                    <h3 id="approval-engineer-title">4.2 一般使用者：我的項目 → 我的提交項目</h3>
                                    <p>一般 Engineer 從側邊欄「我的項目」→「我的提交項目」進入。頁面提供「待審核」和「已退回」兩個 Tabs；Team Leader／Admin 的側邊欄不顯示此入口。</p>
                                    <h4>待審核：查看與撤回</h4>
                                    <ol>
                                        <li>切換至「待審核」，查看本人已送出、主管尚未處理的項目。欄位依序為「來源、項目、檔案、提交時間、操作」。</li>
                                        <li>點項目名稱可回到原 CSIT 項目；點檔名可查看或下載提交檔案。畫面不另設「查看／下載」按鈕。</li>
                                        <li>主管尚未處理前，可在操作欄點「撤回」；撤回後，該項目不再等待主管審核。</li>
                                    </ol>
                                    <div class="manual-workflow-figures manual-workflow-figures-single">
                                        @foreach (var figure in ReportReviewFigures.Skip(4).Take(1))
                                        {
                                            <figure class="manual-figure manual-workflow-figure">
                                                @if (IsManualImageAvailable(figure.ImageUrl))
                                                {
                                                    <button type="button" class="manual-figure-button" @onclick="() => OpenFigure(figure)">
                                                        <img src="@figure.ImageUrl" alt="@figure.ImageAlt" loading="lazy" />
                                                        <span class="manual-figure-zoom">放大查看</span>
                                                    </button>
                                                }
                                                <figcaption><strong>@figure.Title</strong><span>@figure.Caption</span></figcaption>
                                            </figure>
                                        }
                                    </div>

                                    <h4>已退回：查看退回原因與後續處理</h4>
                                    <ol>
                                        <li>切換至「已退回」，查看被主管退回、仍待本人處理的提交。欄位依序為「來源、項目、檔案、退回原因、提交時間、操作」；主管填寫的退回原因直接顯示在清單。</li>
                                        <li>點項目名稱可回原頁，點檔名可下載提交檔案。操作欄提供「重新上傳」與「移除」。</li>
                                        <li>點「移除」只會從本人目前待處理清單移除該項目，不會刪除正式資料。</li>
                                    </ol>
                                    <div class="manual-workflow-figures manual-workflow-figures-single">
                                        @foreach (var figure in ReportReviewFigures.Skip(5).Take(1))
                                        {
                                            <figure class="manual-figure manual-workflow-figure">
                                                @if (IsManualImageAvailable(figure.ImageUrl))
                                                {
                                                    <button type="button" class="manual-figure-button" @onclick="() => OpenFigure(figure)">
                                                        <img src="@figure.ImageUrl" alt="@figure.ImageAlt" loading="lazy" />
                                                        <span class="manual-figure-zoom">放大查看</span>
                                                    </button>
                                                }
                                                <figcaption><strong>@figure.Title</strong><span>@figure.Caption</span></figcaption>
                                            </figure>
                                        }
                                    </div>

                                    <h4>重新上傳修正版</h4>
                                    <ol>
                                        <li>在「已退回」點「重新上傳」，畫面會顯示原項目、主管退回原因與新檔案選擇欄位。</li>
                                        <li>選擇修正版檔案，點「重新送審」。可直接從此處重新提交，不必重新逐層尋找 Project、Case 或 Task。</li>
                                    </ol>
                                    <div class="manual-workflow-figures manual-workflow-figures-single">
                                        @foreach (var figure in ReportReviewFigures.Skip(6).Take(1))
                                        {
                                            <figure class="manual-figure manual-workflow-figure">
                                                @if (IsManualImageAvailable(figure.ImageUrl))
                                                {
                                                    <button type="button" class="manual-figure-button" @onclick="() => OpenFigure(figure)">
                                                        <img src="@figure.ImageUrl" alt="@figure.ImageAlt" loading="lazy" />
                                                        <span class="manual-figure-zoom">放大查看</span>
                                                    </button>
                                                }
                                                <figcaption><strong>@figure.Title</strong><span>@figure.Caption</span></figcaption>
                                            </figure>
                                        }
                                    </div>
                                </section>

                                <section class="manual-workflow" aria-labelledby="approval-supervisor-title">
                                    <h3 id="approval-supervisor-title">4.3 主管：SUPERVISOR APPROVAL → 主管待審</h3>
                                    <p>Team Leader／Admin 從側邊欄「SUPERVISOR APPROVAL」→「主管待審」進入；一般 Engineer 的側邊欄不顯示此入口。</p>
                                    <ol>
                                        <li>使用畫面上方的來源 Tabs 切換不同送審來源。清單顯示目前可由您審核的項目，欄位依序為「操作、項目、檔案、提交者、提交時間、狀態」。</li>
                                        <li>點項目名稱可回原 Project、Case、Task 或對應功能頁；點檔名可查看或下載提交檔案。操作欄提供「核准」與「退回」。</li>
                                    </ol>
                                    <div class="manual-workflow-figures manual-workflow-supervisor-figures">
                                        @foreach (var figure in ReportReviewFigures.Skip(2).Take(2).Reverse())
                                        {
                                            <figure class="manual-figure manual-workflow-figure">
                                                @if (IsManualImageAvailable(figure.ImageUrl))
                                                {
                                                    <button type="button" class="manual-figure-button" @onclick="() => OpenFigure(figure)">
                                                        <img src="@figure.ImageUrl" alt="@figure.ImageAlt" loading="lazy" />
                                                        <span class="manual-figure-zoom">放大查看</span>
                                                    </button>
                                                }
                                                <figcaption><strong>@figure.Title</strong><span>@figure.Caption</span></figcaption>
                                            </figure>
                                        }
                                    </div>
                                    <h4>核准</h4>
                                    <p>確認內容正確後，點操作欄的「核准」。該提交會進入正式資料流程；完成後不再出現在待處理清單，正式檔案可回原 Project、Case、Task 或對應功能頁查看。</p>
                                    <h4>退回</h4>
                                    <p>點操作欄的「退回」，輸入退回原因後點「確認退回」；退回原因不可空白。完成後，該項目不再是主管目前待處理項目。Engineer 可到「我的項目」→「我的提交項目」→「已退回」查看原因，並直接重新上傳修正版。</p>
                                </section>

                                <section class="manual-workflow manual-workflow-outcome" aria-labelledby="approval-outcome-title">
                                    <h3 id="approval-outcome-title">4.4 核准／退回後</h3>
                                    <p>核准完成 → 提交成為正式資料 → 回原功能頁查看。退回 → Engineer 在「已退回」查看退回原因 → 選擇修正版並重新送審。待審或退回的測試報告新版不會改變目前正式版本。</p>
                                </section>
                            </div>
                        }
                        else
                        {
                        <div class="manual-section-grid">
                            <section class="manual-panel">
                                <h3>操作步驟</h3>
                                <ol class="manual-steps">
                                    @foreach (var step in section.Steps)
                                    {
                                        <li>@step</li>
                                    }
                                </ol>
                            </section>

                            <section class="manual-panel manual-rules">
                                <h3>系統規則</h3>
                                <ul>
                                    @foreach (var rule in section.Rules)
                                    {
                                        <li>@rule</li>
                                    }
                                </ul>
                            </section>
                        </div>

                        @if (section.Figures.Count > 0)
                        {
                            <div class="manual-figures">
                                @foreach (var figure in section.Figures)
                                {
                                    var imageAvailable = IsManualImageAvailable(figure.ImageUrl);
                                    <figure class="manual-figure">
                                        @if (imageAvailable)
                                        {
                                            <button type="button" class="manual-figure-button" @onclick="() => OpenFigure(figure)">
                                                <img src="@figure.ImageUrl" alt="@figure.ImageAlt" loading="lazy" />
                                                <span class="manual-figure-zoom">放大查看</span>
                                            </button>
                                        }
                                        <figcaption>
                                            <strong>@figure.Title</strong>
                                            <span>@figure.Caption</span>
                                        </figcaption>
                                    </figure>
                                }
                            </div>
                        }

                        }

                        @if (section.Notes.Count > 0)
                        {
                            <section class="manual-notes">
                                <h3>注意事項</h3>
                                <ul>
                                    @foreach (var note in section.Notes)
                                    {
                                        <li>@note</li>
                                    }
                                </ul>
                            </section>
                        }
                    </article>
                }
            </main>
        </div>
    }
</div>

@if (_lightboxFigure is not null)
{
    <div class="manual-lightbox" role="dialog" aria-modal="true" aria-label="@_lightboxFigure.Title"
         tabindex="0" autofocus @onkeydown="HandleLightboxKeyDown" @onclick="CloseFigure">
        <button type="button" class="manual-lightbox-close" @onclick:stopPropagation="true" @onclick="CloseFigure" aria-label="關閉圖片">×</button>
        <figure class="manual-lightbox-content" @onclick:stopPropagation="true">
            <img src="@_lightboxFigure.ImageUrl" alt="@_lightboxFigure.ImageAlt" />
            <figcaption>
                <strong>@_lightboxFigure.Title</strong>
                <span>@_lightboxFigure.Caption</span>
            </figcaption>
        </figure>
    </div>
}

