    private sealed record ManualSection(
        string Id,
        string Number,
        string Title,
        string Summary,
        IReadOnlyList<string> Steps,
        IReadOnlyList<string> Rules,
        IReadOnlyList<string> Notes,
        string Keywords)
    {
        public IReadOnlyList<ManualFigure> Figures => Id switch
        {
            "reservation-application" => ReservationFigures,
            "project-case-task" => ProjectCaseTaskFigures,
            "test-report-versions" => ReportReviewFigures,
            "settings-data" => SystemOptionsFigures,
            "test-environment" => TestEnvironmentFigures,
            "roles-permissions" => AccountManagementFigures,
            "asset-management" => EquipmentFigures,
            _ => []
        };
    }
