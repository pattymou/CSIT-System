@page "/help/manual"
@attribute [Authorize(Policy = SystemAuthorization.Policies.CsitStaff)]
@using SIT.DepartmentSystem.Web.Services.Manuals
@using SIT.DepartmentSystem.Web.Services.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@inject IMenuManagementService MenuService
@inject AuthenticationStateProvider AuthProvider
@inject IAuthorizationService AuthorizationService

<PageTitle>CSIT 操作手冊</PageTitle>
<HeadContent><link rel="stylesheet" href="/css/manual-v2.css" /></HeadContent>
<div class="manual-page">
    <section class="manual-hero" aria-labelledby="manual-title">
        <div class="manual-hero-copy"><div class="manual-eyebrow">SYSTEM HELP / MANUAL</div>
            <h1 id="manual-title">CSIT 操作手冊</h1>
            <p class="manual-subtitle">依目前左側選單查找功能與操作方式</p>
            <p class="manual-intro">選單的群組、名稱、順序與可見範圍直接取自目前登入帳號的側欄；章節內容逐項說明實際操作及限制。</p>
        </div><div class="manual-hero-mark" aria-hidden="true">?</div>
    </section>
    <div class="manual-toolbar"><label class="manual-search"><span class="visually-hidden">搜尋操作說明</span>
        <span class="manual-search-icon" aria-hidden="true">⌕</span>
        <input @bind="_search" @bind:event="oninput" placeholder="搜尋功能、步驟或規則" />
        @if (!string.IsNullOrWhiteSpace(_search)) { <button type="button" class="manual-clear" @onclick="() => _search = string.Empty" aria-label="清除搜尋">×</button> }
    </label><div class="manual-result-count">@VisibleGroups.Sum(x => x.Entries.Count) 個功能章節</div></div>

    @if (_missing.Count > 0)
    {
        <div class="manual-coverage-warning" role="alert">手冊內容待補齊：@string.Join("、", _missing)。請通知系統管理員。</div>
    }
    <div class="manual-layout">
        <aside class="manual-toc" aria-label="操作手冊章節目錄">
            <div class="manual-toc-title">章節目錄</div>
            <nav><a href="#manual-introduction" class="manual-toc-link @(_active == "manual-introduction" ? "selected" : "")" @onclick="ActivateIntro">登入與登出</a>
                @foreach (var group in VisibleGroups)
                {
                    <div class="manual-toc-group">@group.Icon @group.Name</div>
                    @foreach (var item in group.Entries)
                    {
                        var anchor = Anchor(item.Route);
                        <a href="#@anchor" class="manual-toc-link @(_active == anchor ? "selected" : "")" aria-current="@(_active == anchor ? "location" : null)" @onclick="() => _active = anchor">@item.Title</a>
                    }
                }
            </nav>
        </aside>
        <main class="manual-content">
            <section id="manual-introduction" class="manual-introduction">
                <h2>登入與登出</h2>
                <p>使用核發的內部帳號登入；完成工作後按右上角「登出」。如需再次使用，從已登出頁面選「重新登入」。帳號權限或 Team 責任變更後，重新登入以取得最新可用功能。</p>
                <figure class="manual-figure"><a href="/api/manual/assets/internal/identity-login.png" target="_blank" rel="noopener noreferrer"><img src="/api/manual/assets/internal/identity-login.png" alt="內部登入畫面" loading="lazy" /></a><figcaption>內部登入畫面；點圖查看原尺寸。</figcaption></figure>
                <figure class="manual-figure"><a href="/api/manual/assets/shared/signed-out.png" target="_blank" rel="noopener noreferrer"><img src="/api/manual/assets/shared/signed-out.png" alt="已登出頁面" loading="lazy" /></a><figcaption>已登出畫面；點圖查看原尺寸。</figcaption></figure>
            </section>
            @{ var chapterNumber = 0; }
            @foreach (var group in VisibleGroups)
            {
                <h2 class="manual-group-heading">@group.Icon @group.Name</h2>
                @foreach (var item in group.Entries)
                {
                    <ManualChapter Anchor="@Anchor(item.Route)" Number="@((++chapterNumber).ToString())" GroupName="@group.Name" Title="@item.Title" Topic="@ManualContent.Internal[item.Route]" />
                }
            }
            @if (VisibleGroups.Count == 0) { <p class="manual-empty">找不到符合搜尋條件的功能。請修改關鍵字。</p> }
        </main>
    </div>
</div>

@code {
    private IReadOnlyList<SidebarGroup> _groups = [];
    private readonly List<string> _missing = [];
    private string _search = string.Empty;
    private string _active = "manual-introduction";

    private IReadOnlyList<SidebarGroup> VisibleGroups => _groups
        .Select(g => new SidebarGroup(g.Code, g.Name, g.Icon, g.Entries.Where(e =>
            ManualContent.Internal.ContainsKey(e.Route) &&
            (string.IsNullOrWhiteSpace(_search) || g.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || e.Title.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || ManualContent.Internal[e.Route].Purpose.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || ManualContent.Internal[e.Route].Steps.Any(s => s.Heading.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || s.Body.Contains(_search, StringComparison.OrdinalIgnoreCase)))).ToList()))
        .Where(g => g.Entries.Count > 0).ToList();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        _groups = (await SidebarCatalog.LoadAsync(MenuService, AuthorizationService, auth.User))
            .Select(g => new SidebarGroup(g.Code, g.Name, g.Icon,
                g.Entries.Where(e => SidebarCatalog.IsOperationalRoute(e.Route)).ToList()))
            .Where(g => g.Entries.Count > 0).ToList();
        _missing.AddRange(_groups.SelectMany(x => x.Entries)
            .Where(x => !ManualContent.Internal.ContainsKey(x.Route)).Select(x => x.Title));
    }

    private static string Anchor(string route) => "manual-" + route.Trim('/').Replace('/', '-');
    private void ActivateIntro() => _active = "manual-introduction";
}
