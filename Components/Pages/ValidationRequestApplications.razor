@page "/validation-request-applications"
@rendermode InteractiveServer
@attribute [Authorize(Policy = SystemAuthorization.Policies.CsitStaff)]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using SIT.DepartmentSystem.Web.Entities
@using SIT.DepartmentSystem.Web.Models.Api
@inject IVerificationWorkManagementService Work
@inject IVerificationApplicationService Applications
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Nav

<PageTitle>驗證申請專區</PageTitle>
<h3 class="page-title">驗證申請專區</h3>

@if (_error is not null) { <div class="surface-card error-text">@_error</div> }
else if (_loading) { <div class="surface-card">載入中...</div> }
else
{
    <div class="surface-card">
        <div class="case-card-head"><div><div class="case-kicker">MODEL MANAGEMENT</div><h2>Model Name 整案管理</h2></div></div>
        <div class="project-table-wrap"><table class="project-table">
            <thead><tr><th>Model Name</th><th>申請編號</th><th>Project Name</th><th>申請人</th><th>Product Type</th><th>預計結束</th><th>狀態</th><th>進度</th></tr></thead>
            <tbody>
            @if (_work.Count == 0) { <tr><td colspan="8" class="empty-row">目前沒有已核准的驗證案件。</td></tr> }
            @foreach (var item in _work)
            {
                <tr class="clickable-row" @onclick="() => OpenWork(item.RecordId)">
                    <td><strong>@Display(item.ModelName)</strong></td><td>@item.ApplicationNo</td><td>@item.ProjectName</td>
                    <td>@item.ApplicantName</td><td>@Display(item.ProductType)</td><td>@DisplayDate(item.ExpectedEndDate)</td>
                    <td><span class="record-status-pill">@item.Status</span>@if (item.RequiresSetupReview) { <div class="error-text">歷史資料：待確認工作項目</div> }</td>
                    <td>@item.CompletedTasks / @item.TotalTasks (@item.Progress%)</td>
                </tr>
            }
            </tbody>
        </table></div>
    </div>

    <div class="surface-card">
        <div class="case-card-head"><div><div class="case-kicker">APPLICATION WORKFLOW</div><h2>申請流程紀錄</h2></div></div>
        <div class="project-table-wrap"><table class="project-table">
            <thead><tr><th>申請編號</th><th>Model Name</th><th>申請人</th><th>申請日期</th><th>審核狀態</th></tr></thead>
            <tbody>
            @if (_applications.Count == 0) { <tr><td colspan="5" class="empty-row">目前沒有已送出的驗證申請。</td></tr> }
            @foreach (var item in _applications)
            {
                <tr class="clickable-row" @onclick="() => OpenApplication(item.Id)">
                    <td><strong>@item.ApplicationNo</strong></td><td>@Display(item.ProductModel)</td><td>@item.ApplicantName</td>
                    <td>@FormatDate(item.SubmittedAt)</td><td><span class="record-status-pill">@StatusText(item.Status)</span></td>
                </tr>
            }
            </tbody>
        </table></div>
    </div>
}

@code {
    private IReadOnlyList<VerificationWorkListItemDto> _work = [];
    private List<VerificationApplicationDto> _applications = [];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            var workTask = Work.ListAsync();
            var applicationsTask = Applications.ListForCsitAsync(user, 1, 200);
            await Task.WhenAll(workTask, applicationsTask);
            _work = await workTask;
            _applications = (await applicationsTask).Items.ToList();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }
    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private static string DisplayDate(DateOnly? value) => value?.ToString("yyyy-MM-dd") ?? "—";
    private static string FormatDate(DateTime? value) => value?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—";
    private static string StatusText(VerificationApplicationStatus status) => status switch
    {
        VerificationApplicationStatus.Submitted => "待審核", VerificationApplicationStatus.Returned => "已退回",
        VerificationApplicationStatus.Rejected => "已拒絕", VerificationApplicationStatus.Accepted => "已接受", _ => status.ToString()
    };
    private void OpenWork(Guid id) => Nav.NavigateTo($"/validation-request-applications/work/{id}");
    private void OpenApplication(Guid id) => Nav.NavigateTo($"/validation-request-applications/{id}");
}
