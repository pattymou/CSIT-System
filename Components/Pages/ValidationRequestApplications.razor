@page "/validation-request-applications"
@rendermode InteractiveServer
@attribute [Authorize(Policy = SystemAuthorization.Policies.CsitStaff)]
@using Microsoft.AspNetCore.Authorization
@using SIT.DepartmentSystem.Web.Models.Api
@inject IVerificationWorkManagementService Work
@inject NavigationManager Nav

<PageTitle>驗證申請專區</PageTitle>
<h3 class="page-title">驗證申請專區</h3>

<nav class="status-tabs" role="tablist" aria-label="驗證案件狀態">
    @foreach (var status in Statuses)
    {
        <button type="button" role="tab" class="status-tab @(_selectedStatus == status ? "is-active" : "")"
                aria-selected="@(_selectedStatus == status)" @onclick="() => _selectedStatus = status">@status</button>
    }
</nav>

@if (_error is not null) { <div class="surface-card error-text">@_error</div> }
else if (_loading) { <div class="surface-card">載入中...</div> }
else
{
    <section class="dashboard-card table-card" aria-label="驗證案件列表">
        <div class="project-table-wrap">
            <table class="project-table validation-work-table">
                <colgroup>
                    <col class="model-column" /><col class="application-column" /><col class="project-column" />
                    <col class="applicant-column" /><col class="product-column" /><col class="date-column" />
                    <col class="status-column" /><col class="progress-column" />
                </colgroup>
                <thead><tr><th>Model Name</th><th>申請編號</th><th>Project Name</th><th>申請人</th><th>Product Type</th><th>預計結束日期</th><th>狀態</th><th>進度</th></tr></thead>
                <tbody>
                @if (FilteredWork.Count == 0)
                {
                    <tr><td colspan="8" class="empty-row">目前沒有 @_selectedStatus 狀態的驗證案件。</td></tr>
                }
                @foreach (var item in FilteredWork)
                {
                    <tr class="clickable-row" @onclick="() => OpenWork(item.RecordId)">
                        <td><a href="@($"/validation-request-applications/work/{item.RecordId}")" class="work-model-link">@Display(item.ModelName)</a></td>
                        <td>@item.ApplicationNo</td><td>@Display(item.ProjectName)</td><td>@item.ApplicantName</td>
                        <td>@Display(item.ProductType)</td><td>@DisplayDate(item.ExpectedEndDate)</td>
                        <td><span class="record-status-pill">@item.Status</span>@if (item.RequiresSetupReview) { <div class="error-text">歷史資料：待確認工作項目</div> }</td>
                        <td>@item.CompletedTasks / @item.TotalTasks (@item.Progress%)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}

@code {
    private static readonly string[] Statuses = ["Open", "Close", "Hold"];
    private IReadOnlyList<VerificationWorkListItemDto> _work = [];
    private string _selectedStatus = "Open";
    private bool _loading = true;
    private string? _error;
    private IReadOnlyList<VerificationWorkListItemDto> FilteredWork =>
        _work.Where(item => string.Equals(item.Status, _selectedStatus, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync()
    {
        try { _work = await Work.ListAsync(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private static string DisplayDate(DateOnly? value) => value?.ToString("yyyy-MM-dd") ?? "—";
    private void OpenWork(Guid id) => Nav.NavigateTo($"/validation-request-applications/work/{id}");
}
