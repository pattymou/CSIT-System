@page "/validation-request-applications/work/{RecordId:guid}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = SystemAuthorization.Policies.CsitStaff)]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using global::System.Text.Json
@using SIT.DepartmentSystem.Web.Entities
@using SIT.DepartmentSystem.Web.Models.Api
@using SIT.DepartmentSystem.Web.Services.ValidationRequests
@inject BrowserApiClient Api
@inject IVerificationApplicationService Applications
@inject IValidationRequestConfigurationService ValidationService
@inject ISystemOptionService SystemOptions
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAuthorizationService AuthorizationService
@inject NavigationManager Navigation

<PageTitle>驗證案件資訊</PageTitle>
<nav class="work-breadcrumb" aria-label="頁面導覽">
    <a href="/validation-request-applications">驗證申請專區</a><span>›</span><span>案件資訊</span>
</nav>
<h3 class="page-title">驗證案件資訊</h3>

@if (_error is not null) { <div class="surface-card error-text">@_error</div> }
else if (_loading) { <div class="surface-card">載入中...</div> }
else if (_item is not null)
{
    @if (_canViewDeletion)
    {
        <div class="work-delete-entry">
            <button type="button" class="btn-secondary" disabled="@_previewLoading" @onclick="LoadDeletionPreviewAsync">刪除案件</button>
            <small>先查看精確範圍；確認後案件即凍結，KM 清理驗證完成後才能清理本地資料。</small>
        </div>
    }
    @if (_deleteError is not null) { <div class="surface-card error-text" role="alert">@_deleteError</div> }
    @if (_deletePreview is not null)
    {
        <section class="surface-card work-delete-preview" aria-label="案件刪除預檢">
            <div class="work-delete-heading"><h4>案件刪除預檢</h4><button type="button" class="btn-secondary" @onclick="CloseDeletionPreview">關閉</button></div>
            <p>申請編號 @_deletePreview.ApplicationNo；ApplicationId @_deletePreview.ApplicationId；RecordId @_deletePreview.RecordId</p>
            <div class="work-delete-reasons">
                @foreach (var reason in _deletePreview.BlockingReasons) { <p>@reason</p> }
            </div>
            <div class="work-delete-counts">
                @foreach (var group in _deletePreview.Items.GroupBy(x => x.Kind).OrderBy(x => x.Key))
                {
                    <span>@group.Key：@group.Count()</span>
                }
            </div>
            <div class="work-delete-table-wrap">
                <table class="work-delete-table">
                    <thead><tr><th>類型／名稱</th><th>精確識別</th><th>狀態／儲存</th></tr></thead>
                    <tbody>
                        @foreach (var entry in _deletePreview.Items)
                        {
                            <tr>
                                <td><strong>@entry.Kind</strong><br />@entry.Name</td>
                                <td><small>Id @entry.Id</small>
                                    @if (entry.ParentId is not null) { <small>Parent @entry.ParentId</small> }
                                    @if (entry.DocumentId is not null) { <small>Document @entry.DocumentId</small> }
                                    @if (entry.Version is not null) { <small>Version @entry.Version</small> }
                                </td>
                                <td>@(entry.Status ?? "—")
                                    @if (entry.StorageArea is not null) { <small>@entry.StorageArea</small> }
                                    @if (entry.Kind.StartsWith("Physical", StringComparison.Ordinal)) { <small>實體檔案：@(entry.PhysicalExists is null ? "無法確認" : entry.PhysicalExists.Value ? "存在" : "未找到")</small> }
                                    @if (entry.KmJobId is not null) { <small>KM Job @entry.KmJobId</small> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_deletePreview.CanExecute)
            {
                <div class="form-actions">
                    <label>刪除原因 <input @bind="_deleteReason" maxlength="500" /></label>
                    <label>再次輸入申請編號 <input @bind="_deleteApplicationNo" /></label>
                    <label><input type="checkbox" @bind="_deleteAcknowledged" /> 我已核對上列案件與文件，確認凍結此案件。</label>
                    <button type="button" class="btn-primary" disabled="@(!CanConfirmDeletion)" @onclick="ConfirmDeletionAsync">@(_deletionWorking ? "處理中..." : "確認凍結案件")</button>
                </div>
            }
            else if (_deletePreview.DeletionStatus is "LocalReady" or "KmVerified")
            {
                <p>文件刪除條件已確認。本地清理需由管理員執行。</p>
                @if (_deletePreview.ExecutionEnabled && _canCleanup)
                {
                    <label><input type="checkbox" @bind="_cleanupAcknowledged" /> 我再次確認要清理此案件的本地資料與檔案。</label>
                    <button type="button" class="btn-primary" disabled="@(!_cleanupAcknowledged || _deletionWorking)" @onclick="CleanLocalAsync">開始本地清理</button>
                }
            }
            else if (_deletePreview.DeletionStatus == "WaitingForKm")
            {
                <p>案件已凍結，等待 KM 刪除完成及七項清理驗證。</p>
            }
        </section>
    }
    <section class="surface-card work-summary" aria-label="案件資訊">
        <div><span>Model Name</span><strong>@Display(_item.ModelName)</strong></div>
        <div><span>申請編號</span><strong>@_item.ApplicationNo</strong></div>
        <div><span>Project Name</span><strong>@Display(_item.ProjectName)</strong></div>
        <div><span>申請人</span><strong>@Display(_item.ApplicantName)</strong></div>
        <div><span>Product Type</span><strong>@Display(_item.ProductType)</strong></div>
        <div><span>預計結束日期</span><strong>@(_item.ExpectedEndDate?.ToString("yyyy-MM-dd") ?? "—")</strong></div>
        <div class="work-status-control">
            <span>整案狀態</span>
            @if (_canManage)
            {
                <div class="work-status-edit">
                    <select aria-label="整案狀態" @bind="_recordStatus" @bind:after="ClearStatusMessages" disabled="@_saving">
                        <option>Open</option><option>Hold</option><option disabled="@(!CanClose)">Close</option>
                    </select>
                    <button type="button" class="btn-primary" disabled="@(!CanSaveStatus)" @onclick="SaveRecordStatusAsync">@(_saving ? "儲存中..." : "儲存狀態")</button>
                </div>
                @if (_statusError is not null) { <small class="error-text" role="alert">@_statusError</small> }
                @if (_statusSuccess is not null) { <small class="work-status-success" role="status">@_statusSuccess</small> }
                @if (!CanClose) { <small class="work-status-hint">所有測試項目均為 Close 後才能結案。</small> }
            }
            else { <strong class="record-status-pill">@_item.Status</strong> }
        </div>
    </section>

    @if (_application?.ValidationRequest?.FormSnapshot is not null)
    {
        @if (_editing && _editPreview is not null)
        {
            <div class="work-notice">修改產品類型、Team 或測試項目會影響現有工作；已有指派、執行或報告的工作不可直接移除或改寫參數。</div>
            <ValidationRequestPreview Preview="_editPreview" ProductTypes="_productTypes"
                                      SelectedProductCode="_selectedProduct" SelectedProductCodeChanged="ChangeProductAsync"
                                      Values="_values" SelectedTestItemCodes="_selectedTests"
                                      TestParameterValues="_testParameters" DepartmentOptions="_departments"
                                      AttachmentApplicationId="_application.Id" />
            <div class="form-actions">
                <button type="button" class="btn-primary" disabled="@_working" @onclick="SaveAcceptedAsync">儲存核准後修改</button>
                <button type="button" class="btn-secondary" disabled="@_working" @onclick="CancelEdit">取消</button>
            </div>
        }
        else
        {
            @if (_canManage)
            {
                <div class="form-actions"><button type="button" class="btn-secondary" @onclick="BeginEdit">修改案件內容</button></div>
            }
            <ValidationRequestSubmissionView Submission="_application.ValidationRequest" ApplicationId="_application.Id"
                                             ExpandSections="true" ShowHeader="false" />
        }
    }
    else
    {
        <div class="work-notice">原申請表單快照缺失，無法呈現產品資訊。</div>
    }

    @if (_item.SnapshotMessage is not null)
    {
        <div class="surface-card work-notice">@_item.SnapshotMessage</div>
    }
    else
    {
        <section class="surface-card work-items" aria-label="測試項目">
            <h4>測試項目</h4>
            @if (_itemActionError is not null) { <div class="error-text" role="alert">@_itemActionError</div> }
            <div class="work-item-list">
                @foreach (var selected in _item.SelectedTestItems)
                {
                    @if (selected.TaskId is Guid taskId)
                    {
                        <a class="work-item-row" href="@TaskHref(taskId)">
                            <span class="work-item-copy"><small>@selected.Category</small><strong>@selected.Name</strong></span>
                            <span class="work-item-state @TaskStatusClass(selected.TaskStatus)">@selected.TaskStatus</span><span aria-hidden="true">›</span>
                        </a>
                    }
                    else if (_canManage && !_blockedItemCodes.Contains(selected.Code))
                    {
                        <button type="button" class="work-item-row work-item-button" disabled="@(_openingItemCode is not null)" @onclick="() => OpenSelectedAsync(selected)">
                            <span class="work-item-copy"><small>@selected.Category</small><strong>@selected.Name</strong></span>
                            <span class="work-item-state">@(_openingItemCode == selected.Code ? "建立中..." : "開啟工作")</span><span aria-hidden="true">›</span>
                        </button>
                    }
                    else
                    {
                        <a class="work-item-row" href="@ReadOnlyHref(selected)">
                            <span class="work-item-copy"><small>@selected.Category</small><strong>@selected.Name</strong></span>
                            <span class="work-item-state">尚未建立工作 · 唯讀</span><span aria-hidden="true">›</span>
                        </a>
                    }
                }
            </div>
        </section>
    }
    @if (_actionMessage is not null) { <div class="surface-card @(_actionError ? "error-text" : "")">@_actionMessage</div> }
}

@code {
    [Parameter] public Guid RecordId { get; set; }
    private VerificationWorkDetailDto? _item;
    private VerificationApplicationDto? _application;
    private ValidationRequestPreviewDto? _editPreview;
    private IReadOnlyList<ValidationProductTypeDto> _productTypes = [];
    private List<SystemOptionDto> _departments = [];
    private Dictionary<string, List<string>> _values = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _selectedTests = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, Dictionary<string, List<string>>> _testParameters = new(StringComparer.OrdinalIgnoreCase);
    private string _selectedProduct = string.Empty;
    private string _recordStatus = "Open";
    private bool _loading = true;
    private bool _saving;
    private bool _working;
    private bool _editing;
    private bool _canManage;
    private bool _canViewDeletion;
    private bool _canCleanup;
    private bool _deletionWorking;
    private bool _deleteAcknowledged;
    private bool _cleanupAcknowledged;
    private string _deleteReason = string.Empty;
    private string _deleteApplicationNo = string.Empty;
    private bool _previewLoading;
    private VerificationCaseDeletionPreviewDto? _deletePreview;
    private string? _deleteError;
    private string? _error;
    private string? _statusError;
    private string? _statusSuccess;
    private string? _itemActionError;
    private string? _openingItemCode;
    private readonly HashSet<string> _blockedItemCodes = new(StringComparer.OrdinalIgnoreCase);
    private string? _actionMessage;
    private bool _actionError;
    private static string TaskStatusClass(string? status) => status?.Trim().ToUpperInvariant() switch
    {
        "OPEN" => "task-status-badge task-status-open",
        "HOLD" => "task-status-badge task-status-hold",
        "CLOSE" => "task-status-badge task-status-close",
        _ => string.Empty
    };
    private bool CanClose => _item is { TotalTasks: > 0 } && _item.CompletedTasks == _item.TotalTasks;
    private bool CanSaveStatus => _canManage && !_saving && _item is not null &&
        !string.Equals(_recordStatus, _item.Status, StringComparison.OrdinalIgnoreCase) &&
        (_recordStatus != "Close" || CanClose);
    private bool CanConfirmDeletion => !_deletionWorking && _deletePreview?.CanExecute == true &&
        _deleteAcknowledged && _deleteReason.Trim().Length is >= 5 and <= 500 &&
        string.Equals(_deleteApplicationNo.Trim(), _deletePreview.ApplicationNo, StringComparison.Ordinal);

    protected override Task OnParametersSetAsync() => ReloadAsync();
    private async Task ReloadAsync()
    {
        try
        {
            _error = null;
            _canManage = false;
            _canViewDeletion = false;
            _canCleanup = false;
            _application = null;
            _blockedItemCodes.Clear();
            _deletePreview = null;
            _item = await Api.GetOptionalAsync<VerificationWorkDetailDto>($"/api/verification-work/{RecordId}");
            if (_item is null) { _error = "找不到已核准的驗證案件。"; return; }
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            _application = await Applications.GetForCsitAsync(_item.ApplicationId, user);
            if (_application is null) { _error = "找不到原申請單。"; return; }
            _canViewDeletion = await Applications.CanManageAcceptedAsync(_application.Id, user);
            _canManage = _canViewDeletion && (_item.DeletionStatus is null or "Prepared");
            _canCleanup = (await AuthorizationService.AuthorizeAsync(user,
                SystemAuthorization.Policies.Administration)).Succeeded;
            _recordStatus = _item.Status;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }
    private async Task SaveRecordStatusAsync()
    {
        if (!CanSaveStatus) return;
        _saving = true;
        _statusError = null;
        _statusSuccess = null;
        try
        {
            var response = await Api.PutJsonAsync($"/api/verification-work/{RecordId}/status",
                new UpdateVerificationWorkStatusRequest { Status = _recordStatus });
            response.EnsureSuccess();
            await ReloadAsync();
            _statusSuccess = "整案狀態已更新。";
        }
        catch (Exception ex) { _statusError = ex.Message; }
        finally { _saving = false; }
    }
    private void ClearStatusMessages() { _statusError = null; _statusSuccess = null; }

    private async Task LoadDeletionPreviewAsync()
    {
        if (!_canViewDeletion || _previewLoading) return;
        _previewLoading = true;
        _deleteError = null;
        try
        {
            _deletePreview = await Api.GetAsync<VerificationCaseDeletionPreviewDto>(
                $"/api/verification-work/{RecordId}/deletion-preview");
        }
        catch (Exception ex) { _deleteError = ex.Message; }
        finally { _previewLoading = false; }
    }

    private void CloseDeletionPreview() { _deletePreview = null; _deleteError = null; }

    private async Task ConfirmDeletionAsync()
    {
        if (!CanConfirmDeletion) return;
        _deletionWorking = true; _deleteError = null;
        try
        {
            var response = await Api.PostJsonAsync(
                $"/api/verification-work/{RecordId}/deletion-preview/confirm",
                new { ApplicationNo = _deleteApplicationNo.Trim(), Reason = _deleteReason.Trim() });
            response.EnsureSuccess();
            _deleteAcknowledged = false;
            await ReloadAsync();
            await LoadDeletionPreviewAsync();
        }
        catch (Exception ex) { _deleteError = ex.Message; }
        finally { _deletionWorking = false; }
    }

    private async Task CleanLocalAsync()
    {
        if (!_canCleanup || !_cleanupAcknowledged || _deletionWorking) return;
        _deletionWorking = true; _deleteError = null;
        try
        {
            var response = await Api.PostJsonAsync(
                $"/api/verification-work/{RecordId}/deletion-preview/cleanup", new { });
            response.EnsureSuccess();
            Navigation.NavigateTo("/validation-request-applications");
        }
        catch (Exception ex) { _deleteError = ex.Message; }
        finally { _deletionWorking = false; }
    }
    private string TaskHref(Guid taskId) => $"/validation-request-applications/work/{RecordId}/tasks/{taskId}";
    private string ReadOnlyHref(SelectedVerificationTestItemDto item) =>
        $"/validation-request-applications/work/{RecordId}/selected/{Uri.EscapeDataString(item.Code)}";

    private async Task OpenSelectedAsync(SelectedVerificationTestItemDto item)
    {
        if (!_canManage || item.TaskId is not null || _openingItemCode is not null) return;
        _openingItemCode = item.Code;
        _itemActionError = null;
        try
        {
            var response = await Api.PostJsonAsync(
                $"/api/verification-work/{RecordId}/selected/{Uri.EscapeDataString(item.Code)}/enable", new { });
            response.EnsureSuccess();
            var result = JsonSerializer.Deserialize<EnableSelectedWorkResponse>(response.Body,
                new JsonSerializerOptions(JsonSerializerDefaults.Web));
            if (result is null || result.TaskId == Guid.Empty)
                throw new InvalidOperationException("伺服器未回傳有效的測試工作。");
            Navigation.NavigateTo(TaskHref(result.TaskId));
        }
        catch (BrowserApiException ex) when (ex.StatusCode is 403 or 409)
        {
            _blockedItemCodes.Add(item.Code);
            _itemActionError = ex.Message;
        }
        catch (Exception ex) { _itemActionError = ex.Message; }
        finally { _openingItemCode = null; }
    }
    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private async Task BeginEdit()
    {
        if (!_canManage || _application?.ValidationRequest?.FormSnapshot is null) return;
        _working = true; _actionMessage = null;
        try
        {
            var configuration = await ValidationService.GetConfigurationAsync();
            _productTypes = configuration.ProductTypes;
            _departments = (await SystemOptions.GetEnabledByCategoryAsync(SystemOptionCategories.Department)).ToList();
            InitializeEditor(_application.ValidationRequest);
            _editing = true;
        }
        catch (Exception ex) { _actionError = true; _actionMessage = ex.Message; }
        finally { _working = false; }
    }

    private void InitializeEditor(ValidationRequestSubmissionDto request)
    {
        _selectedProduct = request.ProductTypeCode;
        _editPreview = request.FormSnapshot;
        _values = request.FieldValues.ToDictionary(x => x.Key, x => x.Value.ToList(), StringComparer.OrdinalIgnoreCase);
        _selectedTests = new(request.SelectedTestItemCodes, StringComparer.OrdinalIgnoreCase);
        _testParameters = request.TestParameterValues.ToDictionary(x => x.Key,
            x => x.Value.ToDictionary(y => y.Key, y => y.Value.ToList(), StringComparer.OrdinalIgnoreCase),
            StringComparer.OrdinalIgnoreCase);
    }

    private void CancelEdit()
    {
        _editing = false; _actionMessage = null;
        if (_application?.ValidationRequest is not null) InitializeEditor(_application.ValidationRequest);
    }

    private async Task ChangeProductAsync(string code)
    {
        if (_application?.ValidationRequest is null || string.IsNullOrWhiteSpace(code) || code == _selectedProduct) return;
        _working = true; _actionMessage = null;
        try
        {
            _editPreview = await ValidationService.GetPreviewAsync(_application.ValidationRequest.TemplateVersionId, code);
            _selectedProduct = code;
            var fieldCodes = _editPreview.Sections.SelectMany(x => x.Fields).SelectMany(FlattenFields)
                .Select(x => x.Code).ToHashSet(StringComparer.OrdinalIgnoreCase);
            _values = _values.Where(x => fieldCodes.Contains(x.Key))
                .ToDictionary(x => x.Key, x => x.Value, StringComparer.OrdinalIgnoreCase);
            _values["PRODUCT_TYPE"] = [code];
            var testCodes = _editPreview.TestCategories.SelectMany(x => x.TestItems)
                .Select(x => x.Code).ToHashSet(StringComparer.OrdinalIgnoreCase);
            _selectedTests.RemoveWhere(x => !testCodes.Contains(x));
            _testParameters = _testParameters.Where(x => testCodes.Contains(x.Key))
                .ToDictionary(x => x.Key, x => x.Value, StringComparer.OrdinalIgnoreCase);
        }
        catch (Exception ex) { _actionError = true; _actionMessage = ex.Message; }
        finally { _working = false; }
    }

    private async Task SaveAcceptedAsync()
    {
        if (_application is null || _editPreview is null || !_canManage) return;
        _working = true; _actionMessage = null;
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            await Applications.UpdateAcceptedAsync(_application.Id, user, new UpdateVerificationApplicationRequest
            {
                ValidationRequest = new ValidationRequestSubmissionDto
                {
                    TemplateVersionId = _editPreview.TemplateVersionId,
                    TemplateVersion = _editPreview.TemplateVersion,
                    ProductTypeCode = _editPreview.ProductTypeCode,
                    FieldValues = _values,
                    SelectedTestItemCodes = _selectedTests,
                    TestParameterValues = _testParameters,
                    FormSnapshot = _editPreview
                }
            });
            _editing = false;
            await ReloadAsync();
            _actionError = false;
            _actionMessage = "案件內容已儲存，修改紀錄已保留。";
        }
        catch (Exception ex) { _actionError = true; _actionMessage = ex.Message; }
        finally { _working = false; }
    }

    private static IEnumerable<ValidationFieldDto> FlattenFields(ValidationFieldDto field)
    {
        yield return field;
        foreach (var child in field.Children.SelectMany(FlattenFields)) yield return child;
    }
}
