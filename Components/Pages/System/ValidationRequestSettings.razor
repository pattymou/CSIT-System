@page "/validation-request-settings"
@attribute [Authorize(Policy = SystemAuthorization.Policies.Administration)]
@rendermode InteractiveServer
@using SIT.DepartmentSystem.Web.Services.ValidationRequests
@inject IValidationRequestConfigurationService ValidationService
@inject AuthenticationStateProvider AuthProvider
@inject IAuthorizationService AuthorizationService
@inject IBusinessWriteAuthorizationGuard WriteGuard

<PageTitle>驗證申請單設定</PageTitle>
<style>
    .check-list label { justify-content:flex-start!important; text-align:left!important; }
    .editor-section input[type="checkbox"] { width:16px!important; height:16px!important; min-height:0!important; }
    .check-list label > input { flex:0 0 16px; margin:3px 0 0; }
    .check-list label > span { flex:1; min-width:0; }
    .condition-no-value { color:#94a3b8; font-size:.78rem; }
</style>

<header class="settings-header">
    <div><span class="settings-eyebrow">ADMINISTRATION</span><h1>驗證申請單設定</h1><p>設定產品類型、申請欄位與測試項目。</p></div>
    @if (_configuration is not null)
    {
        <div class="version-summary"><span>目前版本 <strong>V@_configuration.Version.VersionNumber</strong></span><span>狀態 <strong>@ValidationRequestPresentation.TemplateStatus(_configuration.Version.Status)</strong></span></div>
    }
</header>

@if (_error is not null) { <div class="alert alert-danger">@_error</div> }
@if (_message is not null) { <div class="alert alert-success">@_message</div> }
@if (_configuration is null) { <div class="settings-loading">正在載入設定…</div> }
else
{
    <nav class="settings-tabs" role="tablist" aria-label="驗證申請單設定">
        @foreach (var tab in Tabs) { <button type="button" role="tab" class="@(_tab == tab ? "active" : null)" @onclick="() => _tab = tab">@tab</button> }
    </nav>

    <main class="settings-surface">
        @switch (_tab)
        {
            case "產品類型":
                <section class="settings-panel">
                    <div class="panel-heading"><div><h2>產品類型</h2><p>設定每種產品適用的表單區塊與測試項目類別。</p></div><button class="primary-btn" disabled="@(!_canWrite)" @onclick="OpenNewProduct">＋ 新增產品類型</button></div>
                    <div class="responsive-table"><table class="product-type-table"><thead><tr><th>產品類型</th><th>顯示表單區塊</th><th>測試項目類別</th><th>狀態</th><th>操作</th></tr></thead><tbody>
                    @foreach (var p in _configuration.ProductTypes.OrderBy(x => x.DisplayOrder))
                    {
                        <tr><td><strong>@p.DisplayLabel</strong><small class="table-code">@p.Code</small></td><td><div class="tag-list">@foreach (var label in SectionLabels(p)) { <span class="mapping-tag">@label</span> }</div></td><td><div class="tag-list">@foreach (var label in CategoryLabels(p)) { <span class="mapping-tag category">@label</span> }</div></td><td><span class="status-pill @(p.IsEnabled ? "enabled" : "disabled")">@ValidationRequestPresentation.Enabled(p.IsEnabled)</span></td><td><button class="text-btn table-action" data-testid="edit-product-@p.Code" aria-label="編輯 @p.DisplayLabel" disabled="@(!_canWrite)" @onclick="() => OpenProduct(p)">編輯</button></td></tr>
                    }
                    </tbody></table></div>
                </section>
                break;
            case "表單欄位":
                <section class="settings-panel">
                    <div class="panel-heading"><div><h2>表單欄位</h2><p>設定各產品資訊區塊中的欄位、選項、必填與顯示條件。</p></div>
                        <label class="compact-control"><span>表單區塊</span><select @bind="_sectionId">@foreach (var s in _configuration.Sections.OrderBy(x => x.DisplayOrder)) { <option value="@s.Id">@s.DisplayLabel</option> }</select></label>
                    </div>
                    @if (CurrentSection is { } selectedSection)
                    {
                        @foreach (var group in ValidationRequestPresentation.Groups(selectedSection))
                        {
                            <div class="field-group">
                                <div class="group-heading"><h3>@group.Label</h3><button class="text-btn" disabled="@(!_canWrite)" @onclick="() => OpenNewField(selectedSection, group)">＋ 新增欄位</button></div>
                                <div class="responsive-table"><table><thead><tr><th>欄位名稱</th><th>欄位代碼</th><th>欄位類型</th><th>必填</th><th>選項</th><th>條件</th><th>狀態</th><th>操作</th></tr></thead><tbody>
                                @foreach (var f in group.Fields)
                                {
                                    <tr><td><strong>@f.DisplayLabel</strong><small class="table-code">@selectedSection.DisplayLabel</small></td><td><code class="field-code">@f.Code</code></td><td>@ValidationRequestPresentation.FieldType(f.FieldType)</td><td>@ValidationRequestPresentation.Required(f.IsRequired)</td><td>@(f.Options.Count == 0 ? "—" : $"{f.Options.Count} 個選項")</td><td>@(f.Conditions.Count == 0 ? "—" : $"{f.Conditions.Count} 個條件")</td><td><span class="status-pill @(f.IsEnabled ? "enabled" : "disabled")">@ValidationRequestPresentation.Enabled(f.IsEnabled)</span></td><td><button class="text-btn table-action" data-testid="edit-field-@f.Code" aria-label="編輯 @f.DisplayLabel" disabled="@(!_canWrite)" @onclick="() => OpenField(f)">編輯</button></td></tr>
                                }
                                @if (group.Fields.Count == 0) { <tr><td colspan="8" class="empty-cell">尚未設定欄位</td></tr> }
                                </tbody></table></div>
                            </div>
                        }
                    }
                </section>
                break;
            case "測試項目":
                <section class="settings-panel">
                    <div class="panel-heading"><div><h2>測試項目</h2><p>設定各測試類別中的測試項目與測試參數。</p></div><button class="primary-btn" disabled="@(!_canWrite)" @onclick="OpenNewItem">＋ 新增測試項目</button></div>
                    <div class="category-tabs">@foreach (var c in _configuration.TestCategories.OrderBy(x => x.DisplayOrder)) { <button class="@(_categoryId == c.Id ? "active" : null)" @onclick="() => _categoryId = c.Id">@ValidationRequestPresentation.CategoryLabel(c)</button> }</div>
                    @if (CurrentCategory is { } category)
                    {
                        <div class="responsive-table"><table><thead><tr><th>測試類別</th><th>測試項目</th><th>必填／選填</th><th>參數數量</th><th>狀態</th><th>順序</th><th>操作</th></tr></thead><tbody>
                        @foreach (var item in category.TestItems.OrderBy(x => x.DisplayOrder))
                        {
                            <tr><td><span class="category-code">@category.Code</span><small class="table-code">@category.DisplayLabel</small></td><td><strong>@item.DisplayLabel</strong><small class="table-code">@item.Code</small></td><td>@(item.IsMandatory ? "必填" : "選填")</td><td>@item.Parameters.Count</td><td><span class="status-pill @(item.IsEnabled ? "enabled" : "disabled")">@ValidationRequestPresentation.Enabled(item.IsEnabled)</span></td><td>@item.DisplayOrder</td><td><button class="text-btn table-action" data-testid="edit-item-@item.Code" aria-label="編輯 @item.DisplayLabel" disabled="@(!_canWrite)" @onclick="() => OpenItem(item)">編輯</button></td></tr>
                        }
                        </tbody></table></div>
                    }
                </section>
                break;
            case "表單預覽":
                <section class="settings-panel">
                    <div class="panel-heading"><div><h2>表單預覽</h2><p>確認產品類型所對應的申請表單與測試項目。</p></div>
                        <label class="compact-control"><span>產品類型</span><select @bind="_previewProduct" @bind:after="LoadPreview">@foreach (var p in _configuration.ProductTypes.Where(x => x.IsEnabled).OrderBy(x => x.DisplayOrder)) { <option value="@p.Code">@p.DisplayLabel</option> }</select></label>
                    </div>
                    <ValidationRequestPreview Preview="_preview" ProductTypes="_configuration.ProductTypes" ShowPreviewBadge="true" />
                </section>
                break;
        }
    </main>
}

@if (_productEditor)
{
    <div class="editor-backdrop" @onclick="CloseEditors"><aside class="editor-drawer" role="dialog" aria-modal="true" aria-label="編輯產品類型" @onclick:stopPropagation>
        <div class="drawer-heading"><div><span>產品類型</span><h2>@(_editingProductId is null ? "新增產品類型" : "編輯產品類型")</h2></div><button class="icon-btn" @onclick="CloseEditors" aria-label="關閉">×</button></div>
        <div class="editor-section"><h3>基本設定</h3><label>名稱<input @bind="_productLabel" /></label><div class="editor-grid"><label class="toggle-label"><input type="checkbox" @bind="_productEnabled" /> 啟用</label><label>顯示順序<input type="number" @bind="_productOrder" /></label></div></div>
        <div class="editor-section"><h3>適用表單區塊</h3><div class="check-list">@foreach (var s in _configuration!.Sections.OrderBy(x => x.DisplayOrder)) { <label><input type="checkbox" checked="@(_productSections.Contains(s.Id) || s.AlwaysVisible)" disabled="@s.AlwaysVisible" @onchange="e => SetSelection(_productSections, s.Id, e)" /><span>@s.DisplayLabel @if (s.AlwaysVisible) { <small>所有產品類型固定顯示</small> }</span></label> }</div></div>
        <div class="editor-section"><h3>適用測試項目類別</h3><div class="check-list">@foreach (var c in _configuration!.TestCategories.OrderBy(x => x.DisplayOrder)) { <label><input type="checkbox" checked="@(_productCategories.Contains(c.Id) || c.AlwaysVisible)" disabled="@c.AlwaysVisible" @onchange="e => SetSelection(_productCategories, c.Id, e)" /><span>@ValidationRequestPresentation.CategoryLabel(c) @if (c.AlwaysVisible) { <small>所有產品類型固定顯示</small> }</span></label> }</div></div>
        <div class="drawer-actions"><button class="secondary-btn" @onclick="CloseEditors">取消</button><button class="primary-btn" @onclick="SaveProduct">儲存</button></div>
    </aside></div>
}

@if (_fieldEditor)
{
    <div class="editor-backdrop" @onclick="CloseEditors"><aside class="editor-drawer wide" role="dialog" aria-modal="true" aria-label="編輯欄位" @onclick:stopPropagation>
        <div class="drawer-heading"><div><span>表單欄位</span><h2>@(_editingFieldId is null ? "新增欄位" : "編輯欄位")</h2></div><button class="icon-btn" @onclick="CloseEditors">×</button></div>
        <div class="editor-section"><h3>基本設定</h3><label>欄位名稱<input @bind="_fieldLabel" /></label><div class="editor-grid"><label>欄位類型<select @bind="_fieldType">@foreach (var t in ValidationRequestPresentation.FieldTypeLabels) { <option value="@t.Key">@t.Value</option> }</select></label><label>顯示順序<input type="number" @bind="_fieldOrder" /></label><label class="toggle-label"><input type="checkbox" @bind="_fieldRequired" /> 必填</label><label class="toggle-label"><input type="checkbox" @bind="_fieldEnabled" /> 啟用</label></div><label>說明<textarea @bind="_fieldHelp"></textarea></label></div>
        @if (HasOptions(_fieldType))
        {
            <div class="editor-section"><div class="section-title-row"><h3>選項內容</h3><button class="text-btn" @onclick="ResetOption">＋ 新增選項</button></div>
                <div class="mini-form"><input @bind="_optionLabel" placeholder="顯示文字" /><input type="number" @bind="_optionOrder" aria-label="選項順序" /><label><input type="checkbox" @bind="_optionEnabled" /> 啟用</label><button class="secondary-btn" @onclick="SaveOption">@(_editingOptionId is null ? "新增" : "儲存")</button></div>
                <div class="compact-list">@foreach (var o in EditingFieldOptions) { <div><span><strong>@o.DisplayLabel</strong><small>順序 @o.DisplayOrder · @ValidationRequestPresentation.Enabled(o.IsEnabled)</small></span><button class="text-btn" @onclick="() => EditOption(o)">編輯</button><button class="danger-text" @onclick="() => DeleteOption(o.Id)">刪除</button></div> }</div>
            </div>
        }
        <div class="editor-section"><h3>顯示條件</h3><p class="section-help">以欄位值決定此欄位是否顯示或變為必填。</p>
            <div class="condition-builder"><span>當</span><select @bind="_conditionSource">@foreach (var f in SectionFields.Where(x => x.Id != _editingFieldId)) { <option value="@f.Code">@f.DisplayLabel</option> }</select><select @bind="_conditionOperator">@foreach (var o in Operators) { <option value="@o.Code">@o.Label</option> }</select>
                @if (_conditionOperator is "IsTrue" or "IsFalse") { <span class="condition-no-value">不需設定值</span> }
                else if (ConditionSourceField?.Options.Count > 0) { <select @bind="_conditionValue"><option value="">請選擇</option>@foreach (var option in ConditionSourceField.Options.Where(x => x.IsEnabled)) { <option value="@option.ValueCode">@option.DisplayLabel</option> }</select> }
                else { <input @bind="_conditionValue" placeholder="條件值" /> }
            </div>
            <div class="condition-actions"><span>時：</span><label><input type="checkbox" @bind="_conditionVisible" /> 顯示此欄位</label><label><input type="checkbox" @bind="_conditionRequired" /> 此欄位設為必填</label><button class="secondary-btn" disabled="@(_editingFieldId is null)" @onclick="AddConditions">新增條件</button></div>
            <div class="compact-list">@foreach (var c in EditingField?.Conditions ?? []) { <div><span>@ConditionSentence(c)</span><button class="danger-text" @onclick="() => DeleteCondition(c.Id)">刪除</button></div> }</div>
        </div>
        <div class="drawer-actions"><button class="secondary-btn" @onclick="CloseEditors">取消</button><button class="primary-btn" @onclick="SaveField">儲存基本設定</button></div>
    </aside></div>
}

@if (_itemEditor)
{
    <div class="editor-backdrop" @onclick="CloseEditors"><aside class="editor-drawer wide" role="dialog" aria-modal="true" aria-label="編輯測試項目" @onclick:stopPropagation>
        <div class="drawer-heading"><div><span>測試項目</span><h2>@(_editingItemId is null ? "新增測試項目" : "編輯測試項目")</h2></div><button class="icon-btn" @onclick="CloseEditors">×</button></div>
        <div class="editor-section"><h3>基本設定</h3><label>測試項目名稱<input @bind="_itemLabel" /></label><div class="editor-grid"><label>所屬類別<select @bind="_itemCategoryId">@foreach (var c in _configuration!.TestCategories) { <option value="@c.Id">@ValidationRequestPresentation.CategoryLabel(c)</option> }</select></label><label>顯示順序<input type="number" @bind="_itemOrder" /></label><label class="toggle-label"><input type="checkbox" @bind="_itemMandatory" /> 必填</label><label class="toggle-label"><input type="checkbox" @bind="_itemEnabled" /> 啟用</label></div><label>說明<textarea @bind="_itemDescription"></textarea></label></div>
        <div class="editor-section"><h3>測試參數</h3>
            <div class="mini-form"><input @bind="_parameterLabel" placeholder="參數名稱" /><select @bind="_parameterType">@foreach (var t in ParameterTypes) { <option value="@t">@ValidationRequestPresentation.FieldType(t)</option> }</select><label><input type="checkbox" @bind="_parameterRequired" /> 必填</label><input type="number" @bind="_parameterOrder" aria-label="參數順序" /><button class="secondary-btn" disabled="@(_editingItemId is null)" @onclick="SaveParameter">@(_editingParameterId is null ? "新增" : "儲存")</button></div>
            <div class="compact-list">@foreach (var p in EditingItemParameters) { <div><span><strong>@p.DisplayLabel</strong><small>@ValidationRequestPresentation.FieldType(p.FieldType) · @ValidationRequestPresentation.Required(p.IsRequired) · @p.Options.Count 個選項</small></span><button class="text-btn" @onclick="() => EditParameter(p)">編輯</button></div> }</div>
        </div>
        <div class="drawer-actions"><button class="secondary-btn" @onclick="CloseEditors">取消</button><button class="primary-btn" @onclick="SaveItem">儲存基本設定</button></div>
    </aside></div>
}

@code {
    private static readonly string[] Tabs = ["產品類型", "表單欄位", "測試項目", "表單預覽"];
    private static readonly (string Code, string Label)[] Operators = [("Equals", "等於"), ("NotEquals", "不等於"), ("Contains", "包含"), ("NotContains", "不包含"), ("IsTrue", "已勾選"), ("IsFalse", "未勾選")];
    private static readonly string[] ParameterTypes = ["Text", "TextArea", "Number", "Dropdown", "SingleSelect", "MultiSelect", "Checkbox", "Group", "RepeatableGroup"];
    private ValidationRequestConfigurationDto? _configuration; private ValidationRequestPreviewDto? _preview;
    private string _tab = Tabs[0]; private bool _canWrite; private string? _error; private string? _message;
    private Guid _sectionId; private Guid _categoryId; private string _previewProduct = "";

    private bool _productEditor; private Guid? _editingProductId; private string _productCode = ""; private string _productLabel = ""; private bool _productEnabled = true; private int _productOrder = 100; private HashSet<Guid> _productSections = []; private HashSet<Guid> _productCategories = [];
    private bool _fieldEditor; private Guid? _editingFieldId; private string _fieldCode = ""; private Guid _fieldSectionId; private string _fieldLabel = ""; private string _fieldType = "Text"; private int _fieldOrder = 100; private bool _fieldRequired; private bool _fieldEnabled = true; private string? _fieldHelp; private string? _fieldDataSource;
    private Guid? _editingOptionId; private string _optionLabel = ""; private bool _optionEnabled = true; private int _optionOrder = 100;
    private string _conditionSource = ""; private string _conditionOperator = "Equals"; private string _conditionValue = ""; private bool _conditionVisible = true; private bool _conditionRequired;
    private bool _itemEditor; private Guid? _editingItemId; private string _itemCode = ""; private Guid _itemCategoryId; private string _itemLabel = ""; private string? _itemDescription; private bool _itemMandatory; private bool _itemEnabled = true; private int _itemOrder = 100;
    private Guid? _editingParameterId; private string _parameterCode = ""; private string _parameterLabel = ""; private string _parameterType = "Text"; private bool _parameterRequired; private bool _parameterEnabled = true; private int _parameterOrder = 100;

    private ValidationSectionDto? CurrentSection => _configuration?.Sections.FirstOrDefault(x => x.Id == _sectionId);
    private ValidationTestCategoryDto? CurrentCategory => _configuration?.TestCategories.FirstOrDefault(x => x.Id == _categoryId);
    private ValidationFieldDto? EditingField => _configuration is null || _editingFieldId is null ? null : Flatten(_configuration.Sections.SelectMany(x => x.Fields)).FirstOrDefault(x => x.Id == _editingFieldId);
    private ValidationTestItemDto? EditingItem => _configuration?.TestCategories.SelectMany(x => x.TestItems).FirstOrDefault(x => x.Id == _editingItemId);
    private IEnumerable<ValidationOptionDto> EditingFieldOptions => EditingField?.Options.OrderBy(x => x.DisplayOrder) ?? Enumerable.Empty<ValidationOptionDto>();
    private IEnumerable<ValidationParameterDto> EditingItemParameters => EditingItem?.Parameters.OrderBy(x => x.DisplayOrder) ?? Enumerable.Empty<ValidationParameterDto>();
    private IReadOnlyList<ValidationFieldDto> SectionFields => CurrentFieldSection is null ? [] : Flatten(CurrentFieldSection.Fields).ToList();
    private ValidationSectionDto? CurrentFieldSection => _configuration?.Sections.FirstOrDefault(x => x.Id == _fieldSectionId);
    private ValidationFieldDto? ConditionSourceField => SectionFields.FirstOrDefault(x => x.Code == _conditionSource);

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        _canWrite = (await AuthorizationService.AuthorizeAsync(auth.User, SystemAuthorization.Policies.BusinessWrite)).Succeeded;
        await Reload();
    }

    private async Task Reload()
    {
        _configuration = await ValidationService.GetConfigurationAsync();
        if (_sectionId == Guid.Empty || _configuration.Sections.All(x => x.Id != _sectionId)) _sectionId = _configuration.Sections.First().Id;
        if (_categoryId == Guid.Empty || _configuration.TestCategories.All(x => x.Id != _categoryId)) _categoryId = _configuration.TestCategories.First().Id;
        if (string.IsNullOrWhiteSpace(_previewProduct)) _previewProduct = _configuration.ProductTypes.First(x => x.IsEnabled).Code;
        await LoadPreview(); _error = null;
    }

    private async Task Run(Func<Task> action, string message)
    {
        try { await WriteGuard.DemandAsync(); await action(); _message = message; _error = null; await Reload(); }
        catch (Exception ex) { _error = ex.Message; _message = null; }
    }

    private IEnumerable<string> SectionLabels(ValidationProductTypeDto p) => _configuration!.Sections.Where(x => x.AlwaysVisible || p.SectionIds.Contains(x.Id)).OrderBy(x => x.DisplayOrder).Select(ValidationRequestPresentation.SectionLabel);
    private IEnumerable<string> CategoryLabels(ValidationProductTypeDto p) => _configuration!.TestCategories.Where(x => x.AlwaysVisible || p.TestCategoryIds.Contains(x.Id)).OrderBy(x => x.DisplayOrder).Select(ValidationRequestPresentation.CategoryLabel);
    private void OpenNewProduct() { _editingProductId = null; _productCode = AutoCode("PRODUCT"); _productLabel = ""; _productEnabled = true; _productOrder = (_configuration?.ProductTypes.Max(x => x.DisplayOrder) ?? 90) + 10; _productSections = _configuration!.Sections.Where(x => x.AlwaysVisible).Select(x => x.Id).ToHashSet(); _productCategories = _configuration.TestCategories.Where(x => x.AlwaysVisible).Select(x => x.Id).ToHashSet(); _productEditor = true; }
    private void OpenProduct(ValidationProductTypeDto p) { _editingProductId = p.Id; _productCode = p.Code; _productLabel = p.DisplayLabel; _productEnabled = p.IsEnabled; _productOrder = p.DisplayOrder; _productSections = p.SectionIds.Concat(_configuration!.Sections.Where(x => x.AlwaysVisible).Select(x => x.Id)).ToHashSet(); _productCategories = p.TestCategoryIds.Concat(_configuration.TestCategories.Where(x => x.AlwaysVisible).Select(x => x.Id)).ToHashSet(); _productEditor = true; }
    private Task SaveProduct() => Run(async () => { var id = await ValidationService.SaveProductTypeAsync(_editingProductId, new(_productCode, _productLabel, _productEnabled, _productOrder)); await ValidationService.SetSectionMappingsAsync(id, _productSections.Where(id => !_configuration!.Sections.Single(x => x.Id == id).AlwaysVisible).ToList()); await ValidationService.SetCategoryMappingsAsync(id, _productCategories.Where(id => !_configuration!.TestCategories.Single(x => x.Id == id).AlwaysVisible).ToList()); _productEditor = false; }, "產品類型已儲存");

    private void OpenNewField(ValidationSectionDto section, ValidationFieldGroup group) { _editingFieldId = null; _fieldCode = AutoCode("FIELD"); _fieldSectionId = section.Id; _fieldLabel = ""; _fieldType = "Text"; _fieldOrder = SuggestedOrder(section, group); _fieldRequired = false; _fieldEnabled = true; _fieldHelp = null; _fieldDataSource = null; ResetOption(); ResetCondition(); _fieldEditor = true; }
    private void OpenField(ValidationFieldDto f) { _editingFieldId = f.Id; _fieldCode = f.Code; _fieldSectionId = f.SectionId; _fieldLabel = f.DisplayLabel; _fieldType = f.FieldType; _fieldOrder = f.DisplayOrder; _fieldRequired = f.IsRequired; _fieldEnabled = f.IsEnabled; _fieldHelp = f.HelpText; _fieldDataSource = f.DataSource; ResetOption(); ResetCondition(); _fieldEditor = true; }
    private Task SaveField() => Run(async () => { _editingFieldId = await ValidationService.SaveFieldAsync(_editingFieldId, new(_fieldSectionId, null, _fieldCode, _fieldLabel, _fieldHelp, null, _fieldType, _fieldRequired, _fieldEnabled, _fieldOrder, _fieldType == "SensitiveText", _fieldDataSource, null)); }, "欄位基本設定已儲存");
    private void ResetOption() { _editingOptionId = null; _optionLabel = ""; _optionEnabled = true; _optionOrder = (EditingField?.Options.MaxBy(x => x.DisplayOrder)?.DisplayOrder ?? 90) + 10; }
    private void EditOption(ValidationOptionDto o) { _editingOptionId = o.Id; _optionLabel = o.DisplayLabel; _optionEnabled = o.IsEnabled; _optionOrder = o.DisplayOrder; }
    private Task SaveOption() => _editingFieldId is null ? Task.CompletedTask : Run(async () => { await ValidationService.SaveOptionAsync(_editingFieldId.Value, _editingOptionId, new(_editingOptionId is null ? AutoCode("OPTION") : EditingField!.Options.Single(x => x.Id == _editingOptionId).ValueCode, _optionLabel, _optionEnabled, _optionOrder)); ResetOption(); }, "選項已儲存");
    private Task DeleteOption(Guid id) => Run(() => ValidationService.DeleteOptionAsync(id), "選項已刪除");
    private void ResetCondition() { _conditionSource = SectionFields.FirstOrDefault()?.Code ?? ""; _conditionOperator = "Equals"; _conditionValue = ""; _conditionVisible = true; _conditionRequired = false; }
    private Task AddConditions() => _editingFieldId is null ? Task.CompletedTask : Run(async () => { if (!_conditionVisible && !_conditionRequired) throw new InvalidOperationException("請至少選擇一個條件動作。"); var value = _conditionOperator is "IsTrue" or "IsFalse" ? null : _conditionValue; if (_conditionVisible) await ValidationService.SaveConditionAsync(_editingFieldId.Value, null, new(_conditionSource, _conditionOperator, value, "Visible")); if (_conditionRequired) await ValidationService.SaveConditionAsync(_editingFieldId.Value, null, new(_conditionSource, _conditionOperator, value, "Required")); }, "顯示條件已新增");
    private Task DeleteCondition(Guid id) => Run(() => ValidationService.DeleteConditionAsync(id), "顯示條件已刪除");
    private string ConditionSentence(ValidationConditionDto c) { var source = SectionFields.FirstOrDefault(x => x.Code == c.SourceFieldCode)?.DisplayLabel ?? c.SourceFieldCode; var op = Operators.FirstOrDefault(x => x.Code == c.Operator).Label ?? c.Operator; var action = c.Action == "Visible" ? "顯示此欄位" : "此欄位設為必填"; return $"當「{source}」{op}「{c.ExpectedValue}」時，{action}"; }

    private void OpenNewItem() { _editingItemId = null; _itemCode = AutoCode("TEST"); _itemCategoryId = _categoryId; _itemLabel = ""; _itemDescription = null; _itemMandatory = false; _itemEnabled = true; _itemOrder = (CurrentCategory?.TestItems.MaxBy(x => x.DisplayOrder)?.DisplayOrder ?? 90) + 10; ResetParameter(); _itemEditor = true; }
    private void OpenItem(ValidationTestItemDto i) { _editingItemId = i.Id; _itemCode = i.Code; _itemCategoryId = i.CategoryId; _itemLabel = i.DisplayLabel; _itemDescription = i.Description; _itemMandatory = i.IsMandatory; _itemEnabled = i.IsEnabled; _itemOrder = i.DisplayOrder; ResetParameter(); _itemEditor = true; }
    private Task SaveItem() => Run(async () => { _editingItemId = await ValidationService.SaveTestItemAsync(_editingItemId, new(_itemCategoryId, _itemCode, _itemLabel, _itemDescription, null, _itemMandatory, _itemEnabled, _itemOrder)); }, "測試項目已儲存");
    private void ResetParameter() { _editingParameterId = null; _parameterCode = AutoCode("PARAMETER"); _parameterLabel = ""; _parameterType = "Text"; _parameterRequired = false; _parameterEnabled = true; _parameterOrder = (EditingItem?.Parameters.MaxBy(x => x.DisplayOrder)?.DisplayOrder ?? 90) + 10; }
    private void EditParameter(ValidationParameterDto p) { _editingParameterId = p.Id; _parameterCode = p.Code; _parameterLabel = p.DisplayLabel; _parameterType = p.FieldType; _parameterRequired = p.IsRequired; _parameterEnabled = p.IsEnabled; _parameterOrder = p.DisplayOrder; }
    private Task SaveParameter() => _editingItemId is null ? Task.CompletedTask : Run(async () => { await ValidationService.SaveParameterAsync(_editingItemId.Value, _editingParameterId, new(null, _parameterCode, _parameterLabel, null, null, _parameterType, _parameterRequired, _parameterEnabled, _parameterOrder, null)); ResetParameter(); }, "測試參數已儲存");

    private async Task LoadPreview() { if (!string.IsNullOrWhiteSpace(_previewProduct)) _preview = await ValidationService.GetPreviewAsync(_previewProduct); }
    private void CloseEditors() { _productEditor = _fieldEditor = _itemEditor = false; }
    private static bool HasOptions(string type) => type is "Dropdown" or "SingleSelect" or "MultiSelect";
    private static void SetSelection(HashSet<Guid> selection, Guid id, ChangeEventArgs e) { if (e.Value is true || e.Value?.ToString() == "true") selection.Add(id); else selection.Remove(id); }
    private static string AutoCode(string prefix) => $"{prefix}_{Guid.NewGuid():N}"[..(prefix.Length + 9)].ToUpperInvariant();
    private static int SuggestedOrder(ValidationSectionDto section, ValidationFieldGroup group) { var values = group.Fields.Select(x => x.DisplayOrder).ToList(); if (values.Count > 0) return values.Max() + 1; return section.Code == "COMMON_PRODUCT_INFO" ? (group.Label.StartsWith("A.") ? 100 : group.Label.StartsWith("B.") ? 140 : group.Label.StartsWith("C.") ? 160 : 220) : group.Label.StartsWith("A.") ? 20 : 100; }
    private static IEnumerable<ValidationFieldDto> Flatten(IEnumerable<ValidationFieldDto> fields) { foreach (var field in fields) { yield return field; foreach (var child in Flatten(field.Children)) yield return child; } }
}
