@page "/my-submissions"
@page "/my-rejected-submissions"
@attribute [Authorize]
@rendermode InteractiveServer
@using SIT.DepartmentSystem.Web.Services.Approval
@using Microsoft.AspNetCore.Http
@inject ApprovalSubmissionService Submissions
@inject MySubmissionQueryService Query
@inject MySubmissionWorkspaceService Workspace
@inject AuthenticationStateProvider AuthProvider

<PageTitle>我的提交項目</PageTitle>
<h1>我的提交項目</h1>
<p class="page-subtitle">查看尚待主管處理的提交，以及需要重新處理的退回項目。</p>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="form-card @(_isError ? "error-text" : "")" role="status">@_message</div>
}

<nav class="my-submission-tabs" role="tablist" aria-label="我的提交分類">
    <button type="button" role="tab" class="my-submission-tab @(_selectedView == MySubmissionView.Pending ? "active" : "")"
            aria-selected="@(_selectedView == MySubmissionView.Pending)" @onclick="() => SelectTabAsync(MySubmissionView.Pending)">
        待審核 <span class="my-submission-count">@_counts.Pending</span>
    </button>
    <button type="button" role="tab" class="my-submission-tab @(_selectedView == MySubmissionView.Returned ? "active" : "")"
            aria-selected="@(_selectedView == MySubmissionView.Returned)" @onclick="() => SelectTabAsync(MySubmissionView.Returned)">
        已退回 <span class="my-submission-count">@_counts.Returned</span>
    </button>
</nav>

<section class="my-submission-panel" role="tabpanel">
    <div class="my-submission-panel-head">
        <h2>@(_selectedView == MySubmissionView.Pending ? "待審核" : "已退回")</h2>
        <button type="button" class="table-chip-btn" @onclick="RefreshAsync" disabled="@_busy">重新整理</button>
    </div>
    @if (_items.Count == 0)
    {
        <div class="record-empty-box">@(_selectedView == MySubmissionView.Pending ? "目前沒有待審核的提交。" : "目前沒有需要處理的退回項目。")</div>
    }
    else
    {
        <div class="project-table-wrap my-submission-table-wrap">
            <table class="project-table my-submission-table @(_selectedView == MySubmissionView.Pending ? "pending" : "rejected")">
                @if (_selectedView == MySubmissionView.Pending)
                {
                    <colgroup><col class="source" /><col class="context" /><col class="file" /><col class="uploader" /><col class="date" /><col class="action" /></colgroup>
                    <thead><tr><th>來源</th><th>項目</th><th>檔案</th><th>提交人</th><th>提交時間</th><th>操作</th></tr></thead>
                }
                else
                {
                    <colgroup><col class="source" /><col class="context" /><col class="file" /><col class="uploader" /><col class="reason" /><col class="date" /><col class="action" /></colgroup>
                    <thead><tr><th>來源</th><th>項目</th><th>檔案</th><th>提交人</th><th>退回原因</th><th>提交時間</th><th>操作</th></tr></thead>
                }
                <tbody>
                    @foreach (var item in _items)
                    {
                        <tr>
                            <td><span class="my-submission-source @(item.SourceKind == MySubmissionSourceKind.VerificationApplication ? "verification" : "document")">@item.SourceTitle</span></td>
                            <td title="@item.ItemLabel">
                                @if (item.ItemRoute is not null)
                                {
                                    <a class="my-submission-link" href="@item.ItemRoute">@item.ItemLabel</a>
                                }
                                else { @item.ItemLabel }
                            </td>
                            <td title="@item.FileLabel">
                                @if (item.FileDownloadRoute is not null)
                                {
                                    <a class="my-submission-link" href="@item.FileDownloadRoute">@item.FileLabel</a>
                                }
                                else { @item.FileLabel }
                            </td>
                            <td title="@item.SubmittedByAccount">@Display(item.SubmittedByAccount)</td>
                            @if (_selectedView == MySubmissionView.Returned)
                            {
                                <td class="my-submission-reason" title="@item.ReturnReason">@Display(item.ReturnReason)</td>
                            }
                            <td>@item.SubmittedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                            <td class="my-submission-actions">
                                @if (item.SourceKind == MySubmissionSourceKind.ApprovalSubmission)
                                {
                                    @if (_selectedView == MySubmissionView.Pending)
                                    {
                                        <button type="button" class="table-chip-btn danger" disabled="@_busy" @onclick="() => WithdrawAsync(item)">撤回</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="table-chip-btn" disabled="@_busy" @onclick="() => BeginResubmit(item)">重新上傳</button>
                                        <button type="button" class="table-chip-btn danger" disabled="@_busy" @onclick="() => DismissAsync(item)">移除</button>
                                    }
                                }
                                else if (item.ItemRoute is not null)
                                {
                                    <a class="table-chip-btn" href="@item.ItemRoute">@item.PrimaryActionLabel</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_totalCount > PageSize)
        {
            <nav class="my-submission-pagination" aria-label="我的提交項目分頁">
                <button type="button" class="table-chip-btn" disabled="@(_busy || _page <= 1)" @onclick="PreviousPageAsync">上一頁</button>
                <span>第 @_page / @TotalPages 頁，共 @_totalCount 筆</span>
                <button type="button" class="table-chip-btn" disabled="@(_busy || _page >= TotalPages)" @onclick="NextPageAsync">下一頁</button>
            </nav>
        }
    }
</section>

@if (_resubmitting is not null)
{
    <div class="my-submission-dialog-backdrop">
        <section class="my-submission-dialog" role="dialog" aria-modal="true" aria-labelledby="my-submission-dialog-title">
            <h2 id="my-submission-dialog-title">重新上傳</h2>
            <p><strong>項目：</strong>@_resubmitting.ItemLabel</p>
            <p><strong>退回原因：</strong>@Display(_resubmitting.ReturnReason)</p>
            @if (_isError && !string.IsNullOrWhiteSpace(_message))
            {
                <p class="error-text" role="alert">@_message</p>
            }
            <label for="my-submission-new-file">新檔案</label>
            <InputFile id="my-submission-new-file" OnChange="OnFileSelected" />
            <div class="my-submission-dialog-actions">
                <button type="button" class="table-chip-btn" disabled="@(_busy || _newFile is null)" @onclick="SubmitRevisionAsync">@(_busy ? "送審中…" : "重新送審")</button>
                <button type="button" class="table-chip-btn" disabled="@_busy" @onclick="CancelResubmit">取消</button>
            </div>
        </section>
    </div>
}

@code {
    private MySubmissionView _selectedView = MySubmissionView.Pending;
    private MySubmissionWorkspaceCounts _counts = new(0, 0);
    private List<MySubmissionWorkspaceItemDto> _items = [];
    private MySubmissionWorkspaceItemDto? _resubmitting;
    private const int PageSize = 50;
    private int _page = 1;
    private int _totalCount;
    private IBrowserFile? _newFile;
    private string? _message;
    private bool _isError;
    private bool _busy;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_totalCount / (double)PageSize));

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task SelectTabAsync(MySubmissionView view)
    {
        _selectedView = view;
        _page = 1;
        _message = null;
        await ReloadAsync();
    }

    private async Task PreviousPageAsync()
    {
        if (_page <= 1) return;
        _page--;
        await ReloadAsync();
    }

    private async Task NextPageAsync()
    {
        if (_page >= TotalPages) return;
        _page++;
        await ReloadAsync();
    }

    private async Task RefreshAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        try
        {
            var user = (await AuthProvider.GetAuthenticationStateAsync()).User;
            var result = await Query.ListAsync(user, _selectedView, _page, PageSize);
            if (_page > 1 && result.Items.Count == 0 && result.TotalCount > 0)
            {
                _page = Math.Max(1, (int)Math.Ceiling(result.TotalCount / (double)PageSize));
                result = await Query.ListAsync(user, _selectedView, _page, PageSize);
            }
            _counts = result.Counts;
            _totalCount = result.TotalCount;
            _items = result.Items.ToList();
        }
        catch { ShowError("無法載入提交項目，請稍後再試。"); }
    }

    private async Task WithdrawAsync(MySubmissionWorkspaceItemDto item)
    {
        if (item.SourceKind != MySubmissionSourceKind.ApprovalSubmission) return;
        _busy = true;
        try
        {
            var user = (await AuthProvider.GetAuthenticationStateAsync()).User;
            await Submissions.WithdrawMineAsync(item.Id, user);
            await ReloadAsync();
            ShowSuccess("已撤回送審。");
        }
        catch (InvalidOperationException ex) { ShowError(ex.Message); await ReloadAsync(); }
        catch (UnauthorizedAccessException) { ShowError("您無法撤回此提交。"); }
        catch { ShowError("撤回未完成，請重新整理頁面後再試。"); }
        finally { _busy = false; }
    }

    private async Task DismissAsync(MySubmissionWorkspaceItemDto item)
    {
        if (item.SourceKind != MySubmissionSourceKind.ApprovalSubmission) return;
        _busy = true;
        try
        {
            var user = (await AuthProvider.GetAuthenticationStateAsync()).User;
            await Submissions.DismissMineAsync(item.Id, user);
            await ReloadAsync();
            ShowSuccess("已從待處理清單移除。");
        }
        catch (InvalidOperationException ex) { ShowError(ex.Message); await ReloadAsync(); }
        catch (UnauthorizedAccessException) { ShowError("您無法移除此項目。"); }
        catch { ShowError("移除未完成，請重新整理頁面後再試。"); }
        finally { _busy = false; }
    }

    private void BeginResubmit(MySubmissionWorkspaceItemDto item)
    {
        if (item.SourceKind != MySubmissionSourceKind.ApprovalSubmission) return;
        _resubmitting = item;
        _newFile = null;
        _message = null;
    }

    private void CancelResubmit() { _resubmitting = null; _newFile = null; }
    private void OnFileSelected(InputFileChangeEventArgs e) => _newFile = e.File;

    private async Task SubmitRevisionAsync()
    {
        if (_resubmitting is null || _newFile is null) return;
        _busy = true;
        try
        {
            var user = (await AuthProvider.GetAuthenticationStateAsync()).User;
            await Workspace.ResubmitAsync(_resubmitting.Id, new BrowserSubmissionFile(_newFile), user);
            CancelResubmit();
            await ReloadAsync();
            ShowSuccess("修正版已重新送審。");
        }
        catch (InvalidOperationException ex) { ShowError(ex.Message); }
        catch (UnauthorizedAccessException) { ShowError("您無法重新送審此項目。"); }
        catch { ShowError("重新送審未完成，請確認檔案與原項目後再試。"); }
        finally { _busy = false; }
    }

    private void ShowError(string message) { _message = message; _isError = true; }
    private void ShowSuccess(string message) { _message = message; _isError = false; }
    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private sealed class BrowserSubmissionFile(IBrowserFile file) : IFormFile
    {
        public string ContentType { get; set; } = file.ContentType;
        public string ContentDisposition { get; set; } = string.Empty;
        public IHeaderDictionary Headers { get; set; } = new HeaderDictionary();
        public long Length => file.Size;
        public string Name => "file";
        public string FileName => file.Name;
        public Stream OpenReadStream() => file.OpenReadStream(200_000_000);
        public void CopyTo(Stream target) { using var stream = OpenReadStream(); stream.CopyTo(target); }
        public async Task CopyToAsync(Stream target, CancellationToken cancellationToken = default)
        {
            await using var stream = OpenReadStream();
            await stream.CopyToAsync(target, cancellationToken);
        }
    }
}
