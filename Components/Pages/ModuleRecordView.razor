@page "/modules/{moduleCode}/detail/{id:guid}"
@rendermode InteractiveServer
@using global::System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Nav

<div class="record-detail-page">
    <div class="record-detail-title-row">
        <div>
            <h1>主單詳細</h1>
            <p>PROJECT INFORMATION</p>
        </div>

        <div class="record-detail-actions">
            <button type="button" class="btn-primary" @onclick="EditRecord">修改主單</button>
            <button type="button" class="btn-primary" @onclick="CreateCase">新增 Case</button>
            <button type="button" class="btn-secondary" @onclick="BackToList">回列表</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="record-detail-card error-text">@_message</div>
    }

    @if (_record == null)
    {
        <div class="record-detail-card">Loading...</div>
    }
    else
    {
        <section class="record-detail-card">
            <div class="record-detail-card-head">
                <div>
                    <div class="record-detail-kicker">PROJECT INFORMATION</div>
                    <h2>@_record.Name</h2>
                </div>
                <span class="record-status-pill">@_record.Status</span>
            </div>

            <div class="record-detail-grid">
                <div class="record-detail-item"><span>Record No</span><strong>@_record.RecordNo</strong></div>
                <div class="record-detail-item"><span>專案名稱</span><strong>@Display(_record.Name)</strong></div>
                <div class="record-detail-item"><span>地點</span><strong>@Display(_record.Location)</strong></div>

                <div class="record-detail-item"><span>機種所屬 Sub-PU</span><strong>@Display(_record.SubPu)</strong></div>
                <div class="record-detail-item"><span>Team</span><strong>@Display(_record.Team)</strong></div>
                <div class="record-detail-item"><span>實驗室負責人</span><strong>@Display(_record.AssignOwner)</strong></div>

                <div class="record-detail-item"><span>Customer</span><strong>@Display(_record.Customer)</strong></div>
                <div class="record-detail-item"><span>PM / Sales</span><strong>@Display(_record.PmSales)</strong></div>
                <div class="record-detail-item"><span>Owner</span><strong>@Display(_record.Owner)</strong></div>

                <div class="record-detail-item"><span>S/W Engineer</span><strong>@Display(_record.SoftwareEngineer)</strong></div>
                <div class="record-detail-item"><span>H/W Engineer</span><strong>@Display(_record.HardwareEngineer)</strong></div>
                <div class="record-detail-item"><span>Mechanical Engineer</span><strong>@Display(_record.MechanicalEngineer)</strong></div>

                <div class="record-detail-item"><span>部門</span><strong>@Display(_record.Department)</strong></div>
                <div class="record-detail-item"><span>申請人</span><strong>@Display(_record.RequestApplicant)</strong></div>
                <div class="record-detail-item"><span>申請人部門</span><strong>@Display(_record.RequestDepartment)</strong></div>

                <div class="record-detail-item"><span>F/W Version</span><strong>@Display(_record.FirmwareVersion)</strong></div>
                <div class="record-detail-item"><span>Wireless Drive</span><strong>@Display(_record.WirelessDrive)</strong></div>
                <div class="record-detail-item"><span>Customer's Product Name</span><strong>@Display(_record.CustomerProductName)</strong></div>

                <div class="record-detail-item"><span>NPI</span><strong>@Display(_record.Npi)</strong></div>
                <div class="record-detail-item"><span>H/W Version</span><strong>@Display(_record.HardwareVersion)</strong></div>
                <div class="record-detail-item"><span>S/W Version</span><strong>@Display(_record.SoftwareVersion)</strong></div>

                <div class="record-detail-item"><span>Chipset</span><strong>@Display(_record.Chipset)</strong></div>
                <div class="record-detail-item"><span>Sample MAC Address</span><strong>@Display(_record.SampleMacAddress)</strong></div>
                <div class="record-detail-item"><span>Utility Version</span><strong>@Display(_record.UtilityVersion)</strong></div>

                <div class="record-detail-item"><span>DSP Model</span><strong>@Display(_record.DspModel)</strong></div>
                <div class="record-detail-item"><span>DQA 負責人</span><strong>@Display(_record.DqaOwner)</strong></div>
                <div class="record-detail-item"><span>PJM</span><strong>@Display(_record.Pjm)</strong></div>

                <div class="record-detail-item"><span>開始日期</span><strong>@DisplayDate(_record.StartDate)</strong></div>
                <div class="record-detail-item"><span>預計完成日期</span><strong>@DisplayDate(_record.ExpectedEndDate)</strong></div>
                <div class="record-detail-item"><span>預計 Sample Ready 日期</span><strong>@DisplayDate(_record.SampleReadyDate)</strong></div>

                <div class="record-detail-item"><span>結果判定</span><strong>@Display(_record.Result)</strong></div>
                <div class="record-detail-item"><span>狀態</span><strong>@Display(_record.Status)</strong></div>
                <div class="record-detail-item"><span>進度</span><strong>@_record.Progress%</strong></div>

                <div class="record-detail-item record-detail-full"><span>Jira Link</span><strong>@Display(_record.JiraLink)</strong></div>
                <div class="record-detail-item record-detail-full"><span>備註</span><strong>@Display(_record.Note)</strong></div>
                <div class="record-detail-item record-detail-full"><span>Applicant Note</span><strong>@Display(_record.ApplicantNote)</strong></div>
                <div class="record-detail-item record-detail-full"><span>知會人員</span><strong>@DisplayNotifyUsers(_record.NotifyUsers)</strong></div>
            </div>
        </section>

        <section class="record-detail-card">
            <div class="record-detail-card-head">
                <div>
                    <div class="record-detail-kicker">CASES</div>
                    <h2>Cases</h2>
                </div>
                <button type="button" class="btn-primary" @onclick="CreateCase">+ 新增 Case</button>
            </div>

            @if (_cases.Count == 0)
            {
                <div class="record-empty-box">
                    <strong>目前沒有 Case</strong>
                    <span>按上方「新增 Case」建立第一筆。</span>
                </div>
            }
            else
            {
                <div class="project-table-wrap">
                    <table class="project-table">
                        <thead>
                            <tr>
                                <th>Case No</th>
                                <th>Name</th>
                                <th>Status</th>
                                <th>操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _cases)
                            {
                                <tr class="clickable-row" @onclick="() => ViewCase(item.Id)">
                                    <td>@item.CaseNo</td>
                                    <td>@item.Name</td>
                                    <td>@item.Status</td>
                                    <td class="action-cell">
                                        <button type="button"
                                                class="table-chip-btn danger"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => DeleteCaseFromListAsync(item.Id)">
                                            刪除
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
</div>

@code {
    [Parameter] public string moduleCode { get; set; } = string.Empty;
    [Parameter] public Guid id { get; set; }

    private ModuleRecordDetailDto? _record;
    private List<ModuleCaseListItemDto> _cases = new();
    private string? _message;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _message = null;
        _record = await Http.GetFromJsonAsync<ModuleRecordDetailDto>($"/api/records/{id}");
        var caseResult = await Http.GetFromJsonAsync<ListResponseDto<ModuleCaseListItemDto>>($"/api/records/{id}/cases");
        _cases = caseResult?.Items ?? new();
    }

    private void EditRecord() => Nav.NavigateTo($"/modules/{moduleCode}/edit/{id}");
    private void CreateCase() => Nav.NavigateTo($"/modules/{moduleCode}/{id}/cases/new");
    private void ViewCase(Guid caseId) => Nav.NavigateTo($"/modules/{moduleCode}/{id}/cases/{caseId}");
    private void BackToList() => Nav.NavigateTo($"/modules/{moduleCode}");

    private async Task DeleteCaseFromListAsync(Guid caseId)
    {
        _message = null;

        var response = await Http.DeleteAsync($"/api/cases/{caseId}");

        if (response.IsSuccessStatusCode)
        {
            _cases.RemoveAll(x => x.Id == caseId);
            _message = "Case 已刪除。";
            return;
        }

        var error = await response.Content.ReadAsStringAsync();
        _message = $"刪除 Case 失敗：{response.StatusCode} {error}";
        Console.WriteLine($"[ModuleRecordView] Delete case failed: {response.StatusCode} {error}");
    }

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string DisplayDate(DateOnly? value)
    {
        return value?.ToString("yyyy/MM/dd") ?? "-";
    }

    private static string DisplayNotifyUsers(List<string>? users)
    {
        return users == null || users.Count == 0 ? "-" : string.Join(", ", users);
    }

    public class ModuleRecordDetailDto
    {
        public string RecordNo { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string? Customer { get; set; }
        public string? Owner { get; set; }
        public string? PmSales { get; set; }
        public string Status { get; set; } = string.Empty;
        public string? Result { get; set; }
        public int Progress { get; set; }

        public DateOnly? StartDate { get; set; }
        public DateOnly? ExpectedEndDate { get; set; }
        public DateOnly? SampleReadyDate { get; set; }

        public string? Note { get; set; }
        public string? ApplicantNote { get; set; }

        public string? Location { get; set; }
        public string? Team { get; set; }
        public string? Npi { get; set; }
        public string? HardwareVersion { get; set; }
        public string? SoftwareVersion { get; set; }
        public string? HardwareEngineer { get; set; }
        public string? SoftwareEngineer { get; set; }
        public string? Pjm { get; set; }

        public string? RequestDepartment { get; set; }
        public string? RequestApplicant { get; set; }

        public string? SubPu { get; set; }
        public string? AssignOwner { get; set; }
        public string? MechanicalEngineer { get; set; }
        public string? Department { get; set; }
        public string? FirmwareVersion { get; set; }
        public string? WirelessDrive { get; set; }
        public string? CustomerProductName { get; set; }
        public string? Chipset { get; set; }
        public string? SampleMacAddress { get; set; }
        public string? UtilityVersion { get; set; }
        public string? DspModel { get; set; }
        public string? DqaOwner { get; set; }
        public string? JiraLink { get; set; }
        public List<string> NotifyUsers { get; set; } = new();
    }

    public class ModuleCaseListItemDto
    {
        public Guid Id { get; set; }
        public string CaseNo { get; set; } = "";
        public string Name { get; set; } = "";
        public string Status { get; set; } = "";
    }

    public class ListResponseDto<T>
    {
        public List<T> Items { get; set; } = new();
        public int Page { get; set; }
        public int PageSize { get; set; }
        public int TotalCount { get; set; }
    }
}