@page "/documents"
@using SIT.DepartmentSystem.Web.Services
@rendermode InteractiveServer
@attribute [Authorize(Policy = SystemAuthorization.Policies.CsitStaff)]
@inject BrowserApiClient Api
@inject IDocumentLibraryService DocumentLibraryService
@inject AuthenticationStateProvider AuthProvider
@inject IAuthorizationService AuthorizationService

<PageTitle>文件專區</PageTitle>

@if (!string.IsNullOrWhiteSpace(_previewUrl))
{
    <div class="image-preview-backdrop" role="dialog" aria-modal="true" aria-label="圖片預覽" @onclick="ClosePreview">
        <div class="image-preview-dialog" @onclick:stopPropagation="true">
            <div class="image-preview-heading"><strong>@_previewName</strong><button type="button" @onclick="ClosePreview" aria-label="關閉預覽">×</button></div>
            <img src="@_previewUrl" alt="@_previewName" />
        </div>
    </div>
}

<div class="document-page">
    <header class="document-hero">
        <div>
            <div class="document-kicker">DOCUMENT LIBRARY</div>
            <h1>文件專區</h1>
            <p>依三層資料夾分類瀏覽、上傳與下載文件。</p>
        </div>
        <span class="document-scope">獨立文件庫</span>
    </header>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="document-message @(_isError ? "error" : "success")">@_message</div>
    }

    <div class="document-workspace">
        <aside class="document-tree-card">
            <h2>資料夾</h2>
            @if (_loading || _systemDocumentsLoading)
            {
                <div class="document-empty">載入中...</div>
            }
            else if (!_folders.Any(x => !x.IsSystemManaged) && _systemDocumentCatalog.Folders.Count == 0)
            {
                <div class="document-empty">尚未建立文件資料夾。</div>
            }
            else
            {
                <div class="document-tree">
                    @foreach (var l1 in SystemChildrenOf(null))
                    {
                        <details open class="system-tree-branch">
                            <summary><span>🗂️</span> @l1.Name</summary>
                            @foreach (var l2 in SystemChildrenOf(l1.Key))
                            {
                                <details class="tree-l2">
                                    <summary><span>📁</span> @l2.Name</summary>
                                    @foreach (var l3 in SystemChildrenOf(l2.Key))
                                    {
                                        <button type="button"
                                                class="tree-leaf @(_selectedSystemFolder?.Key == l3.Key ? "active" : "")"
                                                @onclick="() => SelectSystemFolder(l3)">
                                            <span>📁</span><span>@l3.Name</span><small>@l3.DocumentCount</small>
                                        </button>
                                    }
                                </details>
                            }
                        </details>
                    }
                    @foreach (var l1 in ChildrenOf(null))
                    {
                        <details open>
                            <summary><span>📁</span> @l1.Name</summary>
                            @foreach (var l2 in ChildrenOf(l1.Id))
                            {
                                <details class="tree-l2">
                                    <summary><span>📁</span> @l2.Name</summary>
                                    @foreach (var l3 in ChildrenOf(l2.Id))
                                    {
                                        <button type="button"
                                                class="tree-leaf @(_selectedFolder?.Id == l3.Id ? "active" : "")"
                                                @onclick="() => SelectFolderAsync(l3)">
                                            <span>📁</span><span>@l3.Name</span><small>@l3.DocumentCount</small>
                                        </button>
                                    }
                                </details>
                            }
                        </details>
                    }
                </div>
            }
        </aside>

        <main class="document-content-card">
            @if (_selectedFolder is null && _selectedSystemFolder is null)
            {
                <div class="document-welcome">
                    <div class="document-welcome-icon">📚</div>
                    <h2>請從左側選擇資料夾</h2>
                    <p>選擇第三層資料夾後，即可查看文件清單。</p>
                </div>
            }
            else
            {
                <div class="folder-heading">
                    <div class="folder-heading-copy">
                        <div class="folder-level">L@(SelectedFolderLevel)</div>
                        <h2>@SelectedFolderName</h2>
                        <p>@DisplayDescription(SelectedFolderDescription)</p>
                    </div>
                    @if (SelectedFolderLevel == 3)
                    {
                        <span class="file-count">共 @SelectedFileCount 份文件</span>
                    }
                </div>

                @if (SelectedFolderLevel < 3)
                {
                    <div class="document-empty large">請展開並選擇下一層資料夾。</div>
                }
                else
                {
                    @if (_canWrite && (_selectedFolder is not null || _selectedSystemFolder?.CanUpload == true))
                    {
                        <div class="upload-panel">
                            <div>
                                <strong>上傳新文件</strong>
                                <span>可一次選擇多個檔案；傳輸完成後即進入待處理佇列。</span>
                            </div>
                            <div class="upload-actions" @ref="_uploadContainer">
                                <input type="file" multiple />
                                <button type="button" class="document-primary" disabled="@_uploading" @onclick="UploadAsync">
                                    @(_uploading ? "上傳中..." : "上傳")
                                </button>
                            </div>
                        </div>
                        @if (_uploadResults.Count > 0)
                        {
                            <div class="upload-results" aria-live="polite">
                                @foreach (var result in _uploadResults)
                                {
                                    <div class="upload-result @(result.Success ? "success" : "error")">
                                        <strong>@result.OriginalFileName</strong>
                                        <span>@result.Message</span>
                                    </div>
                                }
                            </div>
                        }
                    }

                    @if (_selectedSystemFolder is not null)
                    {
                    <div class="document-table-wrap">
                        <table class="document-table system-document-table">
                            <colgroup><col class="system-file-name-column" /><col class="system-file-archive-column" /><col class="system-file-km-column" /><col class="system-file-source-column" /><col class="system-file-uploader-column" /><col class="system-file-size-column" /><col class="system-file-time-column" /><col class="system-file-action-column" /></colgroup>
                            <thead><tr><th>檔案</th><th>正式入庫</th><th>KM 分析</th><th>來源</th><th>上傳者</th><th>大小</th><th>時間</th><th>操作</th></tr></thead>
                            <tbody>
                                @if (_selectedSystemFolder.Files.Count == 0)
                                {
                                    <tr><td colspan="8" class="document-empty">此分類目前沒有正式文件。</td></tr>
                                }
                                else
                                {
                                    @foreach (var file in _selectedSystemFolder.Files)
                                    {
                                        <tr @key="file.SourceKey">
                                            <td class="document-file-cell">
                                                @if (file.IsImage)
                                                {
                                                    <button type="button" class="document-thumbnail-button" title="開啟大圖預覽" @onclick="() => OpenPreview(file.PreviewUrl, file.FileName)">
                                                        <img class="document-thumbnail" src="@file.PreviewUrl" alt="@file.FileName" loading="lazy" />
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="document-type-icon" aria-hidden="true">📄</span>
                                                }
                                                <span><strong>@file.FileName</strong><small>@FormatSize(file.FileSize)</small></span>
                                            </td>
                                            <td><AttachmentStatusPill Status="@Status(file.ArchiveStatusDisplay, file.ArchiveStatusTone)" /></td>
                                            <td><AttachmentStatusPill Status="@Status(file.KmStatusDisplay, file.KmStatusTone)" /></td>
                                            <td>@file.SourceModule</td>
                                            <td>@DisplayUploader(file.UploadedBy)</td>
                                            <td>@FormatSize(file.FileSize)</td>
                                            <td>@file.UploadedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                                            <td class="document-action-cell"><a class="download-link" href="@file.DownloadUrl">下載</a></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    }
                    else
                    {
                    <div class="document-table-wrap">
                        <table class="document-table custom-document-table">
                            <colgroup><col class="custom-file-name-column" /><col class="custom-file-archive-column" /><col class="custom-file-km-column" /><col class="custom-file-size-column" /><col class="custom-file-uploader-column" /><col class="custom-file-time-column" /><col class="custom-file-sha-column" /><col class="custom-file-action-column" /></colgroup>
                            <thead><tr><th>原始檔名</th><th>正式入庫</th><th>KM 分析</th><th>大小</th><th>上傳者</th><th>上傳時間</th><th>SHA256</th><th>操作</th></tr></thead>
                            <tbody>
                                @if (_files.Count == 0)
                                {
                                    <tr><td colspan="8" class="document-empty">此資料夾尚無文件。</td></tr>
                                }
                                else
                                {
                                    @foreach (var file in _files)
                                    {
                                        <tr>
                                            <td class="document-file-cell">
                                                @if (IsImage(file.ContentType, file.OriginalFileName))
                                                {
                                                    <button type="button" class="document-thumbnail-button" title="開啟大圖預覽" @onclick="() => OpenPreview(DocumentPreviewUrl(file.Id), file.OriginalFileName)">
                                                        <img class="document-thumbnail" src="@DocumentPreviewUrl(file.Id)" alt="@file.OriginalFileName" loading="lazy" />
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="document-type-icon" aria-hidden="true">📄</span>
                                                }
                                                <span><strong>@file.OriginalFileName</strong><small>@file.StandardFileName</small></span>
                                            </td>
                                            <td><AttachmentStatusPill Status="@Status(file.ArchiveStatusDisplay, file.ArchiveStatusTone)" Title="@file.ArchiveError" /></td>
                                            <td><AttachmentStatusPill Status="@Status(file.KmStatusDisplay, file.KmStatusTone)" Title="@file.ProcessingError" /></td>
                                            <td>@FormatSize(file.FileSize)</td>
                                            <td>@DisplayUploader(file.UploadedBy)</td>
                                            <td>@file.UploadedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                                            <td><code title="@file.Sha256">@file.Sha256[..12]…</code></td>
                                            <td class="document-action-cell"><a class="download-link" href="@($"/api/document-library/files/{file.Id}/download")">下載</a></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    }
                }
            }
        </main>
    </div>
</div>

@code {
    private List<DocumentFolderDto> _folders = [];
    private List<DocumentLibraryFileDto> _files = [];
    private DocumentFolderDto? _selectedFolder;
    private ElementReference _uploadContainer;
    private bool _loading = true;
    private bool _uploading;
    private bool _canWrite;
    private string? _message;
    private bool _isError;
    private List<DocumentUploadResultDto> _uploadResults = [];
    private SystemDocumentCatalogDto _systemDocumentCatalog = new();
    private SystemDocumentFolderDto? _selectedSystemFolder;
    private bool _systemDocumentsLoading = true;
    private string? _previewUrl;
    private string? _previewName;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        _canWrite = (await AuthorizationService.AuthorizeAsync(auth.User, SystemAuthorization.Policies.BusinessWrite)).Succeeded;
        await LoadFoldersAsync();
        await LoadSystemDocumentsAsync();
    }

    private async Task LoadSystemDocumentsAsync()
    {
        try
        {
            _systemDocumentCatalog = await DocumentLibraryService.GetSystemDocumentsAsync();
            if (_selectedSystemFolder is not null)
                _selectedSystemFolder = _systemDocumentCatalog.Folders
                    .FirstOrDefault(x => x.Key == _selectedSystemFolder.Key);
        }
        catch (Exception ex) { ShowError($"載入系統文件失敗：{ex.Message}"); }
        finally { _systemDocumentsLoading = false; }
    }

    private IEnumerable<DocumentFolderDto> ChildrenOf(Guid? parentId) => _folders
        .Where(x => !x.IsSystemManaged && x.ParentId == parentId)
        .OrderBy(x => x.SortOrder).ThenBy(x => x.Name);

    private IEnumerable<SystemDocumentFolderDto> SystemChildrenOf(string? parentKey) =>
        _systemDocumentCatalog.Folders.Where(x => x.ParentKey == parentKey)
            .OrderBy(x => x.SortOrder).ThenBy(x => x.Name);

    private async Task LoadFoldersAsync()
    {
        try { _folders = await Api.GetAsync<List<DocumentFolderDto>>("/api/document-library/folders"); }
        catch (Exception ex) { ShowError($"載入文件資料夾失敗：{ex.Message}"); }
        finally { _loading = false; }
    }

    private async Task SelectFolderAsync(DocumentFolderDto folder)
    {
        _selectedSystemFolder = null;
        _selectedFolder = folder;
        _files = [];
        _message = null;
        _uploadResults = [];
        if (folder.Level != 3) return;
        try { _files = await Api.GetAsync<List<DocumentLibraryFileDto>>($"/api/document-library/folders/{folder.Id}/files"); }
        catch (Exception ex) { ShowError($"載入文件失敗：{ex.Message}"); }
    }

    private void SelectSystemFolder(SystemDocumentFolderDto folder)
    {
        _selectedFolder = null;
        _selectedSystemFolder = folder;
        _files = [];
        _message = null;
        _uploadResults = [];
    }

    private async Task UploadAsync()
    {
        if (SelectedFolderLevel != 3 || (_selectedFolder is null && _selectedSystemFolder?.CanUpload != true)) return;
        _uploading = true;
        _message = null;
        _uploadResults = [];
        try
        {
            var uploadUrl = _selectedFolder is not null
                ? $"/api/document-library/folders/{_selectedFolder.Id}/files"
                : $"/api/document-library/system-folders/product-information/files?modelName={Uri.EscapeDataString(_selectedSystemFolder!.UploadModelName!)}";
            var response = await Api.UploadFilesAsync(uploadUrl, _uploadContainer);
            if (!response.IsSuccessStatusCode) throw new BrowserApiException(response.StatusCode, response.Body);
            var batch = global::System.Text.Json.JsonSerializer.Deserialize<DocumentUploadBatchResultDto>(
                response.Body, new global::System.Text.Json.JsonSerializerOptions(global::System.Text.Json.JsonSerializerDefaults.Web))
                ?? throw new InvalidOperationException("無法讀取上傳結果。");
            var uploadResults = batch.Results;
            if (_selectedFolder is not null)
            {
                await SelectFolderAsync(_selectedFolder);
                await LoadFoldersAsync();
            }
            else
            {
                await LoadSystemDocumentsAsync();
                await LoadFoldersAsync();
            }
            _uploadResults = uploadResults;
            var successCount = _uploadResults.Count(x => x.Success);
            var failedCount = _uploadResults.Count - successCount;
            _message = $"已接收 {successCount} 份文件／待 KM 處理；失敗 {failedCount} 份。";
            _isError = successCount == 0;
        }
        catch (Exception ex) { ShowError($"上傳失敗：{ex.Message}"); }
        finally { _uploading = false; }
    }

    private void ShowError(string message) { _message = message; _isError = true; }
    private int SelectedFolderLevel => _selectedFolder?.Level ?? _selectedSystemFolder?.Level ?? 0;
    private string SelectedFolderName => _selectedFolder?.Name ?? _selectedSystemFolder?.Name ?? string.Empty;
    private string? SelectedFolderDescription => _selectedFolder?.Description ?? _selectedSystemFolder?.Description;
    private int SelectedFileCount => _selectedFolder is not null ? _files.Count : _selectedSystemFolder?.Files.Count ?? 0;
    private static bool IsImage(string? contentType, string fileName) =>
        DocumentLibraryRules.IsPreviewableImage(contentType, fileName);
    private void OpenPreview(string url, string name) { _previewUrl = url; _previewName = name; }
    private void ClosePreview() { _previewUrl = null; _previewName = null; }
    private static string DocumentPreviewUrl(Guid id) => $"/api/document-library/files/{id}/preview";
    private static string DisplayDescription(string? value) => string.IsNullOrWhiteSpace(value) ? "未填寫說明" : value;
    private static string DisplayUploader(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private static AttachmentStatusValue Status(string text, string tone) => new(text, tone);
    private static string FormatSize(long bytes) => bytes >= 1_000_000
        ? $"{bytes / 1_000_000d:0.##} MB"
        : bytes >= 1_000 ? $"{bytes / 1_000d:0.##} KB" : $"{bytes} B";
    private static string StatusDetails(DocumentLibraryFileDto file) =>
        file.ArchiveError ?? file.ProcessingError ?? file.ProcessingStatusDisplay;
}
