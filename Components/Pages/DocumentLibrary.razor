@page "/documents"
@using SIT.DepartmentSystem.Web.Services
@using SIT.DepartmentSystem.Web.Entities
@using SIT.DepartmentSystem.Web.Services.KmIntegration
@rendermode InteractiveServer
@attribute [Authorize(Policy = SystemAuthorization.Policies.CsitStaff)]
@implements IAsyncDisposable
@inject BrowserApiClient Api
@inject IDocumentLibraryService DocumentLibraryService
@inject AuthenticationStateProvider AuthProvider
@inject IAuthorizationService AuthorizationService
@inject DocumentLibraryDeletionAuthorizationService DeletionAuthorization

<PageTitle>文件專區</PageTitle>

@if (!string.IsNullOrWhiteSpace(_previewUrl))
{
    <div class="image-preview-backdrop" role="dialog" aria-modal="true" aria-label="圖片預覽" @onclick="ClosePreview">
        <div class="image-preview-dialog" @onclick:stopPropagation="true">
            <div class="image-preview-heading"><strong>@_previewName</strong><button type="button" @onclick="ClosePreview" aria-label="關閉預覽">×</button></div>
            <img src="@_previewUrl" alt="@_previewName" />
        </div>
    </div>
}

<AppMessageDialog Visible="@(_deleteCandidate is not null)"
                  Title="確認刪除文件"
                  Message="@DeleteConfirmationMessage"
                  Type="AppMessageDialogType.Warning"
                  ShowCancel="true"
                  ConfirmText="確認刪除"
                  CancelText="取消"
                  ConfirmIsDanger="true"
                  OnConfirm="ConfirmDeleteAsync"
                  OnClose="CloseDeleteConfirmation" />

<div class="document-page">
    <header class="document-hero">
        <div>
            <div class="document-kicker">DOCUMENT LIBRARY</div>
            <h1>文件專區</h1>
            <p>依三層資料夾分類瀏覽、上傳與下載文件。</p>
        </div>
        <span class="document-scope">獨立文件庫</span>
    </header>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="document-message @(_isError ? "error" : "success")">
            <span>@_message</span>
            @if (_isError)
            {
                <button type="button" class="notice-close" aria-label="關閉訊息" @onclick="ClearMessage">×</button>
            }
        </div>
    }

    <div class="document-workspace">
        <aside class="document-tree-card">
            <h2>資料夾</h2>
            @if (_loading || _systemDocumentsLoading)
            {
                <div class="document-empty">載入中...</div>
            }
            else if (!_folders.Any(x => !x.IsSystemManaged) && _systemDocumentCatalog.Folders.Count == 0)
            {
                <div class="document-empty">尚未建立文件資料夾。</div>
            }
            else
            {
                <div class="document-tree">
                    @foreach (var l1 in SystemChildrenOf(null))
                    {
                        <details open class="system-tree-branch">
                            <summary><span>🗂️</span> @l1.Name</summary>
                            @foreach (var l2 in SystemChildrenOf(l1.Key))
                            {
                                <details class="tree-l2">
                                    <summary><span>📁</span> @l2.Name</summary>
                                    @foreach (var l3 in SystemChildrenOf(l2.Key))
                                    {
                                        <button type="button"
                                                class="tree-leaf @(_selectedSystemFolder?.Key == l3.Key ? "active" : "")"
                                                @onclick="() => SelectSystemFolderAsync(l3)">
                                            <span>📁</span><span>@l3.Name</span><small>@l3.DocumentCount</small>
                                        </button>
                                    }
                                </details>
                            }
                        </details>
                    }
                    @foreach (var l1 in ChildrenOf(null))
                    {
                        <details open>
                            <summary><span>📁</span> @l1.Name</summary>
                            @foreach (var l2 in ChildrenOf(l1.Id))
                            {
                                <details class="tree-l2">
                                    <summary><span>📁</span> @l2.Name</summary>
                                    @foreach (var l3 in ChildrenOf(l2.Id))
                                    {
                                        <button type="button"
                                                class="tree-leaf @(_selectedFolder?.Id == l3.Id ? "active" : "")"
                                                @onclick="() => SelectFolderAsync(l3)">
                                            <span>📁</span><span>@l3.Name</span><small>@l3.DocumentCount</small>
                                        </button>
                                    }
                                </details>
                            }
                        </details>
                    }
                </div>
            }
        </aside>

        <main class="document-content-card">
            @if (_selectedFolder is null && _selectedSystemFolder is null)
            {
                <div class="document-welcome">
                    <div class="document-welcome-icon">📚</div>
                    <h2>請從左側選擇資料夾</h2>
                    <p>選擇第三層資料夾後，即可查看文件清單。</p>
                </div>
            }
            else
            {
                <div class="folder-heading">
                    <div class="folder-heading-copy">
                        <div class="folder-level">L@(SelectedFolderLevel)</div>
                        <h2>@SelectedFolderName</h2>
                        <p>@DisplayDescription(SelectedFolderDescription)</p>
                    </div>
                    @if (SelectedFolderLevel == 3)
                    {
                        <span class="file-count">共 @SelectedFileCount 份文件</span>
                    }
                </div>

                @if (SelectedFolderLevel < 3)
                {
                    <div class="document-empty large">請展開並選擇下一層資料夾。</div>
                }
                else
                {
                    @if (_canWrite && (_selectedFolder is not null || _selectedSystemFolder?.CanUpload == true))
                    {
                        <div class="upload-panel">
                            <div>
                                <strong>上傳新文件</strong>
                                <span>一般員工上傳後送主管審核；合法免審者直接進入正式 NAS 入庫流程。</span>
                            </div>
                            <div class="upload-actions" @ref="_uploadContainer">
                                <input type="file" multiple />
                                <button type="button" class="document-primary" disabled="@_uploading" @onclick="UploadAsync">
                                    @(_uploading ? "上傳中..." : "上傳")
                                </button>
                            </div>
                        </div>
                        @if (_uploadResults.Count > 0)
                        {
                            <div class="upload-results" aria-live="polite">
                                @foreach (var notice in _uploadResults)
                                {
                                    var result = notice.Result;
                                    <div @key="notice.Id" class="upload-result @(result.Success ? "success" : "error")">
                                        <strong>@result.OriginalFileName</strong>
                                        <span>@result.Message</span>
                                        @if (!result.Success)
                                        {
                                            <button type="button" class="notice-close" aria-label="關閉檔案上傳訊息"
                                                    @onclick="() => DismissUploadResult(notice.Id)">×</button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        @if (_trackingTimedOut)
                        {
                            <div class="upload-results compact-progress" aria-live="polite">
                                <div class="upload-result error">
                                    <span>自動追蹤已暫停。</span>
                                    <button type="button" class="download-link" @onclick="RefreshTrackedStatusesAsync">重新整理狀態</button>
                                </div>
                            </div>
                        }
                        else if (_showUploadProgress && _uploadTrackedIds.Count > 0)
                        {
                            <div class="upload-results" aria-live="polite">
                                <div class="upload-result @(UploadTerminalFailedCount > 0 ? "error" : "success")">
                                    <strong>正式入庫進度</strong>
                                    <span>已完成 @UploadCompletedCount 份／處理中 @UploadProcessingCount 份／失敗 @UploadFailedCount 份</span>
                                    @if (UploadTerminalFailedCount > 0)
                                    {
                                        <button type="button" class="notice-close" aria-label="關閉正式入庫失敗提示"
                                                @onclick="DismissUploadProgress">×</button>
                                    }
                                </div>
                            </div>
                        }
                    }

                    @if (_selectedSystemFolder is not null)
                    {
                    <div class="document-table-wrap">
                        <table class="document-table system-document-table">
                            <colgroup><col class="system-file-name-column" /><col class="system-file-archive-column" /><col class="system-file-km-column" /><col class="system-file-source-column" /><col class="system-file-uploader-column" /><col class="system-file-size-column" /><col class="system-file-time-column" /><col class="system-file-action-column" /></colgroup>
                            <thead><tr><th>檔案</th><th>正式入庫</th><th>KM 分析</th><th>來源</th><th>上傳者</th><th>大小</th><th>時間</th><th>操作</th></tr></thead>
                            <tbody>
                                @if (_selectedSystemFolder.Files.Count == 0)
                                {
                                    <tr><td colspan="8" class="document-empty">此分類目前沒有正式文件。</td></tr>
                                }
                                else
                                {
                                    @foreach (var file in _selectedSystemFolder.Files)
                                    {
                                        <tr @key="file.SourceKey">
                                            <td class="document-file-cell">
                                                @if (file.IsImage)
                                                {
                                                    <button type="button" class="document-thumbnail-button" title="開啟大圖預覽" @onclick="() => OpenPreview(file.PreviewUrl, file.FileName)">
                                                        <img class="document-thumbnail" src="@file.PreviewUrl" alt="@file.FileName" loading="lazy" />
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="document-type-icon" aria-hidden="true">📄</span>
                                                }
                                                <span><strong>@file.FileName</strong><small>@FormatSize(file.FileSize)</small></span>
                                            </td>
                                            <td><AttachmentStatusPill Status="@Status(file.ArchiveStatusDisplay, file.ArchiveStatusTone)" Title="@file.ArchiveError" /></td>
                                            <td><AttachmentStatusPill Status="@Status(file.KmStatusDisplay, file.KmStatusTone)" /></td>
                                            <td>@file.SourceModule</td>
                                            <td>@DisplayUploader(file.UploadedBy)</td>
                                            <td>@FormatSize(file.FileSize)</td>
                                            <td>@file.UploadedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                                            <td class="document-action-cell">
                                                <a class="download-link" href="@file.DownloadUrl">下載</a>
                                                @if (!string.IsNullOrWhiteSpace(file.SourceManagementUrl))
                                                {
                                                    <a class="source-link" href="@file.SourceManagementUrl"
                                                       title="@file.DeletionRestrictionMessage">前往來源</a>
                                                }
                                                @if (_canDelete && file.CanDelete && file.FileId.HasValue)
                                                {
                                                    <button type="button" class="document-delete"
                                                            disabled="@_deleteSubmitting"
                                                            @onclick="() => ShowDeleteConfirmation(file)">刪除</button>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(file.DeletionStatusDisplay))
                                                {
                                                    <small class="deletion-state" title="@file.DeletionError">@file.DeletionStatusDisplay</small>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    }
                    else
                    {
                    <div class="document-table-wrap">
                        <table class="document-table custom-document-table">
                            <colgroup><col class="custom-file-name-column" /><col class="custom-file-archive-column" /><col class="custom-file-km-column" /><col class="custom-file-size-column" /><col class="custom-file-uploader-column" /><col class="custom-file-time-column" /><col class="custom-file-sha-column" /><col class="custom-file-action-column" /></colgroup>
                            <thead><tr><th>原始檔名</th><th>正式入庫</th><th>KM 分析</th><th>大小</th><th>上傳者</th><th>上傳時間</th><th>SHA256</th><th>操作</th></tr></thead>
                            <tbody>
                                @if (_files.Count == 0)
                                {
                                    <tr><td colspan="8" class="document-empty">此資料夾尚無文件。</td></tr>
                                }
                                else
                                {
                                    @foreach (var file in _files)
                                    {
                                        <tr>
                                            <td class="document-file-cell">
                                                @if (IsImage(file.ContentType, file.OriginalFileName))
                                                {
                                                    <button type="button" class="document-thumbnail-button" title="開啟大圖預覽" @onclick="() => OpenPreview(DocumentPreviewUrl(file.Id), file.OriginalFileName)">
                                                        <img class="document-thumbnail" src="@DocumentPreviewUrl(file.Id)" alt="@file.OriginalFileName" loading="lazy" />
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="document-type-icon" aria-hidden="true">📄</span>
                                                }
                                                <span><strong>@file.OriginalFileName</strong><small>@file.StandardFileName</small></span>
                                            </td>
                                            <td><AttachmentStatusPill Status="@Status(file.ArchiveStatusDisplay, file.ArchiveStatusTone)" Title="@file.ArchiveError" /></td>
                                            <td><AttachmentStatusPill Status="@Status(file.KmStatusDisplay, file.KmStatusTone)" Title="@file.ProcessingError" /></td>
                                            <td>@FormatSize(file.FileSize)</td>
                                            <td>@DisplayUploader(file.UploadedBy)</td>
                                            <td>@file.UploadedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                                            <td><code title="@file.Sha256">@file.Sha256[..12]…</code></td>
                                            <td class="document-action-cell">
                                                <a class="download-link" href="@($"/api/document-library/files/{file.Id}/download")">下載</a>
                                                @if (_canDelete && file.CanDelete)
                                                {
                                                    <button type="button" class="document-delete"
                                                            disabled="@_deleteSubmitting"
                                                            @onclick="() => ShowDeleteConfirmation(file)">刪除</button>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(file.DeletionStatusDisplay))
                                                {
                                                    <small class="deletion-state" title="@file.DeletionError">@file.DeletionStatusDisplay</small>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    }
                }
            }
        </main>
    </div>
</div>

@code {
    private List<DocumentFolderDto> _folders = [];
    private List<DocumentLibraryFileDto> _files = [];
    private DocumentFolderDto? _selectedFolder;
    private ElementReference _uploadContainer;
    private bool _loading = true;
    private bool _uploading;
    private bool _canWrite;
    private bool _canDelete;
    private bool _deleteSubmitting;
    private DeletionCandidate? _deleteCandidate;
    private readonly Dictionary<Guid, Guid> _deletionRequests = [];
    private CancellationTokenSource? _deletionPollingCts;
    private Task? _deletionPollingTask;
    private string? _message;
    private bool _isError;
    private List<UploadResultNotice> _uploadResults = [];
    private SystemDocumentCatalogDto _systemDocumentCatalog = new();
    private SystemDocumentFolderDto? _selectedSystemFolder;
    private bool _systemDocumentsLoading = true;
    private string? _previewUrl;
    private string? _previewName;
    private readonly HashSet<Guid> _trackedFileIds = [];
    private readonly HashSet<Guid> _uploadTrackedIds = [];
    private readonly Dictionary<Guid, DateTime> _trackingStartedAt = [];
    private readonly Dictionary<Guid, string> _latestArchiveStatuses = [];
    private CancellationTokenSource? _statusPollingCts;
    private Task? _statusPollingTask;
    private int _selectionVersion;
    private bool _trackingTimedOut;
    private bool _showUploadProgress;
    private CancellationTokenSource? _messageCts;
    private CancellationTokenSource? _uploadResultsCts;
    private CancellationTokenSource? _progressHideCts;
    private long _messageVersion;
    private long _uploadResultsVersion;
    private long _progressVersion;
    private static readonly TimeSpan StatusPollingInterval = TimeSpan.FromSeconds(10);
    private static readonly TimeSpan StatusTrackingLimit = TimeSpan.FromMinutes(10);
    private static readonly TimeSpan SuccessMessageLifetime = TimeSpan.FromSeconds(6);
    private static readonly TimeSpan SuccessResultLifetime = TimeSpan.FromSeconds(8);
    private static readonly TimeSpan FailureNoticeLifetime = TimeSpan.FromSeconds(15);
    private static readonly TimeSpan FinalProgressLifetime = TimeSpan.FromSeconds(8);
    private static readonly TimeSpan DeletionPollingInterval = TimeSpan.FromSeconds(3);

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        _canWrite = (await AuthorizationService.AuthorizeAsync(auth.User, SystemAuthorization.Policies.BusinessWrite)).Succeeded;
        _canDelete = _canWrite && await DeletionAuthorization.CanDeleteAsync(auth.User);
        await LoadFoldersAsync();
        await LoadSystemDocumentsAsync();
    }

    private async Task LoadSystemDocumentsAsync()
    {
        try
        {
            _systemDocumentCatalog = await DocumentLibraryService.GetSystemDocumentsAsync();
            if (_selectedSystemFolder is not null)
                _selectedSystemFolder = _systemDocumentCatalog.Folders
                    .FirstOrDefault(x => x.Key == _selectedSystemFolder.Key);
        }
        catch (Exception ex) { ShowError($"載入系統文件失敗：{ex.Message}"); }
        finally { _systemDocumentsLoading = false; }
    }

    private IEnumerable<DocumentFolderDto> ChildrenOf(Guid? parentId) => _folders
        .Where(x => !x.IsSystemManaged && x.ParentId == parentId)
        .OrderBy(x => x.SortOrder).ThenBy(x => x.Name);

    private IEnumerable<SystemDocumentFolderDto> SystemChildrenOf(string? parentKey) =>
        _systemDocumentCatalog.Folders.Where(x => x.ParentKey == parentKey)
            .OrderBy(x => x.SortOrder).ThenBy(x => x.Name);

    private async Task LoadFoldersAsync()
    {
        try { _folders = await Api.GetAsync<List<DocumentFolderDto>>("/api/document-library/folders"); }
        catch (Exception ex) { ShowError($"載入文件資料夾失敗：{ex.Message}"); }
        finally { _loading = false; }
    }

    private async Task SelectFolderAsync(DocumentFolderDto folder)
    {
        await CancelStatusTrackingAsync();
        await CancelDeletionPollingAsync();
        var selectionVersion = _selectionVersion;
        _selectedSystemFolder = null;
        _selectedFolder = folder;
        _files = [];
        ClearMessage();
        ClearUploadResults();
        DismissUploadProgress();
        if (folder.Level != 3) return;
        try
        {
            var files = await Api.GetAsync<List<DocumentLibraryFileDto>>($"/api/document-library/folders/{folder.Id}/files");
            if (selectionVersion != _selectionVersion || _selectedFolder?.Id != folder.Id) return;
            _files = files;
            TrackVisibleFiles();
        }
        catch (Exception ex)
        {
            if (selectionVersion == _selectionVersion) ShowError($"載入文件失敗：{ex.Message}");
        }
    }

    private async Task SelectSystemFolderAsync(SystemDocumentFolderDto folder)
    {
        await CancelStatusTrackingAsync();
        await CancelDeletionPollingAsync();
        _selectedFolder = null;
        _selectedSystemFolder = folder;
        _files = [];
        ClearMessage();
        ClearUploadResults();
        DismissUploadProgress();
        TrackVisibleFiles();
    }

    private async Task UploadAsync()
    {
        if (SelectedFolderLevel != 3 || (_selectedFolder is null && _selectedSystemFolder?.CanUpload != true)) return;
        _uploading = true;
        var selectionVersion = _selectionVersion;
        var selectedFolderId = _selectedFolder?.Id;
        var selectedSystemFolderKey = _selectedSystemFolder?.Key;
        ClearMessage();
        ClearUploadResults();
        try
        {
            var uploadUrl = _selectedFolder is not null
                ? $"/api/document-library/folders/{_selectedFolder.Id}/files"
                : $"/api/document-library/system-folders/product-information/files?modelName={Uri.EscapeDataString(_selectedSystemFolder!.UploadModelName!)}";
            var response = await Api.UploadFilesAsync(uploadUrl, _uploadContainer);
            if (!response.IsSuccessStatusCode) throw new BrowserApiException(response.StatusCode, response.Body);
            var batch = global::System.Text.Json.JsonSerializer.Deserialize<DocumentUploadBatchResultDto>(
                response.Body, new global::System.Text.Json.JsonSerializerOptions(global::System.Text.Json.JsonSerializerDefaults.Web))
                ?? throw new InvalidOperationException("無法讀取上傳結果。");
            var uploadResults = batch.Results;
            if (selectionVersion != _selectionVersion || selectedFolderId != _selectedFolder?.Id ||
                selectedSystemFolderKey != _selectedSystemFolder?.Key) return;
            foreach (var file in uploadResults.Where(x => x.Success && x.File is not null).Select(x => x.File!))
            {
                AddUploadedFileToCurrentList(file);
                if (file.ArchiveStatus is DocumentArchiveStatuses.Pending or DocumentArchiveStatuses.Archiving or
                    DocumentArchiveStatuses.Failed)
                    AddTrackedFile(file.Id, file.ArchiveStatus, uploaded: true);
            }
            EnsureStatusPolling();
            ShowUploadResults(uploadResults);
            var failedCount = uploadResults.Count(x => !x.Success);
            var pendingCount = uploadResults.Count(x => x.Success && x.ApprovalResult == "Pending");
            var bypassCount = uploadResults.Count(x => x.Success && x.ApprovalResult == "ApprovalBypassed");
            ShowMessage($"已送主管待審 {pendingCount} 份；合法免審、待 NAS 入庫 {bypassCount} 份；失敗 {failedCount} 份。",
                failedCount > 0);
        }
        catch (Exception ex)
        {
            if (selectionVersion == _selectionVersion) ShowError($"上傳失敗：{ex.Message}");
        }
        finally { _uploading = false; }
    }

    private void AddUploadedFileToCurrentList(DocumentLibraryFileDto file)
    {
        if (_selectedFolder is not null)
        {
            var index = _files.FindIndex(x => x.Id == file.Id);
            if (index >= 0) _files[index] = file;
            else
            {
                _files.Insert(0, file);
                _selectedFolder.DocumentCount++;
            }
            return;
        }
        if (_selectedSystemFolder is null || _selectedSystemFolder.Files.Any(x => x.FileId == file.Id)) return;
        _selectedSystemFolder.Files.Insert(0, new SystemDocumentFileDto
        {
            FileId = file.Id,
            SourceKey = $"document-library:{file.Id:N}",
            FileName = file.OriginalFileName,
            SourceModule = "文件專區",
            UploadedBy = file.UploadedBy,
            ContentType = file.ContentType,
            IsImage = IsImage(file.ContentType, file.OriginalFileName),
            FileSize = file.FileSize,
            UploadedAt = file.UploadedAt,
            ArchiveStatus = file.ArchiveStatus,
            ArchiveStatusDisplay = file.ArchiveStatusDisplay,
            ArchiveStatusTone = file.ArchiveStatusTone,
            ArchiveError = file.ArchiveError,
            KmStatusDisplay = file.KmStatusDisplay,
            KmStatusTone = file.KmStatusTone,
            DownloadUrl = $"/api/document-library/files/{file.Id}/download",
            PreviewUrl = $"/api/document-library/files/{file.Id}/preview"
        });
        _selectedSystemFolder.DocumentCount++;
    }

    private void TrackVisibleFiles()
    {
        if (_selectedFolder is not null)
        {
            foreach (var file in _files.Where(x => x.ArchiveStatus is DocumentArchiveStatuses.Pending or
                         DocumentArchiveStatuses.Archiving or DocumentArchiveStatuses.Failed))
                AddTrackedFile(file.Id, file.ArchiveStatus, uploaded: false);
        }
        else if (_selectedSystemFolder is not null)
        {
            foreach (var file in _selectedSystemFolder.Files.Where(x => x.FileId.HasValue &&
                         x.ArchiveStatus is DocumentArchiveStatuses.Pending or DocumentArchiveStatuses.Archiving or
                             DocumentArchiveStatuses.Failed))
                AddTrackedFile(file.FileId!.Value, file.ArchiveStatus, uploaded: false);
        }
        TrackVisibleDeletions();
        EnsureStatusPolling();
    }

    private void TrackVisibleDeletions()
    {
        foreach (var file in _files.Where(x => x.DeletionRequestId.HasValue &&
                     x.DeletionStatus != DocumentLibraryFileDeletionStatuses.Completed))
            _deletionRequests[file.DeletionRequestId!.Value] = file.Id;
        if (_selectedSystemFolder is not null)
            foreach (var file in _selectedSystemFolder.Files.Where(x => x.FileId.HasValue &&
                         x.DeletionRequestId.HasValue &&
                         x.DeletionStatus != DocumentLibraryFileDeletionStatuses.Completed))
                _deletionRequests[file.DeletionRequestId!.Value] = file.FileId!.Value;
        EnsureDeletionPolling();
    }

    private void AddTrackedFile(Guid fileId, string status, bool uploaded)
    {
        if (fileId == Guid.Empty) return;
        _latestArchiveStatuses[fileId] = status;
        if (uploaded)
        {
            _uploadTrackedIds.Add(fileId);
            ShowUploadProgress();
        }
        if (_trackedFileIds.Add(fileId)) _trackingStartedAt[fileId] = DateTime.UtcNow;
    }

    private void EnsureStatusPolling()
    {
        if (_trackedFileIds.Count == 0 || _statusPollingTask is { IsCompleted: false }) return;
        _statusPollingCts?.Dispose();
        _statusPollingCts = new CancellationTokenSource();
        _statusPollingTask = PollArchiveStatusesAsync(_selectionVersion, _statusPollingCts.Token);
    }

    private async Task PollArchiveStatusesAsync(int selectionVersion, CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(StatusPollingInterval);
            while (_trackedFileIds.Count > 0 && await timer.WaitForNextTickAsync(cancellationToken))
            {
                try { await QueryArchiveStatusesAsync(selectionVersion, cancellationToken); }
                catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { break; }
                catch (JSDisconnectedException) { break; }
                catch (ObjectDisposedException) when (cancellationToken.IsCancellationRequested) { break; }
                catch { /* Keep the bounded tracker alive for a transient read failure. */ }
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        finally
        {
            if (!cancellationToken.IsCancellationRequested) await InvokeAsync(() =>
            {
                _statusPollingTask = null;
                if (_trackedFileIds.Count > 0 && selectionVersion == _selectionVersion) EnsureStatusPolling();
            });
        }
    }

    private async Task QueryArchiveStatusesAsync(int selectionVersion, CancellationToken cancellationToken)
    {
        var now = DateTime.UtcNow;
        var expired = _trackedFileIds.Where(id => now - _trackingStartedAt[id] >= StatusTrackingLimit).ToArray();
        foreach (var id in expired)
        {
            _trackedFileIds.Remove(id);
            _trackingStartedAt.Remove(id);
            _trackingTimedOut = true;
        }
        var ids = _trackedFileIds.Take(100).ToArray();
        if (ids.Length == 0)
        {
            if (expired.Length > 0) await InvokeAsync(() =>
            {
                UpdateProgressVisibility();
                StateHasChanged();
            });
            return;
        }

        var response = await Api.PostJsonAsync("/api/document-library/file-statuses",
            new DocumentArchiveStatusBatchRequest { FileIds = ids.ToList() });
        response.EnsureSuccess();
        var statuses = global::System.Text.Json.JsonSerializer.Deserialize<List<DocumentArchiveStatusDto>>(
            response.Body, new global::System.Text.Json.JsonSerializerOptions(global::System.Text.Json.JsonSerializerDefaults.Web)) ?? [];
        if (cancellationToken.IsCancellationRequested || selectionVersion != _selectionVersion) return;

        await InvokeAsync(() =>
        {
            var returnedIds = statuses.Select(x => x.FileId).ToHashSet();
            foreach (var status in statuses)
            {
                ApplyArchiveStatus(status);
                _latestArchiveStatuses[status.FileId] = status.ArchiveStatus;
                if (!status.ContinueTracking)
                {
                    _trackedFileIds.Remove(status.FileId);
                    _trackingStartedAt.Remove(status.FileId);
                }
            }
            foreach (var missingId in ids.Where(x => !returnedIds.Contains(x)))
            {
                _trackedFileIds.Remove(missingId);
                _trackingStartedAt.Remove(missingId);
            }
            UpdateProgressVisibility();
            StateHasChanged();
        });
    }

    private void ApplyArchiveStatus(DocumentArchiveStatusDto status)
    {
        var custom = _files.FirstOrDefault(x => x.Id == status.FileId);
        if (custom is not null)
        {
            custom.ArchiveStatus = status.ArchiveStatus;
            custom.ArchiveStatusDisplay = status.ArchiveStatusDisplay;
            custom.ArchiveStatusTone = status.ArchiveStatusTone;
            custom.ArchiveError = status.ArchiveError;
        }
        var system = _selectedSystemFolder?.Files.FirstOrDefault(x => x.FileId == status.FileId);
        if (system is null) return;
        system.ArchiveStatus = status.ArchiveStatus;
        system.ArchiveStatusDisplay = status.ArchiveStatusDisplay;
        system.ArchiveStatusTone = status.ArchiveStatusTone;
        system.ArchiveError = status.ArchiveError;
    }

    private async Task RefreshTrackedStatusesAsync()
    {
        _trackingTimedOut = false;
        if (_uploadTrackedIds.Count > 0) ShowUploadProgress();
        TrackVisibleFiles();
        await QueryArchiveStatusesAsync(_selectionVersion,
            _statusPollingCts?.Token ?? CancellationToken.None);
    }

    private async Task CancelStatusTrackingAsync()
    {
        _selectionVersion++;
        if (_statusPollingCts is not null)
        {
            await _statusPollingCts.CancelAsync();
            _statusPollingCts.Dispose();
            _statusPollingCts = null;
        }
        _statusPollingTask = null;
        _trackedFileIds.Clear();
        _uploadTrackedIds.Clear();
        _trackingStartedAt.Clear();
        _latestArchiveStatuses.Clear();
        _trackingTimedOut = false;
        DismissUploadProgress();
    }

    private int UploadCompletedCount => _uploadTrackedIds.Count(id =>
        _latestArchiveStatuses.GetValueOrDefault(id) == DocumentArchiveStatuses.Completed);
    private int UploadFailedCount => _uploadTrackedIds.Count(id =>
        _latestArchiveStatuses.GetValueOrDefault(id) == DocumentArchiveStatuses.Failed);
    private int UploadProcessingCount => _uploadTrackedIds.Count - UploadCompletedCount - UploadFailedCount;
    private int UploadTerminalFailedCount => _uploadTrackedIds.Count(id =>
        _latestArchiveStatuses.GetValueOrDefault(id) == DocumentArchiveStatuses.Failed &&
        !_trackedFileIds.Contains(id));

    private void ShowDeleteConfirmation(DocumentLibraryFileDto file) =>
        _deleteCandidate = new DeletionCandidate(file.Id, file.OriginalFileName,
            file.UploadedBy, file.UploadedAt, file.ArchiveStatusDisplay,
            file.KmStatusDisplay);

    private void ShowDeleteConfirmation(SystemDocumentFileDto file)
    {
        if (file.FileId is not { } fileId) return;
        _deleteCandidate = new DeletionCandidate(fileId, file.FileName,
            file.UploadedBy, file.UploadedAt, file.ArchiveStatusDisplay,
            file.KmStatusDisplay);
    }

    private string DeleteConfirmationMessage => _deleteCandidate is null ? string.Empty :
        $"原始檔名：{_deleteCandidate.FileName}；上傳者：{DisplayUploader(_deleteCandidate.UploadedBy)}；" +
        $"上傳時間：{_deleteCandidate.UploadedAt.ToLocalTime():yyyy/MM/dd HH:mm}；" +
        $"正式入庫：{_deleteCandidate.ArchiveStatus}；KM：{_deleteCandidate.KmStatus}。" +
        "確認後將建立可追蹤的安全刪除工作；若文件曾送入 KM，必須等候 KM 完成回呼及完整清除驗證，才會移除本地資料與實體檔案。";

    private void CloseDeleteConfirmation() => _deleteCandidate = null;

    private async Task ConfirmDeleteAsync()
    {
        var candidate = _deleteCandidate;
        _deleteCandidate = null;
        if (candidate is null || _deleteSubmitting) return;
        _deleteSubmitting = true;
        var selectionVersion = _selectionVersion;
        try
        {
            var response = await Api.PostJsonAsync(
                $"/api/document-library/files/{candidate.FileId}/deletion", new { });
            if (!response.IsSuccessStatusCode)
            {
                ShowError(ApiErrorMessage(response.Body, "刪除要求未建立。"));
                return;
            }
            var result = global::System.Text.Json.JsonSerializer.Deserialize<DocumentLibraryFileDeletionStatusDto>(
                response.Body,
                new global::System.Text.Json.JsonSerializerOptions(global::System.Text.Json.JsonSerializerDefaults.Web))
                ?? throw new InvalidOperationException("無法讀取刪除工作狀態。");
            if (selectionVersion != _selectionVersion) return;
            ApplyDeletionStatus(result);
            if (!result.Completed && !(result.Status == DocumentLibraryFileDeletionStatuses.Failed &&
                                      !result.Retryable))
            {
                _deletionRequests[result.RequestId] = result.FileId;
                EnsureDeletionPolling();
            }
            ShowMessage(result.Completed ? "文件已安全刪除。" : result.StatusDisplay,
                result.Status == DocumentLibraryFileDeletionStatuses.Failed && !result.Retryable);
        }
        catch (Exception ex)
        {
            ShowError($"刪除要求失敗：{ex.Message}");
        }
        finally { _deleteSubmitting = false; }
    }

    private void EnsureDeletionPolling()
    {
        if (_deletionRequests.Count == 0 || _deletionPollingTask is { IsCompleted: false }) return;
        _deletionPollingCts?.Dispose();
        _deletionPollingCts = new CancellationTokenSource();
        _deletionPollingTask = PollDeletionStatusesAsync(_selectionVersion,
            _deletionPollingCts.Token);
    }

    private async Task PollDeletionStatusesAsync(int selectionVersion,
        CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(DeletionPollingInterval);
            while (_deletionRequests.Count > 0 &&
                   await timer.WaitForNextTickAsync(cancellationToken))
            {
                foreach (var requestId in _deletionRequests.Keys.ToArray())
                {
                    DocumentLibraryFileDeletionStatusDto result;
                    try
                    {
                        result = await Api.GetAsync<DocumentLibraryFileDeletionStatusDto>(
                            $"/api/document-library/file-deletions/{requestId}");
                    }
                    catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
                    {
                        return;
                    }
                    catch { continue; }
                    if (cancellationToken.IsCancellationRequested ||
                        selectionVersion != _selectionVersion) return;
                    await InvokeAsync(() =>
                    {
                        ApplyDeletionStatus(result);
                        if (result.Completed ||
                            result.Status == DocumentLibraryFileDeletionStatuses.Failed &&
                            !result.Retryable)
                            _deletionRequests.Remove(requestId);
                        StateHasChanged();
                    });
                }
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        finally
        {
            if (!cancellationToken.IsCancellationRequested) await InvokeAsync(() =>
            {
                _deletionPollingTask = null;
                if (_deletionRequests.Count > 0 && selectionVersion == _selectionVersion)
                    EnsureDeletionPolling();
            });
        }
    }

    private void ApplyDeletionStatus(DocumentLibraryFileDeletionStatusDto result)
    {
        var custom = _files.FirstOrDefault(x => x.Id == result.FileId);
        var system = _selectedSystemFolder?.Files.FirstOrDefault(x => x.FileId == result.FileId);
        if (result.Completed)
        {
            if (custom is not null)
            {
                _files.Remove(custom);
                if (_selectedFolder is not null && _selectedFolder.DocumentCount > 0)
                    _selectedFolder.DocumentCount--;
            }
            if (system is not null)
            {
                _selectedSystemFolder!.Files.Remove(system);
                if (_selectedSystemFolder.DocumentCount > 0) _selectedSystemFolder.DocumentCount--;
            }
            _trackedFileIds.Remove(result.FileId);
            _uploadTrackedIds.Remove(result.FileId);
            _trackingStartedAt.Remove(result.FileId);
            _latestArchiveStatuses.Remove(result.FileId);
            _deletionRequests.Remove(result.RequestId);
            return;
        }

        if (custom is not null)
        {
            custom.CanDelete = false;
            custom.DeletionRequestId = result.RequestId;
            custom.DeletionStatus = result.Status;
            custom.DeletionStatusDisplay = result.StatusDisplay;
            custom.DeletionError = result.ErrorMessage;
        }
        if (system is not null)
        {
            system.CanDelete = false;
            system.DeletionRequestId = result.RequestId;
            system.DeletionStatus = result.Status;
            system.DeletionStatusDisplay = result.StatusDisplay;
            system.DeletionError = result.ErrorMessage;
        }
    }

    private async Task CancelDeletionPollingAsync()
    {
        if (_deletionPollingCts is not null)
        {
            await _deletionPollingCts.CancelAsync();
            _deletionPollingCts.Dispose();
            _deletionPollingCts = null;
        }
        _deletionPollingTask = null;
        _deletionRequests.Clear();
        _deleteCandidate = null;
    }

    private static string ApiErrorMessage(string body, string fallback)
    {
        if (string.IsNullOrWhiteSpace(body)) return fallback;
        try
        {
            using var json = global::System.Text.Json.JsonDocument.Parse(body);
            return json.RootElement.TryGetProperty("message", out var message) &&
                   !string.IsNullOrWhiteSpace(message.GetString())
                ? message.GetString()!
                : fallback;
        }
        catch (global::System.Text.Json.JsonException) { return fallback; }
    }

    private void ShowMessage(string message, bool isError)
    {
        CancelAndDispose(ref _messageCts);
        var version = ++_messageVersion;
        _message = message;
        _isError = isError;
        _messageCts = new CancellationTokenSource();
        _ = HideMessageAfterAsync(version,
            isError ? FailureNoticeLifetime : SuccessMessageLifetime, _messageCts.Token);
    }

    private async Task HideMessageAfterAsync(long version, TimeSpan delay, CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(delay, cancellationToken);
            await InvokeAsync(() =>
            {
                if (version != _messageVersion || cancellationToken.IsCancellationRequested) return;
                _message = null;
                StateHasChanged();
            });
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    private void ClearMessage()
    {
        _messageVersion++;
        CancelAndDispose(ref _messageCts);
        _message = null;
    }

    private void ShowUploadResults(IReadOnlyCollection<DocumentUploadResultDto> results)
    {
        ClearUploadResults();
        var version = _uploadResultsVersion;
        _uploadResultsCts = new CancellationTokenSource();
        _uploadResults = results.Select(x => new UploadResultNotice(Guid.NewGuid(), x)).ToList();
        foreach (var notice in _uploadResults)
            _ = HideUploadResultAfterAsync(notice.Id, version,
                notice.Result.Success ? SuccessResultLifetime : FailureNoticeLifetime,
                _uploadResultsCts.Token);
    }

    private async Task HideUploadResultAfterAsync(Guid noticeId, long version, TimeSpan delay,
        CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(delay, cancellationToken);
            await InvokeAsync(() =>
            {
                if (version != _uploadResultsVersion || cancellationToken.IsCancellationRequested) return;
                _uploadResults.RemoveAll(x => x.Id == noticeId);
                StateHasChanged();
            });
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    private void DismissUploadResult(Guid noticeId) =>
        _uploadResults.RemoveAll(x => x.Id == noticeId);

    private void ClearUploadResults()
    {
        _uploadResultsVersion++;
        CancelAndDispose(ref _uploadResultsCts);
        _uploadResults = [];
    }

    private void ShowUploadProgress()
    {
        _progressVersion++;
        CancelAndDispose(ref _progressHideCts);
        _showUploadProgress = true;
    }

    private void UpdateProgressVisibility()
    {
        if (_trackingTimedOut)
        {
            DismissUploadProgress();
            return;
        }
        if (_uploadTrackedIds.Count == 0) return;
        if (_uploadTrackedIds.Any(_trackedFileIds.Contains))
        {
            ShowUploadProgress();
            return;
        }
        if (!_showUploadProgress || _progressHideCts is not null) return;
        var version = ++_progressVersion;
        _progressHideCts = new CancellationTokenSource();
        _ = HideFinalProgressAfterAsync(version, _progressHideCts.Token);
    }

    private async Task HideFinalProgressAfterAsync(long version, CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(FinalProgressLifetime, cancellationToken);
            await InvokeAsync(() =>
            {
                if (version != _progressVersion || cancellationToken.IsCancellationRequested ||
                    _trackingTimedOut || _uploadTrackedIds.Any(_trackedFileIds.Contains)) return;
                _showUploadProgress = false;
                StateHasChanged();
            });
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    private void DismissUploadProgress()
    {
        _progressVersion++;
        CancelAndDispose(ref _progressHideCts);
        _showUploadProgress = false;
    }

    private static void CancelAndDispose(ref CancellationTokenSource? source)
    {
        var current = source;
        source = null;
        if (current is null) return;
        current.Cancel();
        current.Dispose();
    }

    public async ValueTask DisposeAsync()
    {
        ClearMessage();
        ClearUploadResults();
        DismissUploadProgress();
        await CancelDeletionPollingAsync();
        await CancelStatusTrackingAsync();
    }

    private void ShowError(string message) => ShowMessage(message, isError: true);
    private int SelectedFolderLevel => _selectedFolder?.Level ?? _selectedSystemFolder?.Level ?? 0;
    private string SelectedFolderName => _selectedFolder?.Name ?? _selectedSystemFolder?.Name ?? string.Empty;
    private string? SelectedFolderDescription => _selectedFolder?.Description ?? _selectedSystemFolder?.Description;
    private int SelectedFileCount => _selectedFolder is not null ? _files.Count : _selectedSystemFolder?.Files.Count ?? 0;
    private static bool IsImage(string? contentType, string fileName) =>
        DocumentLibraryRules.IsPreviewableImage(contentType, fileName);
    private void OpenPreview(string url, string name) { _previewUrl = url; _previewName = name; }
    private void ClosePreview() { _previewUrl = null; _previewName = null; }
    private static string DocumentPreviewUrl(Guid id) => $"/api/document-library/files/{id}/preview";
    private static string DisplayDescription(string? value) => string.IsNullOrWhiteSpace(value) ? "未填寫說明" : value;
    private static string DisplayUploader(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private static AttachmentStatusValue Status(string text, string tone) => new(text, tone);
    private static string FormatSize(long bytes) => bytes >= 1_000_000
        ? $"{bytes / 1_000_000d:0.##} MB"
        : bytes >= 1_000 ? $"{bytes / 1_000d:0.##} KB" : $"{bytes} B";
    private static string StatusDetails(DocumentLibraryFileDto file) =>
        file.ArchiveError ?? file.ProcessingError ?? file.ProcessingStatusDisplay;

    private sealed record UploadResultNotice(Guid Id, DocumentUploadResultDto Result);
    private sealed record DeletionCandidate(Guid FileId, string FileName, string? UploadedBy,
        DateTime UploadedAt, string ArchiveStatus, string KmStatus);
