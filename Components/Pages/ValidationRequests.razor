@page "/validation-requests"
@page "/validation-requests/{Id:guid}"
@layout ApplicantLayout
@attribute [Authorize(Policy = SystemAuthorization.Policies.ReservationUser)]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using SIT.DepartmentSystem.Web.Entities
@using SIT.DepartmentSystem.Web.Services.ValidationRequests
@inject IValidationRequestConfigurationService ValidationService
@inject IVerificationApplicationService Applications
@inject ISystemOptionService SystemOptions
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Nav

<PageTitle>驗證測試申請單</PageTitle>

<header class="validation-request-header">
    <div><span class="eyebrow">RD APPLICATION</span><h1>驗證測試申請單</h1><p>可先儲存草稿；正式送出後將沿用既有主管審核流程。</p></div>
    <button type="button" class="btn-secondary" @onclick="OpenMyApplications">我的驗證申請</button>
</header>

@if (_error is not null) { <div class="alert alert-danger">@_error</div> }
else if (_loading || _configuration is null) { <div class="validation-loading">正在載入申請表…</div> }
else
{
    @if (_existing is not null)
    {
        <div class="surface-card workflow-summary"><strong>@_existing.ApplicationNo</strong><span>狀態：@StatusText(_existing.Status)</span></div>
    }
    <ValidationRequestPreview Preview="_preview" ProductTypes="_configuration.ProductTypes"
                              SelectedProductCode="_selectedProduct" SelectedProductCodeChanged="ChangeProduct"
                              Values="_values" SelectedTestItemCodes="_selectedTests" TestParameterValues="_testParameters"
                              DepartmentOptions="_departments" />

    <div class="surface-card form-actions validation-save-actions">
        <button type="button" class="btn-primary" disabled="@_saving" @onclick="() => SaveAsync(false)">儲存草稿</button>
        <button type="button" class="btn-primary" disabled="@_saving" @onclick="() => SaveAsync(true)">正式送出</button>
        <button type="button" class="btn-secondary" disabled="@_saving" @onclick="Cancel">取消</button>
    </div>
}

<style>
    .workflow-summary { display:flex; justify-content:space-between; margin-bottom:16px; }
    .validation-save-actions { margin-top:18px; }
</style>

@code {
    [Parameter] public Guid? Id { get; set; }
    private ValidationRequestConfigurationDto? _configuration;
    private ValidationRequestPreviewDto? _preview;
    private VerificationApplicationDto? _existing;
    private readonly UpdateVerificationApplicationRequest _form = new();
    private Dictionary<string, List<string>> _values = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _selectedTests = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, Dictionary<string, List<string>>> _testParameters = new(StringComparer.OrdinalIgnoreCase);
    private List<SystemOptionDto> _departments = [];
    private string _selectedProduct = "";
    private string? _error;
    private bool _loading = true;
    private bool _saving;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true; _error = null;
        try
        {
            _configuration = await ValidationService.GetConfigurationAsync();
            _departments = (await SystemOptions.GetEnabledByCategoryAsync(SystemOptionCategories.Department)).Where(x => DepartmentFamilyMatcher.IsDa40Family(x.Value)).ToList();
            if (Id.HasValue)
            {
                var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
                _existing = await Applications.GetForApplicantAsync(Id.Value, user) ?? throw new InvalidOperationException("找不到申請，或您無權存取。");
                if (_existing.Status is not (VerificationApplicationStatus.Draft or VerificationApplicationStatus.Returned)) throw new InvalidOperationException("此申請目前不可修改。");
                if (_existing.ValidationRequest?.FormSnapshot is null) throw new InvalidOperationException("舊版申請請使用原有編輯畫面。");
                CopyExisting(_existing);
            }
            else
            {
                _selectedProduct = _configuration.ProductTypes.Where(x => x.IsEnabled).OrderBy(x => x.DisplayOrder).FirstOrDefault()?.Code ?? "";
                await LoadPreview();
            }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private void CopyExisting(VerificationApplicationDto item)
    {
        _form.ProjectName = item.ProjectName; _form.Customer = item.Customer; _form.ValidationRequirement = item.ValidationRequirement;
        var request = item.ValidationRequest!;
        _selectedProduct = request.ProductTypeCode; _preview = request.FormSnapshot;
        _values = new(request.FieldValues, StringComparer.OrdinalIgnoreCase);
        _selectedTests = new(request.SelectedTestItemCodes, StringComparer.OrdinalIgnoreCase);
        _testParameters = new(request.TestParameterValues, StringComparer.OrdinalIgnoreCase);
    }

    private async Task ChangeProduct(string code)
    {
        if (string.IsNullOrWhiteSpace(code) || code == _selectedProduct) return;
        _selectedProduct = code; await LoadPreview();
    }

    private async Task LoadPreview()
    {
        if (!string.IsNullOrWhiteSpace(_selectedProduct)) _preview = await ValidationService.GetPreviewAsync(_selectedProduct);
    }

    private async Task SaveAsync(bool submit)
    {
        _saving = true; _error = null;
        try
        {
            if (_preview is null) throw new InvalidOperationException("申請表尚未載入。");
            _form.ValidationRequest = new ValidationRequestSubmissionDto
            {
                TemplateVersionId = _preview.TemplateVersionId, TemplateVersion = _preview.TemplateVersion,
                ProductTypeCode = _preview.ProductTypeCode, FieldValues = _values,
                SelectedTestItemCodes = _selectedTests, TestParameterValues = _testParameters, FormSnapshot = _preview
            };
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            VerificationApplicationDto saved = Id.HasValue
                ? await Applications.UpdateDraftAsync(Id.Value, user, _form)
                : await Applications.CreateDraftAsync(user, ToCreate());
            if (submit) saved = await Applications.SubmitAsync(saved.Id, user);
            Nav.NavigateTo($"/verification-applications/{saved.Id}");
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saving = false; }
    }

    private CreateVerificationApplicationRequest ToCreate() => new()
    {
        ValidationRequest = _form.ValidationRequest
    };
    private static string StatusText(VerificationApplicationStatus status) => status switch { VerificationApplicationStatus.Draft => "草稿", VerificationApplicationStatus.Returned => "已退回", _ => status.ToString() };
    private void Cancel() => Nav.NavigateTo("/verification-applications");
    private void OpenMyApplications() => Nav.NavigateTo("/verification-applications");
}
