@page "/validation-requests"
@page "/validation-requests/{Id:guid}"
@layout ApplicantLayout
@attribute [Authorize(Policy = SystemAuthorization.Policies.ReservationUser)]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using SIT.DepartmentSystem.Web.Entities
@using SIT.DepartmentSystem.Web.Services.ValidationRequests
@inject IValidationRequestConfigurationService ValidationService
@inject IVerificationApplicationService Applications
@inject ISystemOptionService SystemOptions
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<ValidationRequests> Logger

<PageTitle>驗證測試申請單</PageTitle>

<AppMessageDialog Visible="_showAbandonDialog"
                  Title="放棄申請單"
                  Message="確定放棄此申請單？草稿及其附件將被刪除，此操作無法復原。"
                  Type="AppMessageDialogType.Warning"
                  ShowCancel="true"
                  CancelText="繼續編輯"
                  ConfirmText="放棄申請"
                  ConfirmIsDanger="true"
                  OnClose="ContinueEditing"
                  OnConfirm="AbandonDraftAsync" />

<header class="validation-request-header">
    <div><span class="eyebrow">RD APPLICATION</span><h1>驗證測試申請單</h1><p>可先儲存草稿；正式送出後將沿用既有主管審核流程。</p></div>
    <button type="button" class="btn-secondary" @onclick="OpenMyApplications">我的驗證申請</button>
</header>

@if (!string.IsNullOrWhiteSpace(_validationGuidance)) { <div class="alert alert-warning validation-guidance">@_validationGuidance</div> }
@if (!string.IsNullOrWhiteSpace(_operationSuccess)) { <div class="alert alert-success validation-operation-message">@_operationSuccess</div> }
@if (!string.IsNullOrWhiteSpace(_operationError)) { <div class="alert alert-danger validation-operation-message">@_operationError</div> }
@if (_error is not null) { <div class="alert alert-danger">@_error</div> }
else if (_loading || _configuration is null) { <div class="validation-loading">正在載入申請表…</div> }
else
{
    @if (_existing is not null)
    {
        <div class="surface-card workflow-summary"><strong>@_existing.ApplicationNo</strong><span>狀態：@StatusText(_existing.Status)</span></div>
    }
    <ValidationRequestPreview Preview="_preview" ProductTypes="_configuration.ProductTypes"
                              SelectedProductCode="_selectedProduct" SelectedProductCodeChanged="ChangeProduct"
                              Values="_values" SelectedTestItemCodes="_selectedTests" TestParameterValues="_testParameters"
                              DepartmentOptions="_departments" AttachmentApplicationId="@(_draftId ?? Id)"
                              AttachmentsManageable="true" EnsureAttachmentApplicationId="EnsureAttachmentDraftAsync"
                              AttachmentDraftEnsured="AttachmentDraftEnsured"
                              RequestedActiveTab="ValidationArea" ActiveTabRequestVersion="_validationFocusRevision"
                              FocusFieldCode="ValidationField" />

    @if (_directApproval)
    {
        <div id="validation-field-@VerificationApplicationValidationIssue.ExpectedEndDateFieldCode"
             class="surface-card direct-approval-date @(IsExpectedEndDateFocused ? "validation-field-focus" : null)">
            <strong>主管自行送單免審</strong>
            <p>正式送出後將直接核准並建立 Record，請先填寫預計結束日期。</p>
            <label>預計結束日期（必填）</label>
            <DatePickerInput @bind-Value="_expectedEndDate" PickerLabel="選擇預計結束日期" />
        </div>
    }

    <div class="surface-card form-actions validation-save-actions">
        <button type="button" class="btn-primary" disabled="@_saving" @onclick="() => SaveAsync(false)">儲存草稿</button>
        <button type="button" class="btn-primary" disabled="@_saving" @onclick="() => SaveAsync(true)">正式送出</button>
        <button type="button" class="btn-secondary" disabled="@_saving" @onclick="Cancel">取消</button>
    </div>
}

<style>
    .workflow-summary { display:flex; justify-content:space-between; margin-bottom:16px; }
    .validation-save-actions { margin-top:18px; }
    .direct-approval-date { margin-top:18px; display:grid; gap:8px; }
    .direct-approval-date p { margin:0; color:#64748b; }
    .direct-approval-date input { max-width:240px; }
    .validation-guidance { margin-bottom:16px; font-weight:700; }
    .validation-operation-message { margin-bottom:16px; }
    .direct-approval-date.validation-field-focus { outline:3px solid #f59e0b; outline-offset:3px; background:#fffbeb; }
</style>

@code {
    [Parameter] public Guid? Id { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "validationArea")] public string? ValidationArea { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "validationAreaLabel")] public string? ValidationAreaLabel { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "validationField")] public string? ValidationField { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "validationMessage")] public string? ValidationMessage { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "draftSaved")] public bool DraftSaved { get; set; }
    private ValidationRequestConfigurationDto? _configuration;
    private ValidationRequestPreviewDto? _preview;
    private VerificationApplicationDto? _existing;
    private readonly UpdateVerificationApplicationRequest _form = new();
    private Dictionary<string, List<string>> _values = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _selectedTests = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, Dictionary<string, List<string>>> _testParameters = new(StringComparer.OrdinalIgnoreCase);
    private List<SystemOptionDto> _departments = [];
    private string _selectedProduct = "";
    private string? _error;
    private string? _validationGuidance;
    private string? _operationSuccess;
    private string? _operationError;
    private bool _loading = true;
    private bool _saving;
    private bool _showAbandonDialog;
    private bool _directApproval;
    private bool _scrollToValidationField;
    private int _validationFocusRevision;
    private DateOnly? _expectedEndDate;
    private Guid? _draftId;
    private readonly SemaphoreSlim _draftMutationGate = new(1, 1);

    private bool IsExpectedEndDateFocused => string.Equals(
        ValidationField,
        VerificationApplicationValidationIssue.ExpectedEndDateFieldCode,
        StringComparison.OrdinalIgnoreCase);

    protected override async Task OnParametersSetAsync()
    {
        _loading = true; _error = null; _validationGuidance = null; _operationError = null;
        _operationSuccess = DraftSaved ? "草稿已成功儲存。" : null;
        _scrollToValidationField = false;
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            _directApproval = await Applications.IsDirectApprovalApplicantAsync(user);
            _configuration = await ValidationService.GetConfigurationAsync();
            _departments = (await SystemOptions.GetEnabledByCategoryAsync(SystemOptionCategories.Department)).ToList();
            if (Id.HasValue)
            {
                _draftId = Id.Value;
                _existing = await Applications.GetForApplicantAsync(Id.Value, user) ?? throw new InvalidOperationException("找不到申請，或您無權存取。");
                if (_existing.Status is not (VerificationApplicationStatus.Draft or VerificationApplicationStatus.Returned)) throw new InvalidOperationException("此申請目前不可修改。");
                if (_existing.ValidationRequest?.FormSnapshot is null) throw new InvalidOperationException("舊版申請請使用原有編輯畫面。");
                CopyExisting(_existing);
                if (!string.IsNullOrWhiteSpace(ValidationMessage))
                {
                    _validationGuidance = BuildValidationGuidance(
                        ValidationArea,
                        ValidationAreaLabel,
                        ValidationMessage,
                        returnedToDraft: true);
                    _scrollToValidationField = !string.IsNullOrWhiteSpace(ValidationField);
                    _validationFocusRevision++;
                }
            }
            else
            {
                _draftId = null;
                _selectedProduct = _configuration.ProductTypes.Where(x => x.IsEnabled).OrderBy(x => x.DisplayOrder).FirstOrDefault()?.Code ?? "";
                await LoadPreview();
            }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private void CopyExisting(VerificationApplicationDto item)
    {
        _form.ProjectName = item.ProjectName; _form.Customer = item.Customer; _form.ValidationRequirement = item.ValidationRequirement;
        var request = item.ValidationRequest!;
        _selectedProduct = request.ProductTypeCode; _preview = request.FormSnapshot;
        _values = new(request.FieldValues, StringComparer.OrdinalIgnoreCase);
        _selectedTests = new(request.SelectedTestItemCodes, StringComparer.OrdinalIgnoreCase);
        _testParameters = new(request.TestParameterValues, StringComparer.OrdinalIgnoreCase);
    }

    private async Task ChangeProduct(string code)
    {
        if (string.IsNullOrWhiteSpace(code) || code == _selectedProduct) return;
        _selectedProduct = code; await LoadPreview();
    }

    private async Task LoadPreview()
    {
        if (!string.IsNullOrWhiteSpace(_selectedProduct)) _preview = await ValidationService.GetPreviewAsync(_selectedProduct);
        if (!Id.HasValue && !_values.ContainsKey("LOCATION")) _values["LOCATION"] = ["TAIPEI"];
    }

    private async Task SaveAsync(bool submit)
    {
        if (!await _draftMutationGate.WaitAsync(0)) return;
        _saving = true; _error = null; _validationGuidance = null; _operationSuccess = null; _operationError = null;
        try
        {
            var saved = await SaveDraftCoreAsync();
            if (submit)
            {
                var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
                saved = await Applications.SubmitAsync(saved.Id, user, _expectedEndDate);
                Nav.NavigateTo($"/verification-applications/{saved.Id}");
                return;
            }

            _operationSuccess = "草稿已成功儲存。";
            if (!Id.HasValue)
                Nav.NavigateTo($"/validation-requests/{saved.Id}?draftSaved=true", replace: true);
        }
        catch (VerificationApplicationValidationException ex)
        {
            var issue = ex.Issues[0];
            ValidationArea = issue.AreaCode;
            ValidationAreaLabel = issue.AreaLabel;
            ValidationField = issue.FieldCode;
            _validationGuidance = BuildValidationGuidance(
                issue.AreaCode,
                issue.AreaLabel,
                ex.Message,
                returnedToDraft: false);
            _scrollToValidationField = !string.IsNullOrWhiteSpace(ValidationField);
            _validationFocusRevision++;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, submit
                ? "正式送出驗證申請失敗。ApplicationId: {ApplicationId}"
                : "儲存驗證申請草稿失敗。ApplicationId: {ApplicationId}", _draftId);
            _operationError = submit
                ? "正式送出失敗，草稿仍保留，請稍後再試；若問題持續請聯絡系統管理員。"
                : "草稿儲存失敗，請稍後再試；若問題持續請聯絡系統管理員。";
        }
        finally
        {
            _saving = false;
            _draftMutationGate.Release();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_scrollToValidationField || string.IsNullOrWhiteSpace(ValidationField)) return;
        _scrollToValidationField = false;
        await JS.InvokeVoidAsync("csitScrollIntoView", $"validation-field-{ValidationField}");
    }

    private async Task<Guid> EnsureAttachmentDraftAsync()
    {
        await _draftMutationGate.WaitAsync();
        _saving = true; _error = null; _operationError = null;
        try { return (await SaveDraftCoreAsync()).Id; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "建立附件所需的驗證申請草稿失敗。ApplicationId: {ApplicationId}", _draftId);
            const string message = "無法儲存附件所需的草稿，請稍後再試；若問題持續請聯絡系統管理員。";
            _operationError = message;
            throw new InvalidOperationException(message);
        }
        finally
        {
            _saving = false;
            _draftMutationGate.Release();
        }
    }

    private async Task<VerificationApplicationDto> SaveDraftCoreAsync()
    {
        if (_preview is null) throw new InvalidOperationException("申請表尚未載入。");
        _form.ValidationRequest = new ValidationRequestSubmissionDto
        {
            TemplateVersionId = _preview.TemplateVersionId, TemplateVersion = _preview.TemplateVersion,
            ProductTypeCode = _preview.ProductTypeCode, FieldValues = _values,
            SelectedTestItemCodes = _selectedTests, TestParameterValues = _testParameters, FormSnapshot = _preview
        };
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var saved = _draftId.HasValue
            ? await Applications.UpdateDraftAsync(_draftId.Value, user, _form)
            : await Applications.CreateDraftAsync(user, ToCreate());
        _draftId = saved.Id;
        _existing = saved;
        return saved;
    }

    private void AttachmentDraftEnsured(Guid id)
    {
        _draftId = id;
        if (!Id.HasValue) Nav.NavigateTo($"/validation-requests/{id}", replace: true);
    }

    private static string BuildValidationGuidance(
        string? areaCode,
        string? areaLabel,
        string message,
        bool returnedToDraft)
    {
        if (string.Equals(
            areaCode,
            VerificationApplicationValidationIssue.DirectApprovalAreaCode,
            StringComparison.OrdinalIgnoreCase)) return message;

        var area = string.IsNullOrWhiteSpace(areaLabel) ? "未完成" : areaLabel;
        var prefix = returnedToDraft ? "正式送出未完成，已返回原草稿。" : "正式送出未完成。";
        return $"{prefix}請在「{area}」區域補齊資料後重新送出。{message}";
    }

    private CreateVerificationApplicationRequest ToCreate() => new()
    {
        ValidationRequest = _form.ValidationRequest
    };
    private static string StatusText(VerificationApplicationStatus status) => status switch { VerificationApplicationStatus.Draft => "草稿", VerificationApplicationStatus.Returned => "已退回", _ => status.ToString() };
    private void Cancel()
    {
        if (_draftId.HasValue && _existing?.Status == VerificationApplicationStatus.Draft)
        {
            _showAbandonDialog = true;
            return;
        }
        Nav.NavigateTo("/verification-applications");
    }

    private void ContinueEditing() => _showAbandonDialog = false;

    private async Task AbandonDraftAsync()
    {
        _showAbandonDialog = false;
        if (!_draftId.HasValue)
        {
            Nav.NavigateTo("/verification-applications");
            return;
        }

        _saving = true; _error = null;
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            await Applications.DeleteDraftAsync(_draftId.Value, user);
            Nav.NavigateTo("/verification-applications");
        }
        catch (Exception ex) { _error = $"放棄申請失敗：{ex.Message}"; }
        finally { _saving = false; }
    }
    private void OpenMyApplications() => Nav.NavigateTo("/verification-applications");
}
