@page "/reservation-review/{Id:guid}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Policy = SystemAuthorization.Policies.CsitStaff)]
@using SIT.DepartmentSystem.Web.Entities
@inject ReservationApiClient Api
@inject NavigationManager Nav

<PageTitle>@DetailTitle</PageTitle>

<div class="reservation-detail-page reservation-review-page">
    @if (!string.IsNullOrWhiteSpace(_message)) { <div class="surface-card error-text">@_message</div> }
    @if (_loading) { <div class="surface-card">載入中...</div> }
    else if (_item is not null)
    {
        <ReservationDetailContent Item="_item" Title="@DetailTitle" />

        @if (_item.ExtensionRequests.Any())
        {
            <section class="reservation-detail-card review-extension-card">
                <h2>續借申請</h2>
                <div class="review-extension-list">
                    @foreach (var extension in _item.ExtensionRequests.OrderByDescending(x => x.RequestedAt))
                    {
                        <article class="review-extension-item extension-detail-block">
                            <div class="extension-summary"><div><span>@ExtensionStatusText(extension.Status)</span><strong><LocalDateTime Value="extension.CurrentEndTimeSnapshot" /> → <LocalDateTime Value="extension.RequestedEndTime" /></strong><p>@extension.RequestedByName · <LocalDateTime Value="extension.RequestedAt" /></p></div>
                                @if (extension.CanApprove || extension.CanReject) { <div class="review-extension-actions"><button class="btn-secondary review-reject-button" disabled="@_working" @onclick="() => RejectExtensionAsync(extension.Id)">拒絕續借</button><button class="btn-primary" disabled="@_working" @onclick="() => ApproveExtensionAsync(extension.Id)">核准續借</button></div> }
                            </div>
                            @if (extension.Mode == ReservationMode.Environment)
                            {
                                <div class="extension-environment-context"><strong>測試環境：@ReservationUi.Display(extension.EquipmentGroupName)</strong><span>Owner Team：@ReservationUi.Display(extension.OwnerTeamName)</span>@if (extension.Status == ReservationExtensionRequestStatus.Pending && !extension.CanApprove) { <small>目前使用者無此 Environment 續借審核權限。</small> }</div>
                            }
                            else
                            {
                                <div class="extension-environment-context"><strong>單一設備：@ReservationUi.Display(extension.ApparatusNames.SingleOrDefault())</strong><span>保管人：@ReservationUi.Display(extension.CustodianName)</span><span>Owner Team：@ReservationUi.Display(extension.OwnerTeamName)</span>@if (extension.Status == ReservationExtensionRequestStatus.Pending && !extension.CanApprove) { <small>目前使用者無此設備續借審核權限。</small> }</div>
                            }
                        </article>
                    }
                </div>
            </section>
        }

        <div class="review-action-row">
            <button type="button" class="btn-secondary" disabled="@_working" @onclick="Back">@(IsOverdueContext ? "返回逾期管理" : "返回設備預約審核")</button>
            @if (IsOverdueContext && _item.Status is ReservationStatus.Approved or ReservationStatus.Borrowed)
            {
                <button type="button" class="btn-primary" disabled="@_working" @onclick="ReturnAsync">確認歸還</button>
            }
            else if (!IsOverdueContext && _item.Status == ReservationStatus.Pending && (_item.CanApprove || _item.CanReject))
            {
                <button type="button" class="btn-secondary review-reject-button" disabled="@_working" @onclick="RejectAsync">拒絕</button>
                <button type="button" class="btn-primary" disabled="@_working" @onclick="ApproveAsync">核准</button>
            }
            @if (_working) { <span class="hint-text">處理中...</span> }
        </div>
    }
</div>

<style>
    .reservation-detail-page { max-width:1280px; margin:0 auto; padding-bottom:28px; }
    .review-action-row,.review-extension-actions { display:flex; justify-content:flex-end; align-items:center; flex-wrap:wrap; gap:9px; }
    .review-action-row { margin-top:18px; }
    .review-reject-button { color:#fecaca; background:linear-gradient(135deg,#5a3540,#472d38); }
    .review-extension-list { display:grid; gap:10px; }
    .review-extension-item { display:block; padding:14px; border:1px solid rgba(148,163,184,.13); border-radius:12px; background:rgba(15,23,38,.48); }
    .review-extension-item span { display:block; margin-bottom:5px; color:#94a3b8; font-size:.8rem; font-weight:700; }
    .review-extension-item strong { color:#e8edf7; font-size:.9rem; }
    .review-extension-item p { margin:5px 0 0; color:#94a3b8; font-size:.84rem; }
    .extension-summary { display:flex; justify-content:space-between; align-items:center; gap:20px; }
    .extension-environment-context { display:grid; gap:5px; margin-top:12px; padding:11px; border-radius:9px; background:rgba(30,41,59,.5); color:#94a3b8; }
    .extension-environment-context strong { color:#e8edf7; }
    @@media(max-width:620px) {
        .extension-summary { align-items:stretch; flex-direction:column; }
        .review-extension-actions,.review-action-row { justify-content:stretch; width:100%; }
        .review-extension-actions button,.review-action-row button { flex:1 1 auto; }
    }
</style>

@code {
    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery(Name = "from")] public string? From { get; set; }
    [SupplyParameterFromQuery(Name = "scope")] public string? ScopeValue { get; set; }
    private ReservationDetailDto? _item;
    private bool _loading = true;
    private bool _working;
    private string? _message;
    private Guid? _contextReservationId;
    private bool _isOverdueContext;
    private ReservationReviewScope Scope => Enum.TryParse<ReservationReviewScope>(ScopeValue, true, out var value) ? value : ReservationReviewScope.Custodian;
    private bool IsOverdueContext => _isOverdueContext;
    private string DetailTitle => IsOverdueContext ? "設備預約逾期明細" : "設備預約審核";
    protected override async Task OnParametersSetAsync() { if (_contextReservationId != Id) { _contextReservationId = Id; _isOverdueContext = string.Equals(From, "overdue", StringComparison.OrdinalIgnoreCase); } else if (string.Equals(From, "overdue", StringComparison.OrdinalIgnoreCase)) _isOverdueContext = true; await LoadAsync(); }
    private async Task LoadAsync() { _loading = true; _message = null; try { _item = IsOverdueContext ? await Api.GetAsync(Id) : await Api.ReviewDetailAsync(Id, Scope); } catch (Exception ex) { _item = null; _message = ex.Message; } finally { _loading = false; } }
    private async Task ApproveAsync() { if (await Api.ConfirmAsync("確定核准整張預約？")) await ExecuteAndReloadAsync(() => Api.ApproveAsync(Id)); }
    private async Task RejectAsync() { var reason = await Api.PromptReasonAsync("請輸入拒絕原因："); if (string.IsNullOrWhiteSpace(reason)) { if (reason is not null) _message = "拒絕原因不可空白。"; return; } if (await Api.ConfirmAsync("確定拒絕整張預約？")) await ExecuteAndReloadAsync(() => Api.RejectAsync(Id, reason)); }
    private async Task ReturnAsync() { if (await Api.ConfirmAsync("確定設備已歸還？")) await ExecuteAndReloadAsync(() => Api.ReturnAsync(Id)); }
    private async Task ExecuteAndReloadAsync(Func<Task<ReservationDetailDto>> action) { _working = true; _message = null; try { await action(); await LoadAsync(); } catch (Exception ex) { _message = ex.Message; } finally { _working = false; } }
    private async Task ApproveExtensionAsync(Guid id) { if (!await Api.ConfirmAsync("確定核准續借？")) return; _working = true; try { await Api.ApproveExtensionAsync(id); await LoadAsync(); } catch (Exception ex) { _message = ex.Message; } finally { _working = false; } }
    private async Task RejectExtensionAsync(Guid id) { var reason = await Api.PromptReasonAsync("請輸入拒絕原因："); if (string.IsNullOrWhiteSpace(reason)) return; _working = true; try { await Api.RejectExtensionAsync(id, reason); await LoadAsync(); } catch (Exception ex) { _message = ex.Message; } finally { _working = false; } }
    private static string ExtensionStatusText(ReservationExtensionRequestStatus status) => status switch { ReservationExtensionRequestStatus.Pending => "待審核", ReservationExtensionRequestStatus.Approved => "已核准", ReservationExtensionRequestStatus.Rejected => "已拒絕", ReservationExtensionRequestStatus.Cancelled => "已取消", _ => status.ToString() };
    private void Back() => Nav.NavigateTo(IsOverdueContext ? "/reservation-overdue" : "/reservation-review");
}
