@page "/modules/{moduleCode}/{recordId:guid}/cases/{caseId:guid}"
@attribute [Authorize(Policy = SystemAuthorization.Policies.CsitStaff)]
@rendermode InteractiveServer
@using global::System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http
@inject NavigationManager Nav

<div class="case-page">
    <div class="case-title-row">
        <div>
            <h1>Case 詳細</h1>
            <p>CASE INFORMATION</p>
        </div>

        <div class="case-actions">
            <button type="button" class="btn-primary" @onclick="EditCase">修改 Case</button>
            <button type="button" class="btn-primary" @onclick="CreateTask">新增 Task</button>
            <button type="button" class="table-chip-btn danger" @onclick="DeleteCaseAsync" disabled="@_deleting">
                @(_deleting ? "刪除中..." : "刪除 Case")
            </button>
            <button type="button" class="btn-secondary" @onclick="BackToRecord">回主單</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="surface-card case-card error-text">@_message</div>
    }

    @if (_case == null)
    {
        <div class="surface-card case-card">Loading...</div>
    }
    else
    {
        <section class="surface-card case-card">
            <div class="case-card-head">
                <div>
                    <div class="case-kicker">CASE INFORMATION</div>
                    <h2>@_case.Name</h2>
                </div>
                <span class="record-status-pill">@_case.Status</span>
            </div>

            <div class="case-detail-grid">
                <div class="case-detail-item"><span>Case No</span><strong>@_case.CaseNo</strong></div>
                <div class="case-detail-item"><span>任務名稱</span><strong>@Display(_case.Name)</strong></div>
                <div class="case-detail-item"><span>Status</span><strong>@Display(_case.Status)</strong></div>
                <div class="case-detail-item"><span>Sort</span><strong>@_case.SortOrder</strong></div>
                <div class="case-detail-item case-detail-full"><span>備註</span><strong>@Display(_case.Note)</strong></div>
            </div>
        </section>

        <section class="surface-card case-card">
            <div class="case-tabs">
                <button class="case-tab @(GetTabClass("Open"))" @onclick='() => ChangeTab("Open")'>Open</button>
                <button class="case-tab @(GetTabClass("Close"))" @onclick='() => ChangeTab("Close")'>Close</button>
                <button class="case-tab @(GetTabClass("Hold"))" @onclick='() => ChangeTab("Hold")'>Hold</button>
                <button class="case-tab @(GetTabClass("Upload"))" @onclick='() => ChangeTab("Upload")'>檔案上傳</button>
                <button class="case-tab @(GetTabClass("Files"))" @onclick='() => ChangeTab("Files")'>檔案清單</button>
            </div>

            @if (_activeTab == "Open" || _activeTab == "Close" || _activeTab == "Hold")
            {
                <div class="case-card-head">
                    <div>
                        <div class="case-kicker">TASKS</div>
                        <h2>@_activeTab 子任務</h2>
                    </div>
                    <button type="button" class="btn-primary" @onclick="CreateTask">+ 新增 Task</button>
                </div>

                @if (FilteredTasks.Count == 0)
                {
                    <div class="record-empty-box">
                        <strong>目前沒有 @_activeTab Task</strong>
                        <span>按上方「新增 Task」建立第一筆。</span>
                    </div>
                }
                else
                {
                    <div class="project-table-wrap">
                        <table class="project-table">
                            <thead>
                                <tr>
                                    <th>子任務名稱</th>
                                    <th>驗證工程師</th>
                                    <th>開始日期</th>
                                    <th>預計完成日</th>
                                    <th>結果判定</th>
                                    <th>狀態</th>
                                    <th>進度</th>
                                    <th>子任務ID</th>
                                    <th>操作</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in FilteredTasks)
                                {
                                    <tr class="clickable-row" @onclick="() => ViewTask(item.Id)">
                                        <td>@item.Name</td>
                                        <td>@item.AssignEngineer</td>
                                        <td>@DisplayDate(item.StartDate)</td>
                                        <td>@DisplayDate(item.ExpectedEndDate)</td>
                                        <td>@Display(item.Result)</td>
                                        <td>@Display(item.Status)</td>
                                        <td>@item.Progress%</td>
                                        <td>@item.TaskNo</td>
                                        <td class="action-cell">
                                            <button type="button"
                                                    class="table-chip-btn danger"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="() => DeleteTaskFromListAsync(item.Id)">
                                                刪除
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
            else if (_activeTab == "Upload")
            {
                <div class="case-card-head">
                    <div>
                        <div class="case-kicker">FILE UPLOAD</div>
                        <h2>檔案上傳</h2>
                    </div>
                </div>

                <div class="upload-box">
                    <InputFile OnChange="OnFilesSelected" multiple />
                    <button type="button" class="btn-primary" @onclick="UploadFilesAsync" disabled="@(_selectedFiles.Count == 0)">
                        儲存
                    </button>
                </div>

                @if (_selectedFiles.Count > 0)
                {
                    <div class="upload-list">
                        @foreach (var file in _selectedFiles)
                        {
                            <div class="upload-file-item">
                                <span>@file.Name</span>
                                <strong>@FormatSize(file.Size)</strong>
                            </div>
                        }
                    </div>
                }
            }
            else if (_activeTab == "Files")
            {
                <div class="case-card-head">
                    <div>
                        <div class="case-kicker">FILE LIST</div>
                        <h2>檔案清單</h2>
                    </div>
                    <button type="button" class="btn-primary" @onclick="ReloadFilesAsync">重新整理</button>
                </div>

                @if (_files.Count == 0)
                {
                    <div class="record-empty-box">
                        <strong>目前沒有檔案</strong>
                        <span>請到「檔案上傳」選擇檔案並儲存。</span>
                    </div>
                }
                else
                {
                    <div class="project-table-wrap">
                        <table class="project-table">
                            <thead>
                                <tr>
                                    <th>文件名稱</th>
                                    <th>大小</th>
                                    <th>上傳時間</th>
                                    <th>上傳者</th>
                                    <th>操作</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var file in _files)
                                {
                                    <tr>
                                        <td>@file.FileName</td>
                                        <td>@FormatSize(file.FileSize)</td>
                                        <td>@file.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                                        <td>@Display(file.UploadEmp)</td>
                                        <td class="action-cell">
                                            <a class="table-link-btn" href="@($"/api/files/{file.Id}/download")" target="_blank">下載</a>
                                            <button type="button" class="table-chip-btn danger" @onclick="() => DeleteFileAsync(file.Id)">刪除</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </section>
    }
</div>

@code {
    [Parameter] public string moduleCode { get; set; } = string.Empty;
    [Parameter] public Guid recordId { get; set; }
    [Parameter] public Guid caseId { get; set; }

    private string _activeTab = "Open";
    private bool _deleting;
    private string? _message;

    private ModuleCaseDetailDto? _case;
    private List<ModuleTaskListItemDto> _tasks = new();
    private List<ModuleCaseFileDto> _files = new();
    private List<IBrowserFile> _selectedFiles = new();

    private List<ModuleTaskListItemDto> FilteredTasks =>
        _tasks.Where(x => x.Status == _activeTab).ToList();

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _message = null;

        _case = await Http.GetFromJsonAsync<ModuleCaseDetailDto>($"/api/cases/{caseId}");

        var taskResult = await Http.GetFromJsonAsync<ListResponseDto<ModuleTaskListItemDto>>($"/api/cases/{caseId}/tasks");
        _tasks = taskResult?.Items ?? new();

        await ReloadFilesAsync();
    }

    private void ChangeTab(string tab)
    {
        _activeTab = tab;
    }

    private string GetTabClass(string tab)
    {
        return _activeTab == tab ? "is-active" : "";
    }

    private void EditCase()
    {
        Nav.NavigateTo($"/modules/{moduleCode}/{recordId}/cases/{caseId}/edit");
    }

    private void CreateTask()
    {
        Nav.NavigateTo($"/modules/{moduleCode}/{recordId}/cases/{caseId}/tasks/new");
    }

    private void ViewTask(Guid taskId)
    {
        Nav.NavigateTo($"/modules/{moduleCode}/{recordId}/cases/{caseId}/tasks/{taskId}");
    }

    private void BackToRecord()
    {
        Nav.NavigateTo($"/modules/{moduleCode}/detail/{recordId}");
    }

    private async Task DeleteCaseAsync()
    {
        if (_deleting)
        {
            return;
        }

        _deleting = true;
        _message = null;

        try
        {
            var response = await Http.DeleteAsync($"/api/cases/{caseId}");

            if (response.IsSuccessStatusCode)
            {
                Nav.NavigateTo($"/modules/{moduleCode}/detail/{recordId}");
                return;
            }

            var error = await response.Content.ReadAsStringAsync();
            _message = $"刪除 Case 失敗：{response.StatusCode} {error}";
            Console.WriteLine($"[ModuleCaseView] Delete case failed: {response.StatusCode} {error}");
        }
        finally
        {
            _deleting = false;
        }
    }

    private async Task DeleteTaskFromListAsync(Guid taskId)
    {
        _message = null;

        var response = await Http.DeleteAsync($"/api/tasks/{taskId}");

        if (response.IsSuccessStatusCode)
        {
            _tasks.RemoveAll(x => x.Id == taskId);
            _message = "子任務已刪除。";
            return;
        }

        var error = await response.Content.ReadAsStringAsync();
        _message = $"刪除子任務失敗：{response.StatusCode} {error}";
        Console.WriteLine($"[ModuleCaseView] Delete task failed: {response.StatusCode} {error}");
    }

    private void OnFilesSelected(InputFileChangeEventArgs e)
    {
        _selectedFiles = e.GetMultipleFiles(20).ToList();
    }

    private async Task UploadFilesAsync()
    {
        if (_selectedFiles.Count == 0)
        {
            return;
        }

        using var content = new MultipartFormDataContent();

        foreach (var file in _selectedFiles)
        {
            var streamContent = new StreamContent(file.OpenReadStream(200_000_000));

            if (!string.IsNullOrWhiteSpace(file.ContentType))
            {
                streamContent.Headers.ContentType =
                    new global::System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            }

            content.Add(streamContent, "files", file.Name);
        }

        var response = await Http.PostAsync($"/api/cases/{caseId}/files", content);

        if (response.IsSuccessStatusCode)
        {
            _selectedFiles.Clear();
            await ReloadFilesAsync();
            _activeTab = "Files";
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            _message = $"上傳失敗：{response.StatusCode} {error}";
        }
    }

    private async Task ReloadFilesAsync()
    {
        var result = await Http.GetFromJsonAsync<List<ModuleCaseFileDto>>($"/api/cases/{caseId}/files");
        _files = result ?? new();
    }

    private async Task DeleteFileAsync(Guid fileId)
    {
        var response = await Http.DeleteAsync($"/api/files/{fileId}");
        if (response.IsSuccessStatusCode)
        {
            await ReloadFilesAsync();
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            _message = $"刪除檔案失敗：{response.StatusCode} {error}";
        }
    }

    private static string Display(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : value;
    }

    private static string DisplayDate(DateOnly? value)
    {
        return value?.ToString("yyyy/MM/dd") ?? "-";
    }

    private static string FormatSize(long size)
    {
        if (size >= 1024 * 1024)
        {
            return $"{size / 1024d / 1024d:0.##} MB";
        }

        if (size >= 1024)
        {
            return $"{size / 1024d:0.##} KB";
        }

        return $"{size} B";
    }

    public class ModuleCaseDetailDto
    {
        public string CaseNo { get; set; } = "";
        public string Name { get; set; } = "";
        public string Status { get; set; } = "";
        public string? Note { get; set; }
        public int SortOrder { get; set; }
    }

    public class ModuleTaskListItemDto
    {
        public Guid Id { get; set; }
        public string TaskNo { get; set; } = "";
        public string Name { get; set; } = "";
        public string? AssignEngineer { get; set; }
        public string Status { get; set; } = "";
        public string? Result { get; set; }
        public int Progress { get; set; }
        public DateOnly? StartDate { get; set; }
        public DateOnly? ExpectedEndDate { get; set; }
    }

    public class ModuleCaseFileDto
    {
        public Guid Id { get; set; }
        public Guid CaseId { get; set; }
        public string FileName { get; set; } = "";
        public string FilePath { get; set; } = "";
        public string? ContentType { get; set; }
        public long FileSize { get; set; }
        public string? UploadEmp { get; set; }
        public DateTime CreatedAt { get; set; }
    }

    public class ListResponseDto<T>
    {
        public List<T> Items { get; set; } = new();
        public int Page { get; set; }
        public int PageSize { get; set; }
        public int TotalCount { get; set; }
    }
}
