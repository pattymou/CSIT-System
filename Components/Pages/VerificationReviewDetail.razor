@page "/verification-reviews/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject IVerificationApplicationService Applications
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Nav

<h3 class="page-title">Verification Review Detail</h3>

@if (!string.IsNullOrWhiteSpace(_message)) { <div class="surface-card error-text">@_message</div> }
@if (_loading) { <div class="surface-card">載入中...</div> }
else if (_item is not null)
{
    <div class="surface-card">
        <div class="detail-grid">
            <div><span>申請編號</span><strong>@_item.ApplicationNo</strong></div>
            <div><span>驗證類別</span><strong>@_item.CategoryName</strong></div>
            <div><span>申請人</span><strong>@_item.ApplicantName (@_item.ApplicantAccount)</strong></div>
            <div><span>部門 / Email</span><strong>@_item.Department / @_item.ApplicantEmail</strong></div>
            <div><span>專案</span><strong>@_item.ProjectName</strong></div>
            <div><span>產品</span><strong>@_item.Customer / @_item.ProductModel</strong></div>
            <div class="full"><span>驗證需求</span><div>@_item.ValidationRequirement</div></div>
        </div>
        <div class="form-row full-width review-note"><label>處理說明（Return / Reject 必填）</label><textarea @bind="_note"></textarea></div>
        <div class="form-actions">
            <button type="button" class="btn-secondary" disabled="@_working" @onclick="ReturnAsync">Return</button>
            <button type="button" class="btn-secondary" disabled="@_working" @onclick="RejectAsync">Reject</button>
            <button type="button" class="btn-primary" disabled="@_working" @onclick="AcceptAsync">Accept</button>
            <button type="button" class="btn-secondary" @onclick="Back">返回 Queue</button>
        </div>
    </div>
}

<style>
    .detail-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px; }
    .detail-grid span { display:block; color:#94a3b8; font-size:.85rem; margin-bottom:4px; }
    .detail-grid .full { grid-column:1/-1; }
    .review-note { margin-top:22px; }
</style>

@code {
    [Parameter] public Guid Id { get; set; }
    private VerificationApplicationDto? _item;
    private string? _note;
    private string? _message;
    private bool _loading = true;
    private bool _working;
    protected override async Task OnParametersSetAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        _loading = true; _message = null;
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            _item = await Applications.GetForLeaderReviewAsync(Id, user);
            if (_item is null) _message = "找不到待審核申請，或此申請未指派給您。";
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _loading = false; }
    }
    private async Task ReturnAsync() => await ExecuteAsync((user) => Applications.ReturnAsync(Id, user, _note));
    private async Task RejectAsync() => await ExecuteAsync((user) => Applications.RejectAsync(Id, user, _note));
    private async Task AcceptAsync() => await ExecuteAsync((user) => Applications.AcceptAsync(Id, user));
    private void Back() => Nav.NavigateTo("/verification-reviews");
    private async Task ExecuteAsync(Func<global::System.Security.Claims.ClaimsPrincipal, Task<VerificationApplicationDto>> action)
    {
        _working = true; _message = null;
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            await action(user);
            Nav.NavigateTo("/verification-reviews");
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _working = false; }
    }
}
