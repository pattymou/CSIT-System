@page "/modules/{ModuleCode}/{RecordId:guid}/cases/{CaseId:guid}/tasks/{TaskId:guid}"
@attribute [Authorize(Policy = SystemAuthorization.Policies.CsitStaff)]
@rendermode InteractiveServer
@using global::System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http
@inject NavigationManager Nav

<h3>檢視子任務</h3>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="form-card error-text">@_message</div>
}

@if (_task == null)
{
    <div class="surface-card">Loading...</div>
}
else
{
    <div class="page-actions">
        <a class="primary-btn" href="@($"/modules/{ModuleCode}/{RecordId}/cases/{CaseId}/tasks/{TaskId}/edit")">修改此子任務</a>
        <button type="button" class="table-chip-btn danger" @onclick="DeleteTaskAsync" disabled="@_deleting">
            @(_deleting ? "刪除中..." : "刪除此子任務")
        </button>
    </div>

    <div class="form-card">
        <div class="project-table-wrap">
            <table class="project-table">
                <tbody>
                    <tr><th>子任務名稱</th><td>@_task.Name</td><th>子任務ID</th><td>@_task.TaskNo</td></tr>
                    <tr><th>Sub PU</th><td>@Display(_task.SubPu)</td><th>機種名稱</th><td>@Display(_task.ModelName)</td></tr>
                    <tr><th>指派工程師</th><td>@Display(_task.AssignEngineer)</td><th>狀態</th><td>@_task.Status</td></tr>
                    <tr><th>開始日期</th><td>@DisplayDate(_task.StartDate)</td><th>預計完成日</th><td>@DisplayDate(_task.ExpectedEndDate)</td></tr>
                    <tr><th>結果判定</th><td>@Display(_task.Result)</td><th>進度</th><td>@_task.Progress</td></tr>
                    <tr><th>實驗室名稱</th><td colspan="3">@Display(_task.Lab)</td></tr>
                    <tr><th>報價金額</th><td>@Display(_task.Quoted)</td><th>請款金額</th><td>@Display(_task.Reimburse)</td></tr>
                    <tr><th>備註</th><td colspan="3">@Display(_task.Note)</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="form-card">
        <div class="case-tabs">
            <button type="button" class="case-tab @(GetTabClass("Upload"))" @onclick='() => ChangeTab("Upload")'>檔案上傳</button>
            <button type="button" class="case-tab @(GetTabClass("Files"))" @onclick='() => ChangeTab("Files")'>檔案清單</button>
        </div>

        @if (_activeTab == "Upload")
        {
            <div class="case-card-head">
                <div>
                    <div class="case-kicker">TEST REPORT UPLOAD</div>
                    <h2>檔案上傳</h2>
                </div>
            </div>

            <div class="hint-text">
                子任務頁上傳測試報告，UploadKind 固定為 TestReport。
            </div>

            <div class="upload-box">
                <InputFile OnChange="OnFilesSelected" multiple />
                <button type="button" class="btn-primary" @onclick="UploadFilesAsync" disabled="@(_selectedFiles.Count == 0 || _uploading)">
                    @(_uploading ? "上傳中..." : "儲存")
                </button>
            </div>

            @if (_selectedFiles.Count > 0)
            {
                <div class="upload-list">
                    @foreach (var file in _selectedFiles)
                    {
                        <div class="upload-file-item">
                            <span>@file.FileName</span>
                            <strong>@FormatSize(file.Size)</strong>
                        </div>
                    }
                </div>
            }
        }
        else if (_activeTab == "Files")
        {
            <div class="case-card-head">
                <div>
                    <div class="case-kicker">TEST REPORT FILE LIST</div>
                    <h2>檔案清單</h2>
                </div>
                <button type="button" class="btn-primary" @onclick="ReloadFilesAsync">重新整理</button>
            </div>

            @if (_files.Count == 0)
            {
                <div class="record-empty-box">
                    <strong>目前沒有檔案</strong>
                    <span>請到「檔案上傳」選擇檔案並儲存。</span>
                </div>
            }
            else
            {
                <div class="project-table-wrap">
                    <table class="project-table">
                        <thead>
                            <tr>
                                <th>文件名稱</th>
                                <th>大小</th>
                                <th>上傳時間</th>
                                <th>上傳者</th>
                                <th>操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var file in _files)
                            {
                                <tr>
                                    <td>@file.FileName</td>
                                    <td>@FormatSize(file.FileSize)</td>
                                    <td>@file.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                                    <td>@Display(file.UploadEmp)</td>
                                    <td class="action-cell">
                                        <a class="table-link-btn" href="@($"/api/files/{file.Id}/download")" target="_blank">下載</a>
                                        <button type="button" class="table-chip-btn danger" @onclick="() => DeleteFileAsync(file.Id)">刪除</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
}

@code {
    [Parameter] public string ModuleCode { get; set; } = "";
    [Parameter] public Guid RecordId { get; set; }
    [Parameter] public Guid CaseId { get; set; }
    [Parameter] public Guid TaskId { get; set; }

    private ModuleTaskDetailDto? _task;
    private string _activeTab = "Upload";
    private string? _message;
    private bool _uploading;
    private bool _deleting;
    private List<SelectedUploadFile> _selectedFiles = new();
    private List<ModuleCaseFileDto> _files = new();

    protected override async Task OnParametersSetAsync()
    {
        _message = null;
        _task = await Http.GetFromJsonAsync<ModuleTaskDetailDto>($"/api/tasks/{TaskId}");
        await ReloadFilesAsync();
    }

    private void ChangeTab(string tab)
    {
        _activeTab = tab;
        _message = null;
    }

    private string GetTabClass(string tab)
    {
        return _activeTab == tab ? "is-active" : "";
    }

    private async Task DeleteTaskAsync()
    {
        if (_deleting)
        {
            return;
        }

        _deleting = true;
        _message = null;

        try
        {
            var response = await Http.DeleteAsync($"/api/tasks/{TaskId}");

            if (response.IsSuccessStatusCode)
            {
                Nav.NavigateTo($"/modules/{ModuleCode}/{RecordId}/cases/{CaseId}");
                return;
            }

            var error = await response.Content.ReadAsStringAsync();
            _message = $"刪除子任務失敗：{response.StatusCode} {error}";
            Console.WriteLine($"[ModuleTaskView] Delete task failed: {response.StatusCode} {error}");
        }
        finally
        {
            _deleting = false;
        }
    }

    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        _selectedFiles.Clear();

        foreach (var file in e.GetMultipleFiles(20))
        {
            await using var stream = file.OpenReadStream(200_000_000);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            _selectedFiles.Add(new SelectedUploadFile
            {
                FileName = file.Name,
                ContentType = file.ContentType,
                Size = file.Size,
                Content = ms.ToArray()
            });
        }

        _message = _selectedFiles.Count == 0
            ? "沒有選擇檔案。"
            : $"已選擇 {_selectedFiles.Count} 個檔案。";
    }

    private async Task UploadFilesAsync()
    {
        if (_selectedFiles.Count == 0)
        {
            _message = "請先選擇檔案。";
            return;
        }

        _uploading = true;
        _message = null;

        try
        {
            using var content = new MultipartFormDataContent();

            foreach (var file in _selectedFiles)
            {
                var streamContent = new StreamContent(new MemoryStream(file.Content));

                if (!string.IsNullOrWhiteSpace(file.ContentType))
                {
                    streamContent.Headers.ContentType =
                        new global::System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
                }

                content.Add(streamContent, "files", file.FileName);
            }

            var response = await Http.PostAsync($"/api/tasks/{TaskId}/files", content);
            var responseText = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                _selectedFiles.Clear();
                await ReloadFilesAsync();
                _activeTab = "Files";
                _message = "上傳成功。";
                return;
            }

            _message = $"上傳失敗：{response.StatusCode} {responseText}";
        }
        catch (Exception ex)
        {
            _message = $"上傳發生例外：{ex.Message}";
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task ReloadFilesAsync()
    {
        try
        {
            var response = await Http.GetAsync($"/api/tasks/{TaskId}/files");

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                _message = $"載入檔案清單失敗：{response.StatusCode} {error}";
                _files = new();
                Console.WriteLine($"[ModuleTaskView] Load files failed: {response.StatusCode} {error}");
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<List<ModuleCaseFileDto>>();
            _files = result ?? new();
        }
        catch (Exception ex)
        {
            _message = $"載入檔案清單發生例外：{ex.Message}";
            _files = new();
            Console.WriteLine($"[ModuleTaskView] Load files exception: {ex}");
        }
    }

    private async Task DeleteFileAsync(Guid fileId)
    {
        var response = await Http.DeleteAsync($"/api/files/{fileId}");
        if (response.IsSuccessStatusCode)
        {
            await ReloadFilesAsync();
            _message = "刪除成功。";
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            _message = $"刪除失敗：{response.StatusCode} {error}";
        }
    }

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string DisplayDate(DateOnly? value) => value?.ToString("yyyy/MM/dd") ?? "-";

    private static string FormatSize(long size)
    {
        if (size >= 1024 * 1024)
        {
            return $"{size / 1024d / 1024d:0.##} MB";
        }

        if (size >= 1024)
        {
            return $"{size / 1024d:0.##} KB";
        }

        return $"{size} B";
    }

    private class SelectedUploadFile
    {
        public string FileName { get; set; } = string.Empty;
        public string? ContentType { get; set; }
        public long Size { get; set; }
        public byte[] Content { get; set; } = [];
    }
}
