@page "/rd/help/manual"
@attribute [Authorize(Policy = SystemAuthorization.Policies.RdApplicant)]
@layout RdLayout
@using SIT.DepartmentSystem.Web.Services.Manuals

<PageTitle>RD 操作手冊</PageTitle>
<HeadContent><link rel="stylesheet" href="/css/manual-v2.css" /></HeadContent>
<div class="manual-page rd-manual-page">
    <section class="manual-hero"><div class="manual-hero-copy"><div class="manual-eyebrow">RD SERVICE / MANUAL</div>
        <h1>RD 操作手冊</h1><p class="manual-subtitle">依 RD 服務左側選單查找操作方式</p>
        <p class="manual-intro">首頁、系統驗證申請單及設備預約依選單順序排列；申請與預約的細部操作收在各自章節內。</p>
    </div></section>
    <div class="manual-toolbar"><label class="manual-search"><span class="visually-hidden">搜尋 RD 操作說明</span>
        <span class="manual-search-icon" aria-hidden="true">⌕</span><input @bind="_search" @bind:event="oninput" placeholder="搜尋功能或操作步驟" />
        @if (!string.IsNullOrWhiteSpace(_search)) { <button type="button" class="manual-clear" @onclick="() => _search = string.Empty" aria-label="清除搜尋">×</button> }
    </label><div class="manual-result-count">@VisibleEntries.Count 個功能章節</div></div>
    <div class="manual-layout">
        <aside class="manual-toc" aria-label="RD 操作手冊章節目錄">
            <div class="manual-toc-title">章節目錄</div><nav>
                <a href="#rd-introduction" class="manual-toc-link @(_active == "rd-introduction" ? "selected" : "")" @onclick="ActivateIntro">登入與登出</a>
                <div class="manual-toc-group">@SidebarCatalog.RdServices.Name</div>
                @foreach (var entry in VisibleEntries)
                {
                    var anchor = Anchor(entry.Route);
                    <a href="#@anchor" class="manual-toc-link @(_active == anchor ? "selected" : "")" aria-current="@(_active == anchor ? "location" : null)" @onclick="() => _active = anchor">@entry.Title</a>
                }
            </nav>
        </aside>
        <main class="manual-content">
            <section id="rd-introduction" class="manual-introduction"><h2>登入與登出</h2>
                <p>以核發的 RD 帳號登入後使用左側「RD 服務」。作業完成請按右上角「登出」；再次使用時在已登出頁面選「重新登入」。</p>
                <figure class="manual-figure"><a href="/api/manual/assets/shared/signed-out.png" target="_blank" rel="noopener noreferrer"><img src="/api/manual/assets/shared/signed-out.png" alt="RD 登出後畫面" loading="lazy" /></a><figcaption>登出後畫面；點圖查看原尺寸。</figcaption></figure>
            </section>
            <h2 class="manual-group-heading">@SidebarCatalog.RdServices.Name</h2>
            @{ var chapterNumber = 0; }
            @foreach (var entry in VisibleEntries)
            {
                <ManualChapter Anchor="@Anchor(entry.Route)" Number="@((++chapterNumber).ToString())" GroupName="@SidebarCatalog.RdServices.Name" Title="@entry.Title" Topic="@ManualContent.Rd[entry.Route]" />
            }
            @if (VisibleEntries.Count == 0) { <p class="manual-empty">找不到符合搜尋條件的功能。請修改關鍵字。</p> }
        </main>
    </div>
</div>

@code {
    private string _search = string.Empty;
    private string _active = "rd-introduction";
    private IReadOnlyList<SidebarEntry> VisibleEntries => SidebarCatalog.RdServices.Entries.Where(e =>
        ManualContent.Rd.ContainsKey(e.Route) &&
        (string.IsNullOrWhiteSpace(_search) || e.Title.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || ManualContent.Rd[e.Route].Purpose.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || ManualContent.Rd[e.Route].Steps.Any(s => s.Heading.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || s.Body.Contains(_search, StringComparison.OrdinalIgnoreCase)))).ToList();
    private static string Anchor(string route) => "rd-manual-" + route.Trim('/').Replace('/', '-');
    private void ActivateIntro() => _active = "rd-introduction";
}
