@page "/validation-request-applications/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = SystemAuthorization.Policies.CsitStaff)]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using SIT.DepartmentSystem.Web.Entities
@inject IVerificationApplicationService Applications
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Nav

<PageTitle>驗證申請內容</PageTitle>
<h3 class="page-title">驗證申請內容</h3>
@if (_error is not null) { <div class="surface-card error-text">@_error</div> }
else if (_loading) { <div class="surface-card">載入中...</div> }
else if (_item is not null)
{
    @if (_item.ValidationRequest is not null)
    {
        <ValidationRequestSubmissionView Submission="_item.ValidationRequest" />
    }
    else
    {
        <div class="surface-card">
            <div class="detail-grid">
                <div><span>申請編號</span><strong>@_item.ApplicationNo</strong></div><div><span>狀態</span><strong>@_item.Status</strong></div>
                <div><span>Model Name</span><strong>@Display(_item.ProductModel)</strong></div><div><span>申請人</span><strong>@_item.ApplicantName (@_item.ApplicantAccount)</strong></div>
                <div><span>申請日期</span><strong>@_item.SubmittedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</strong></div><div><span>Team</span><strong>@Display(_item.TeamName)</strong></div>
                <div class="full"><span>驗證需求</span><div>@Display(_item.ValidationRequirement)</div></div>
            </div>
        </div>
        <div class="surface-card">此為舊版申請，以上方既有資料方式顯示。</div>
    }
    <div class="form-actions"><button class="btn-secondary" @onclick="Back">返回清單</button></div>
}
<style>.detail-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.detail-grid span{display:block;color:#94a3b8;font-size:.85rem}.detail-grid .full{grid-column:1/-1}</style>
@code {
    [Parameter] public Guid Id { get; set; }
    private VerificationApplicationDto? _item; private bool _loading = true; private string? _error;
    protected override async Task OnParametersSetAsync()
    {
        try { var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User; _item = await Applications.GetForCsitAsync(Id, user); if (_item is null) _error = "找不到申請，或您無權存取。"; }
        catch (Exception ex) { _error = ex.Message; } finally { _loading = false; }
    }
    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "－" : value;
    private void Back() => Nav.NavigateTo("/validation-request-applications");
}
