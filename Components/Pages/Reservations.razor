@page "/reservations"
@layout RdLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Policy = SystemAuthorization.Policies.RdApplicant)]
@using SIT.DepartmentSystem.Web.Entities
@inject ReservationApiClient Api
@inject NavigationManager Nav

<PageTitle>@(StaffWorkspace ? "設備預約管理" : "我的設備預約")</PageTitle>

<h3 class="page-title">@(StaffWorkspace ? "設備預約管理" : "我的設備預約")</h3>

<div class="form-actions reservation-entry">
    <button type="button" class="btn-secondary" @onclick='() => Nav.NavigateTo($"{BasePath}/overview")'>預約總覽</button>
    <button type="button" class="btn-secondary" disabled>我的預約</button>
    <button type="button" class="btn-primary" @onclick="Create">新增預約</button>
    @if (StaffWorkspace)
    {
        <button type="button" class="btn-secondary" @onclick='() => Nav.NavigateTo("/reservation-review")'>預約審核</button>
    }
</div>

<div class="form-actions reservation-toolbar">
    <div class="form-row">
        <label>狀態</label>
        <select @bind="_statusFilter">
            <option value="">全部</option>
            @foreach (var status in Enum.GetValues<ReservationStatus>())
            {
                <option value="@status">@ReservationUi.StatusText(status)</option>
            }
        </select>
    </div>
    <button type="button" class="btn-primary" @onclick="Create">新增設備預約</button>
</div>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="surface-card error-text">@_message</div>
}
else if (_loading)
{
    <div class="surface-card">載入中...</div>
}
else
{
    <div class="surface-card">
        <div class="project-table-wrap">
            <table class="project-table">
                <thead>
                    <tr><th>預約編號</th><th>預約時間</th><th>用途</th><th>設備</th><th>狀態</th><th>建立時間</th></tr>
                </thead>
                <tbody>
                    @if (!FilteredItems.Any())
                    {
                        <tr><td colspan="6" class="empty-row">目前沒有符合條件的設備預約。</td></tr>
                    }
                    else
                    {
                        @foreach (var item in FilteredItems)
                        {
                            <tr class="clickable-row" @onclick="() => Open(item.Id)">
                                <td><strong>@item.ReservationNo</strong></td>
                                <td><LocalDateTime Value="item.StartTime" /> ～ <LocalDateTime Value="item.EndTime" /></td>
                                <td>@item.Purpose</td>
                                <td><span class="equipment-summary">@ReservationUi.EquipmentSummary(item.ApparatusNames, item.ItemCount)</span></td>
                                <td><span class="record-status-pill">@ReservationUi.StatusText(item.Status)</span></td>
                                <td><LocalDateTime Value="item.CreatedAt" /></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<style>
    .reservation-toolbar { align-items:end; justify-content:space-between; }
    .reservation-toolbar .form-row { min-width:180px; margin:0; }
    .equipment-summary { display:inline-block; max-width:340px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; vertical-align:bottom; }
</style>

@code {
    [Parameter] public string BasePath { get; set; } = "/reservations";
    [Parameter] public bool StaffWorkspace { get; set; }
    private List<ReservationListDto> _items = [];
    private ReservationStatus? _statusFilter;
    private bool _loading = true;
    private string? _message;
    private IEnumerable<ReservationListDto> FilteredItems =>
        _statusFilter.HasValue ? _items.Where(x => x.Status == _statusFilter.Value) : _items;

    protected override async Task OnInitializedAsync()
    {
        try { _items = await Api.ListAsync(); }
        catch (Exception ex) { _message = ex.Message; }
        finally { _loading = false; }
    }

    private void Create() => Nav.NavigateTo($"{BasePath}/new");
    private void Open(Guid id) => Nav.NavigateTo($"{BasePath}/{id}");
}
