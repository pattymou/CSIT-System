@page "/reservations"
@layout RdLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Policy = SystemAuthorization.Policies.RdApplicant)]
@using SIT.DepartmentSystem.Web.Entities
@inject ReservationApiClient Api
@inject NavigationManager Nav

<PageTitle>@(StaffWorkspace ? "設備預約管理" : "我的設備預約")</PageTitle>

<h3 class="page-title">@(StaffWorkspace ? "設備預約管理" : "我的設備預約")</h3>

<div class="form-actions reservation-entry">
    <button type="button" class="btn-secondary" @onclick='() => Nav.NavigateTo($"{BasePath}/overview")'>預約總覽</button>
    <button type="button" class="btn-secondary" disabled>我的預約</button>
    <button type="button" class="btn-primary" @onclick="Create">新增預約</button>
    @if (StaffWorkspace)
    {
        <button type="button" class="btn-secondary" @onclick='() => Nav.NavigateTo("/reservation-review")'>預約審核</button>
        <button type="button" class="btn-secondary" @onclick='() => Nav.NavigateTo("/reservation-overdue")'>
            <span>逾期管理</span>
            @if (_overdueCount > 0)
            {
                <span class="overdue-count">@_overdueCount</span>
            }
        </button>
    }
</div>

<div class="form-actions reservation-toolbar">
    <div class="form-row">
        <label>狀態</label>
        <select value="@_statusFilter" @onchange="StatusFilterChangedAsync">
            @if (StaffWorkspace)
            {
                <option value="active">使用中</option>
            }
            <option value="">全部</option>
            <option value="Pending">待審核</option>
            <option value="Approved">已核准</option>
            <option value="Borrowed">借用中（舊資料）</option>
            <option value="Returned">已歸還</option>
            <option value="Rejected">已拒絕</option>
            <option value="Cancelled">已取消</option>
            <option value="Draft">草稿</option>
        </select>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="surface-card error-text">@_message</div>
}
else if (_loading)
{
    <div class="surface-card">載入中...</div>
}
else
{
    <div class="surface-card">
        <div class="project-table-wrap">
            <table class="project-table">
                <thead>
                    <tr><th>預約編號</th><th>預約時間</th><th>用途</th><th>設備</th><th>狀態</th><th>建立時間</th></tr>
                </thead>
                <tbody>
                    @if (!_items.Any())
                    {
                        <tr><td colspan="6" class="empty-row">目前沒有符合條件的設備預約。</td></tr>
                    }
                    else
                    {
                        @foreach (var item in _items)
                        {
                            <tr class="clickable-row" @onclick="() => Open(item.Id)">
                                <td><strong>@item.ReservationNo</strong></td>
                                <td><LocalDateTime Value="item.StartTime" /> ～ <LocalDateTime Value="item.EndTime" /></td>
                                <td>@item.Purpose</td>
                                <td><span class="equipment-summary">@ReservationUi.EquipmentSummary(item.ApparatusNames, item.ItemCount)</span></td>
                                <td><span class="record-status-pill">@ReservationUi.StatusText(item.Status)</span></td>
                                <td><LocalDateTime Value="item.CreatedAt" /></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<style>
    .reservation-toolbar { align-items:end; }
    .reservation-toolbar .form-row { min-width:180px; margin:0; }
    .equipment-summary { display:inline-block; max-width:340px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; vertical-align:bottom; }
    .overdue-count { display:inline-flex; align-items:center; justify-content:center; min-width:20px; height:20px; margin-left:6px; padding:0 6px; border-radius:999px; color:#fed7aa; background:rgba(194,65,12,.28); font-size:.72rem; font-weight:800; }
</style>

@code {
    [Parameter] public string BasePath { get; set; } = "/reservations";
    [Parameter] public bool StaffWorkspace { get; set; }
    private List<ReservationListDto> _items = [];
    private string _statusFilter = string.Empty;
    private int _overdueCount;
    private bool _loading = true;
    private string? _message;
    protected override async Task OnInitializedAsync()
    {
        _statusFilter = StaffWorkspace ? "active" : string.Empty;
        try
        {
            await LoadListAsync();
            if (StaffWorkspace)
                _overdueCount = (await Api.OverdueAsync()).TotalCount;
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _loading = false; }
    }

    private async Task StatusFilterChangedAsync(ChangeEventArgs args)
    {
        _statusFilter = args.Value?.ToString() ?? string.Empty;
        _loading = true;
        _message = null;
        try { await LoadListAsync(); }
        catch (Exception ex) { _message = ex.Message; }
        finally { _loading = false; }
    }

    private async Task LoadListAsync()
    {
        var active = string.Equals(_statusFilter, "active", StringComparison.Ordinal);
        var status = Enum.TryParse<ReservationStatus>(_statusFilter, out var parsed) ? parsed : (ReservationStatus?)null;
        _items = await Api.ListAsync(status, active);
    }

    private void Create() => Nav.NavigateTo($"{BasePath}/new");
    private void Open(Guid id) => Nav.NavigateTo($"{BasePath}/{id}");
}
