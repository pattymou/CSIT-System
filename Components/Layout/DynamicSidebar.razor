@using SIT.DepartmentSystem.Web.Models.Api
@using SIT.DepartmentSystem.Web.Services.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@inject IMenuManagementService MenuService
@inject AuthenticationStateProvider AuthProvider
@inject IAuthorizationService AuthorizationService

<div class="brand">
    <div class="brand-title">SIT System</div>
</div>

<div class="nav-scroll">
    @foreach (var block in _sections
        .Where(CanDisplaySection)
        .OrderBy(x => x.SortOrder))
    {
        <div class="nav-section">
            <div class="nav-section-title">@block.Icon @block.Name</div>

            @foreach (var item in _items
                         .Where(x => x.SectionId == block.Id)
                         .Where(x => x.IsEnabled)
                         .Where(x => !x.AdminOnly || _isAdmin
                             || (IsAdministrationSection(block) && _canAccessAdministration))
                         .OrderBy(x => x.SortOrder)
                         .ThenBy(x => x.Title))
            {
                <NavLink class="nav-link-custom" href="@DisplayRoute(item)" Match="NavLinkMatch.Prefix">
                    <span class="nav-item-icon" aria-hidden="true">@item.Icon</span><span class="nav-item-label">@DisplayTitle(item)</span>
                </NavLink>
            }
            @if (IsAdministrationSection(block) && _canAccessAdministration)
            {
                <NavLink class="nav-link-custom" href="/administration/accounts" Match="NavLinkMatch.Prefix">
                    <span class="nav-item-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.5" /><path d="M5 21v-2a7 7 0 0 1 14 0v2" /></svg></span><span class="nav-item-label">帳號管理</span>
                </NavLink>
            }
        </div>
    }
</div>

@code {
    private List<MenuSectionDto> _sections = [];
    private List<MenuItemDto> _items = [];
    private bool _isAdmin;
    private bool _canAccessAdministration;

    private bool CanDisplaySection(MenuSectionDto section) =>
        !IsAdministrationSection(section) || _canAccessAdministration;

    private static bool IsAdministrationSection(MenuSectionDto section) =>
        string.Equals(section.Code, "administration", StringComparison.OrdinalIgnoreCase)
        || string.Equals(section.Name, "ADMINISTRATION", StringComparison.OrdinalIgnoreCase);

    private static string DisplayTitle(MenuItemDto item) =>
        string.Equals(item.RoutePath, "/reservation-review", StringComparison.OrdinalIgnoreCase)
            ? "設備預約管理"
            : item.Title;

    private static string DisplayRoute(MenuItemDto item) =>
        string.Equals(item.RoutePath, "/reservation-review", StringComparison.OrdinalIgnoreCase)
            ? "/staff/reservations"
            : item.RoutePath;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        _isAdmin = auth.User.IsInRole("Admin");
        _canAccessAdministration = (await AuthorizationService.AuthorizeAsync(
            auth.User,
            SystemAuthorization.Policies.Administration)).Succeeded;

        _sections = (await MenuService.GetSectionsAsync())
            .Where(x => x.IsEnabled)
            .OrderBy(x => x.SortOrder)
            .ToList();

        foreach (var block in _sections)
        {
            var items = await MenuService.GetItemsBySectionAsync(block.Id);
            _items.AddRange(items);
        }
    }
}
