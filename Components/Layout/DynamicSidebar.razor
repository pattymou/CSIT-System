@using SIT.DepartmentSystem.Web.Services.Manuals
@using SIT.DepartmentSystem.Web.Services.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@inject IMenuManagementService MenuService
@inject AuthenticationStateProvider AuthProvider
@inject IAuthorizationService AuthorizationService

<div class="brand"><div class="brand-title">CSIT System</div></div>
<div class="nav-scroll">
    @foreach (var group in _groups)
    {
        <div class="nav-section">
            <div class="nav-section-title">@group.Icon @group.Name</div>
            @foreach (var item in group.Entries)
            {
                <NavLink class="nav-link-custom" href="@item.Route" Match="NavLinkMatch.Prefix">
                    @if (item.Icon is not null) { <span class="nav-item-icon" aria-hidden="true">@item.Icon</span> }
                    <span class="nav-item-label">@item.Title</span>
                </NavLink>
            }
        </div>
    }
</div>

@code {
    private IReadOnlyList<SidebarGroup> _groups = [];
    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        _groups = await SidebarCatalog.LoadAsync(MenuService, AuthorizationService, auth.User);
    }
}
