@inherits LayoutComponentBase
@using SIT.DepartmentSystem.Web.Services.Manuals

<div class="obsidian-shell">
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-title">CSIT System</div>
        </div>

        <div class="nav-scroll">
            <div class="nav-section">
                <div class="nav-section-title">@SidebarCatalog.RdServices.Name</div>
                @foreach (var entry in SidebarCatalog.RdServices.Entries)
                {
                    <NavLink class="nav-link-custom" href="@entry.Route" Match="@(entry.Route == "/rd" ? NavLinkMatch.All : NavLinkMatch.Prefix)">@entry.Title</NavLink>
                }
            </div>
            <div class="nav-section">
                <div class="nav-section-title">SYSTEM HELP</div>
                <NavLink class="nav-link-custom" href="/rd/help/manual" Match="NavLinkMatch.All">操作手冊</NavLink>
            </div>
        </div>
    </aside>

    <div class="content">
        <header class="topbar">
            <div>CSIT / Department System</div>
            <AuthorizeView>
                <Authorized>
                    <a class="topbar-logout" href="/auth/logout" data-enhance-nav="false">登出</a>
                </Authorized>
            </AuthorizeView>
        </header>

        <main class="page-body">
            @Body
        </main>
    </div>
</div>
